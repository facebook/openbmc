+
 #include "idevicerestore.h"
 #include "log.h"
 
@@ -69,6 +72,16 @@ extern "C" {
 
 #define USER_AGENT_STRING "InetURL/1.0"
 
+#define free_mmap(data, size, fail_return) \
+if (data) { \
+	if (!size) { \
+		free(data); \
+	} else if (munmap(data, size)) { \
+		logger(LL_ERROR, "%s: munmap failed: %s (%d)\n", __func__, strerror(errno), errno); \
+		return fail_return; \
+	} \
+}
+
 struct dfu_client_t;
 struct normal_client_t;
 struct restore_client_t;
