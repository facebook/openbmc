From 4dc53aacc292d6b91a765e769aee70cd51d20314 Mon Sep 17 00:00:00 2001
From: Tao Ren <taoren@meta.com>
Date: Tue, 23 Sep 2025 22:30:15 -0700
Subject: [PATCH] ARM: dts: aspeed: darwin: Fixup device settings

Apply more settings on top of the upstreamed version of darwin dts.

These local settings will be upstreamed step by step.
---
 .../dts/aspeed/aspeed-bmc-facebook-darwin.dts | 72 +++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-darwin.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-darwin.dts
index 58c107a1b6cf..1698726ee6e5 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-darwin.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-darwin.dts
@@ -34,6 +34,55 @@ spi_gpio: spi {
 	};
 };
 
+&mdio0 {
+	status = "okay";
+
+	ethernet-switch@1e {
+		compatible = "brcm,bcm53134";
+		reg = <30>;
+
+		ethernet-ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				label = "uplink-port";
+			};
+
+			port@1 {
+				reg = <1>;
+				label = "x86-mgmt";
+			};
+
+			port@8 {
+				reg = <8>;
+				label = "bmc-mgmt";
+				phy-mode = "rgmii";
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+				};
+			};
+		};
+	};
+};
+
+/*
+ * BMC's "mac3" controller is connected to BCM53134P's IMP_RGMII port
+ * directly (fixed link, no PHY in between).
+ */
+&mac3 {
+	status = "okay";
+	phy-mode = "rgmii";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_rgmii4_default>;
+	fixed-link {
+		speed = <1000>;
+		full-duplex;
+	};
+};
+
 &i2c0 {
 	eeprom@50 {
 		compatible = "atmel,24c512";
@@ -43,6 +92,7 @@ eeprom@50 {
 
 &adc0 {
 	status = "okay";
+	vref = <2500>;
 
 	pinctrl-0 = <&pinctrl_adc0_default &pinctrl_adc1_default
 		     &pinctrl_adc2_default &pinctrl_adc3_default
@@ -52,6 +102,7 @@ &pinctrl_adc4_default &pinctrl_adc5_default
 
 &adc1 {
 	status = "okay";
+	vref = <2500>;
 
 	pinctrl-0 = <&pinctrl_adc8_default &pinctrl_adc9_default
 		     &pinctrl_adc10_default &pinctrl_adc11_default
@@ -70,3 +121,24 @@ &emmc {
 	max-frequency = <25000000>;
 	bus-width = <4>;
 };
+
+&spi1 {
+	status = "okay";
+	compatible = "spi-gpio";
+	#address-cells = <1>;
+	#size-cells = <0>;
+	num-chipselects = <2>;
+
+	gpio-sck = <&gpio0 ASPEED_GPIO(Z, 3) GPIO_ACTIVE_HIGH>;
+	gpio-mosi = <&gpio0 ASPEED_GPIO(Z, 4) GPIO_ACTIVE_HIGH>;
+	gpio-miso = <&gpio0 ASPEED_GPIO(Z, 5) GPIO_ACTIVE_HIGH>;
+	cs-gpios = <0>, <&gpio0 ASPEED_GPIO(Z, 0) GPIO_ACTIVE_HIGH>;
+
+	eeprom@1 {
+		compatible = "atmel,at93c86";
+		spi-max-frequency = <250000>;
+		data-size = <16>;
+		spi-cs-high;
+		reg = <1>;
+	};
+};
-- 
2.52.0

