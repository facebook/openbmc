From 74a6a14080abb3368bcd9f3873881637a0f22865 Mon Sep 17 00:00:00 2001
From: Peter Delevoryas <pdel@meta.com>
Date: Sun, 18 Dec 2022 14:41:31 -0800
Subject: [PATCH 527/532] hw/arm/aspeed: Don't initialize fby35-bmc GPIO's

Initializing the GPIO's triggers slot sensor cache initialization in the
boot sequence, which is extremely slow and annoying and doesn't succeed.

Until we update the BMC's bic-cached setup to be less annoying, it's
better to just not initialize these GPIO's.

Signed-off-by: Peter Delevoryas <pdel@meta.com>
---
 hw/arm/aspeed_ast2600_fby35.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/hw/arm/aspeed_ast2600_fby35.c b/hw/arm/aspeed_ast2600_fby35.c
index eaf37c48e4..288c6c7ec8 100644
--- a/hw/arm/aspeed_ast2600_fby35.c
+++ b/hw/arm/aspeed_ast2600_fby35.c
@@ -31,6 +31,7 @@ static void fby35_i2c_init(AspeedMachineState *bmc)
     i2c_slave_create_simple(aspeed_i2c_get_bus(&soc->i2c, 0), "fby35-sb-bic", 0x20);
 }
 
+#if 0
 static void fby35_reset(MachineState *state, ResetType type)
 {
     AspeedMachineState *bmc = ASPEED_MACHINE(state);
@@ -39,6 +40,7 @@ static void fby35_reset(MachineState *state, ResetType type)
 
     fby35_bmc_reset_gpios(bmc->soc);
 }
+#endif
 
 static void aspeed_machine_fby35_class_init(ObjectClass *oc, const void *data)
 {
@@ -46,7 +48,7 @@ static void aspeed_machine_fby35_class_init(ObjectClass *oc, const void *data)
     AspeedMachineClass *amc = ASPEED_MACHINE_CLASS(oc);
 
     mc->desc       = "Facebook fby35 BMC (Cortex-A7)";
-    mc->reset      = fby35_reset;
+    // mc->reset      = fby35_reset;
     amc->fmc_model = "n25q00";
     amc->num_cs    = 2;
     amc->macs_mask = ASPEED_MAC3_ON;
