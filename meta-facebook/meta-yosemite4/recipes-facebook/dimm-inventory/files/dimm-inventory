#!/bin/bash
# Populate DIMM inventory on D-Bus from dimm-util SPD data.
# Runs per-slot on host-start; once per BMC boot (guarded by a /run marker).
set -e

slot=$1
if [ -z "$slot" ]; then
    echo "Usage: $0 <slot>" >&2
    exit 1
fi

log() {
    echo "Slot${slot}: $*"
}

log_dimm() {
    local label=$1; shift
    echo "Slot${slot} ${label}: $*"
}

# Run once per BMC boot per slot. DIMM population only changes on a physical
# swap (12V off + sled pull), so re-reading on every host DC cycle/reboot is
# wasted CPU/PLDM. The marker lives in /run (tmpfs) so it clears on BMC reboot;
# delete it and re-trigger to force a refresh without rebooting the BMC.
MARKER="/run/dimm-inventory/slot${slot}.done"
if [ -f "$MARKER" ]; then
    log "already populated this BMC boot, skip (rm $MARKER or reboot BMC to refresh)"
    exit 0
fi

BOARD_BASE="/xyz/openbmc_project/inventory/system/board"
DIMM_INV_BASE="$BOARD_BASE"
SETTINGS_SVC="xyz.openbmc_project.Settings"
ASSET_INTF="xyz.openbmc_project.Inventory.Decorator.Asset"
DIMM_INTF="xyz.openbmc_project.Inventory.Item.Dimm"
ASSOC_INTF="xyz.openbmc_project.Association.Definitions"
SYSTEM_INTF="xyz.openbmc_project.Inventory.Item.System"
MAPPER_SVC="xyz.openbmc_project.ObjectMapper"
MAPPER_PATH="/xyz/openbmc_project/object_mapper"
MAPPER_INTF="xyz.openbmc_project.ObjectMapper"

# Map dimm-util label to settings object path.
# Host DIMMs (A0-A11) are on Sentinel Dome; CXL DIMMs (MCIO*) on Wailua Falls.
# Object names mirror EM sensor naming for easy correlation:
#   Sentinel_Dome_Slot_N_DIMM_A0  ↔  SENTINEL_DOME_SLOT_N_DIMM_A0_TEMP_C
#   Wailua_Falls_Slot_N_WF_MCIO4_DIMM_A1  ↔  WAILUA_FALLS_SLOT_N_WF_MCIO4_DIMM_A1_TEMP_C
get_dimm_obj_path() {
    local s=$1 label=$2
    case "$label" in
        A[0-9]|A1[0-1])
            echo "${DIMM_INV_BASE}/Sentinel_Dome_Slot_${s}_DIMM_${label}" ;;
        MCIO[34]-DIMM_*)
            local wf_name="WF_${label//-/_}"
            echo "${DIMM_INV_BASE}/Wailua_Falls_Slot_${s}_${wf_name}" ;;
    esac
}

# All possible SD board names per slot (T1, T1 Retimer, T2, T2 Retimer)
SD_CANDIDATES=(
    "Yosemite_4_Sentinel_Dome_T1_Slot_${slot}"
    "Yosemite_4_Sentinel_Dome_T1_with_Retimer_Slot_${slot}"
    "Yosemite_4_Sentinel_Dome_T2_Slot_${slot}"
    "Yosemite_4_Sentinel_Dome_T2_with_Retimer_Slot_${slot}"
)

# Step 1: Find which SD board type is present for this slot
MAX_RETRIES_EM=6
board_path=""
for ((retry = 0; retry < MAX_RETRIES_EM; retry++)); do
    for candidate in "${SD_CANDIDATES[@]}"; do
        if busctl call "$MAPPER_SVC" "$MAPPER_PATH" "$MAPPER_INTF" \
            GetObject sas "${BOARD_BASE}/${candidate}" 1 \
            "$SYSTEM_INTF" &>/dev/null; then
            board_path="${BOARD_BASE}/${candidate}"
            break 2
        fi
    done
    log "SD board not found, retrying ($((retry + 1))/$MAX_RETRIES_EM)..."
    sleep 5
done

if [ -z "$board_path" ]; then
    log "no SD board found in ObjectMapper, exit"
    exit 1
fi

board_name=${board_path##*/}
log "found board: $board_name"

# The work is split into three phases with independent budgets so the expensive
# dimm-util SPD read is not re-run on cheap downstream failures:
#   Phase 2 (POST-wait)   cheap pldmtool poll; budget kept fully aligned with the
#                         fw-versions/bios POST-wait (configured DIMM speed is only
#                         valid after memory training, so never give up early).
#   Phase 3 (read+verify) call dimm-util once, validate the SPD; small bounded
#                         retry only when data is empty/stale (the read is costly,
#                         so this is NOT the 240-wide budget).
#   Phase 4 (write)       write to D-Bus; retry only the failed writes from the
#                         already-parsed in-memory data, never re-reading dimm-util.
eid=$((10 * slot))
MAX_RETRIES_FW=240   # POST-wait budget, aligned with fw-versions/bios
MAX_RETRIES_DU=3     # dimm-util read + data-validity retries (SPD not ready yet)
MAX_RETRIES_WR=6     # D-Bus write-only retries (transient busctl/settingsd failure)

# Step 2: Wait for POST to complete (same pldmtool command as fw-versions/bios).
# dimm-util reads SPD through BIC -> ME -> SMBus; ME must be ready and the
# configured speed is only valid after memory training (POST). No dimm-util here.
posted=0
for ((retry = 0; retry < MAX_RETRIES_FW; retry++)); do
    present_state=$(
        pldmtool platform GetStateEffecterStates -m "$eid" -i 0xff22 |
            jq --raw-output '."presentState[1]"'
    ) || present_state=""

    if [ -z "$present_state" ]; then
        log "pldmtool EID=$eid failed, retrying... ($((retry + 1))/$MAX_RETRIES_FW)"
        sleep 5
        continue
    fi

    if [ "$present_state" != "1" ]; then
        log "POST not complete (state=$present_state), retrying... ($((retry + 1))/$MAX_RETRIES_FW)"
        sleep 5
        continue
    fi

    posted=1
    break
done

if [ "$posted" -ne 1 ]; then
    log "POST did not complete after $MAX_RETRIES_FW retries, exit"
    exit 2
fi
log "POST complete"

# Step 3: Read DIMM config via dimm-util and validate the SPD, with a small
# bounded retry. Right after POST a DIMM's SPD can briefly read back empty or
# stale, so re-run dimm-util a few times if the whole read is empty or a present
# DIMM has no valid SPD yet. The parse (single jq pass) and the field conversions
# are done here so a write retry never has to re-read or re-parse.
declare -a write_plan   # one US(0x1f)-delimited record per writable DIMM
stale_count=0
for ((du_retry = 0; du_retry < MAX_RETRIES_DU; du_retry++)); do
    config_json=$(dimm-util "slot${slot}" --config --json --force) || config_json=""

    if [ -z "$config_json" ] || [ "$config_json" = "null" ]; then
        log "dimm-util slot${slot} returned no data, retrying... ($((du_retry + 1))/$MAX_RETRIES_DU)"
        sleep 5
        continue
    fi

    num_dimms=$(echo "$config_json" | jq 'length') || num_dimms=0
    log "dimm-util returned $num_dimms DIMMs"

    # Extract all per-DIMM fields in a single jq pass (one record per DIMM)
    # instead of ~16 echo|jq|sed subprocesses per DIMM. rt mirrors the previous
    # trailing-whitespace trim (sed 's/[[:space:]]*$//'); has_config replaces the
    # old "config | keys[] empty" presence check. Values are otherwise identical.
    # Fields are joined with ASCII US (0x1f), NOT tab: tab is IFS-whitespace so
    # `read` would collapse empty fields; 0x1f cannot appear in SPD ASCII data.
    mapfile -t dimm_records < <(
        echo "$config_json" | jq -r '
            def rt: sub("[[:space:]]+$"; "");
            .[] | [
                .DIMM,
                ((.config | length) > 0 | tostring),
                (.config.Manufacturer // "" | rt),
                (.config["Manufacturing Date"] // "" | rt),
                (.config["Part Number"] // "" | rt),
                (.config["Serial Number"] // "" | rt),
                (.config.Size // "" | rt),
                (.config.Speed // "" | rt),
                (.config.Type // "" | rt)
            ] | join("\u001f")'
    )

    # Build the write plan: validate each DIMM and convert its fields once.
    write_plan=()
    stale_count=0
    for ((i = 0; i < num_dimms; i++)); do
        IFS=$'\x1f' read -r dimm_label has_config manufacturer mfg_date \
            part_number serial_number dimm_size dimm_speed dimm_type \
            <<< "${dimm_records[i]}"
        [ -z "$dimm_label" ] && continue

        obj_path=$(get_dimm_obj_path "$slot" "$dimm_label")
        if [ -z "$obj_path" ]; then
            continue
        fi

        # Skip if config is empty (DIMM not present)
        if [ "$has_config" != "true" ]; then
            log_dimm "$dimm_label" "not present (empty config)"
            continue
        fi

        # Check if settings object exists (write target)
        if ! busctl introspect "$SETTINGS_SVC" "$obj_path" --timeout=120 &>/dev/null; then
            log_dimm "$dimm_label" "settings object not found at $obj_path, skipping"
            continue
        fi

        # A present DIMM with no valid SPD yet is stale -> triggers a re-read.
        has_valid_data=0
        for field in "$manufacturer" "$part_number" "$serial_number"; do
            if [ -n "$field" ] && [ "$field" != "Unknown" ] && [ "$field" != "" ]; then
                has_valid_data=1
                break
            fi
        done
        if [ "$has_valid_data" -eq 0 ]; then
            log_dimm "$dimm_label" "no valid SPD data yet (stale)"
            stale_count=$((stale_count + 1))
            continue
        fi

        # Convert manufacturing date from "20XX WeekNN" to ISO 8601
        # dimm-util format: "2024 Week31" -> "20240729T000000Z"
        build_date=""
        if [ -n "$mfg_date" ] && [ "$mfg_date" != "Unknown" ]; then
            year=$(echo "$mfg_date" | sed -n 's/^\([0-9]\{4\}\).*/\1/p')
            week=$(echo "$mfg_date" | sed -n 's/.*Week\([0-9]\{1,2\}\).*/\1/p')
            if [ -n "$year" ] && [ -n "$week" ]; then
                jan1_epoch=$(date -d "${year}-01-01 00:00:00" +%s 2>/dev/null) || true
                if [ -n "$jan1_epoch" ]; then
                    jan1_dow=$(date -d "@${jan1_epoch}" +%u 2>/dev/null) || true
                    if [ -n "$jan1_dow" ]; then
                        if [ "$jan1_dow" -le 4 ]; then
                            w1_offset=$((1 - jan1_dow))
                        else
                            w1_offset=$((8 - jan1_dow))
                        fi
                        target_epoch=$((jan1_epoch + (w1_offset + (week - 1) * 7) * 86400))
                        iso_date=$(date -d "@${target_epoch}" +%Y%m%dT000000Z 2>/dev/null) || true
                        if [ -n "$iso_date" ]; then
                            build_date="$iso_date"
                        fi
                    fi
                fi
            fi
        fi

        # Convert dimm size string to KB (e.g., "16 GB" -> 16777216)
        size_kb=0
        if [ -n "$dimm_size" ] && [ "$dimm_size" != "Unknown" ]; then
            size_val=$(echo "$dimm_size" | sed -n 's/^\([0-9]*\).*/\1/p')
            if echo "$dimm_size" | grep -qi "GB"; then
                size_kb=$((size_val * 1024 * 1024))
            elif echo "$dimm_size" | grep -qi "MB"; then
                size_kb=$((size_val * 1024))
            fi
        fi

        # Parse speed: "4800 MT/s" -> 4800
        speed_mts=0
        if [ -n "$dimm_speed" ] && [ "$dimm_speed" != "Unknown" ]; then
            speed_mts=$(echo "$dimm_speed" | sed -n 's/^\([0-9]*\).*/\1/p')
        fi

        # Map dimm-util type string to D-Bus DeviceType enum.
        prefix="xyz.openbmc_project.Inventory.Item.Dimm.DeviceType"
        dbus_mem_type=""
        case "$dimm_type" in
            "LPDDR5 SDRAM")       dbus_mem_type="${prefix}.LPDDR5_SDRAM" ;;
            "LPDDR4X SDRAM")      dbus_mem_type="${prefix}.LPDDR4_SDRAM" ;;
            "LPDDR4 SDRAM")       dbus_mem_type="${prefix}.LPDDR4_SDRAM" ;;
            "LPDDR3 SDRAM")       dbus_mem_type="${prefix}.LPDDR3_SDRAM" ;;
            "DDR5 NVDIMM-P")      dbus_mem_type="${prefix}.DDR5" ;;
            "DDR5 SDRAM")          dbus_mem_type="${prefix}.DDR5" ;;
            "DDR4E SDRAM")         dbus_mem_type="${prefix}.DDR4E_SDRAM" ;;
            "DDR4 SDRAM")          dbus_mem_type="${prefix}.DDR4" ;;
            "DDR3 SDRAM")          dbus_mem_type="${prefix}.DDR3" ;;
            "DDR2 SDRAM FB_DIMM"*) dbus_mem_type="${prefix}.DDR2_SDRAM_FB_DIMM" ;;
            "DDR2 SDRAM")          dbus_mem_type="${prefix}.DDR2" ;;
            "DDR SGRAM")           dbus_mem_type="${prefix}.DDR_SGRAM" ;;
            "DDR SDRAM")           dbus_mem_type="${prefix}.DDR" ;;
            "SDRAM")               dbus_mem_type="${prefix}.SDRAM" ;;
        esac

        log_dimm "$dimm_label" "${manufacturer:-N/A}, ${part_number:-N/A}, ${serial_number:-N/A}, ${dimm_type:-N/A}, ${dimm_speed:-N/A}, ${dimm_size:-N/A}, date=${mfg_date:-N/A}"

        # Queue the validated DIMM for writing (9 fields, US(0x1f)-delimited,
        # same reason as dimm_records: 0x1f cannot appear in SPD ASCII data).
        write_plan+=("$(printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' \
            "$dimm_label" "$obj_path" "$manufacturer" "$part_number" \
            "$serial_number" "$build_date" "$size_kb" "$speed_mts" "$dbus_mem_type")")
    done

    # Data is good when every present writable DIMM yielded valid SPD.
    if [ "${#write_plan[@]}" -gt 0 ] && [ "$stale_count" -eq 0 ]; then
        break
    fi

    if [ "${#write_plan[@]}" -eq 0 ]; then
        log "no valid DIMM SPD yet, retrying... ($((du_retry + 1))/$MAX_RETRIES_DU)"
    else
        log "$stale_count DIMM(s) have no valid SPD yet (${#write_plan[@]} ok), retrying... ($((du_retry + 1))/$MAX_RETRIES_DU)"
    fi
    sleep 5
done

if [ "${#write_plan[@]}" -eq 0 ]; then
    log "failed to read valid DIMM SPD after $MAX_RETRIES_DU attempts, exit"
    exit 2
fi

# Step 4: Write the validated DIMM data to D-Bus settings, retrying only the
# writes (no dimm-util re-read). settingsd/busctl failures are transient and the
# SPD data is already in memory, so re-reading it would be pure waste. done_dimms
# tracks per-DIMM success so a retry re-attempts only the not-yet-written DIMMs.
declare -A done_dimms
write_failed=0
for ((wr_retry = 0; wr_retry < MAX_RETRIES_WR; wr_retry++)); do
    write_failed=0
    for entry in "${write_plan[@]}"; do
        IFS=$'\x1f' read -r dimm_label obj_path manufacturer part_number \
            serial_number build_date size_kb speed_mts dbus_mem_type <<< "$entry"
        size_kb=${size_kb:-0}
        speed_mts=${speed_mts:-0}

        # Skip DIMMs already written in a previous retry
        if [[ -n "${done_dimms[$dimm_label]+x}" ]]; then
            continue
        fi

        # Write asset properties to D-Bus (--timeout=120 matches wf-misc pattern)
        ok=1
        for prop_pair in \
            "Manufacturer:${manufacturer}" \
            "PartNumber:${part_number}" \
            "SerialNumber:${serial_number}"; do
            prop_name="${prop_pair%%:*}"
            prop_val="${prop_pair#*:}"
            if [ -n "$prop_val" ] && [ "$prop_val" != "Unknown" ]; then
                if ! busctl set-property "$SETTINGS_SVC" "$obj_path" "$ASSET_INTF" \
                    "$prop_name" "s" "$prop_val" --timeout=120 2>/dev/null; then
                    log_dimm "$dimm_label" "failed to set $prop_name"
                    ok=0
                fi
            fi
        done
        if [ -n "$build_date" ]; then
            if ! busctl set-property "$SETTINGS_SVC" "$obj_path" "$ASSET_INTF" \
                BuildDate "s" "$build_date" --timeout=120 2>/dev/null; then
                log_dimm "$dimm_label" "failed to set BuildDate"
                ok=0
            fi
        fi
        if [ "$size_kb" -gt 0 ]; then
            if ! busctl set-property "$SETTINGS_SVC" "$obj_path" "$DIMM_INTF" \
                MemorySizeInKB "u" "$size_kb" --timeout=120 2>/dev/null; then
                log_dimm "$dimm_label" "failed to set MemorySizeInKB"
                ok=0
            fi
        fi
        if [ "$speed_mts" -gt 0 ]; then
            if ! busctl set-property "$SETTINGS_SVC" "$obj_path" "$DIMM_INTF" \
                MemoryConfiguredSpeedInMhz "q" "$speed_mts" --timeout=120 2>/dev/null; then
                log_dimm "$dimm_label" "failed to set MemoryConfiguredSpeedInMhz"
                ok=0
            fi
        fi
        if [ -n "$dbus_mem_type" ]; then
            if ! busctl set-property "$SETTINGS_SVC" "$obj_path" "$DIMM_INTF" \
                MemoryType "s" "$dbus_mem_type" --timeout=120 2>/dev/null; then
                log_dimm "$dimm_label" "failed to set MemoryType"
                ok=0
            fi
        fi

        # Write association: this DIMM is contained_by the System board
        if ! busctl set-property "$SETTINGS_SVC" "$obj_path" "$ASSOC_INTF" \
            Associations "a(sss)" 1 \
            "contained_by" "containing" "$board_path" --timeout=120 2>/dev/null; then
            log_dimm "$dimm_label" "failed to set Association"
            ok=0
        fi

        if [ "$ok" -eq 1 ]; then
            done_dimms[$dimm_label]=1
        else
            write_failed=1
            log_dimm "$dimm_label" "partially failed"
        fi
    done

    populated=${#done_dimms[@]}

    # Success: every queued DIMM written. Retry only re-attempts failed writes.
    if [ "$write_failed" -eq 0 ] && [ "$populated" -gt 0 ]; then
        break
    fi

    log "D-Bus write incomplete ($populated/${#write_plan[@]} ok), retrying writes... ($((wr_retry + 1))/$MAX_RETRIES_WR)"
    sleep 5
done

populated=${#done_dimms[@]}

# Drop the once-per-boot marker only when every writable DIMM had valid SPD
# (stale_count==0) AND all writes succeeded. A failed/partial run leaves no marker
# so the next host-start retries.
if [ "$write_failed" -eq 0 ] && [ "$stale_count" -eq 0 ] && [ "$populated" -gt 0 ]; then
    mkdir -p "$(dirname "$MARKER")" && touch "$MARKER"
    log "done, populated $populated DIMMs"
else
    log "done with issues: populated $populated/${#write_plan[@]} DIMMs, stale=$stale_count, write_failed=$write_failed (no marker; will retry next host-start)"
    if [ "$populated" -eq 0 ]; then
        exit 2
    fi
fi
