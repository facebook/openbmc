-	buffer = (char*) malloc(length);
-	if (buffer == NULL) {
-		logger(LL_ERROR, "Out of memory\n");
-		fclose(file);
-		return -1;
-	}
-	bytes = fread(buffer, 1, length, file);
+	buffer = (char *)mmap(0, length, PROT_READ, MAP_PRIVATE, fileno(file), 0);
 	fclose(file);
