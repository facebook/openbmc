From 837221c3eb3391605805624b68727a6ac055f206 Mon Sep 17 00:00:00 2001
From: Alan Tsai <alan-tsai@quantatw.com>
Date: Thu, 20 Aug 2026 21:50:12 +0800
Subject: [PATCH] configurations: revise 100G BRCM NIC configuration

Add an MCTPI2CTarget entry to allow MCTPReactor to automatically
assign an EID to the BRCM NIC over I2C, removing the need for manual
EID configuration.

Update thresholds

Tested on Rainiera7:
- EID is correctly assigned
- Version object is properly exposed
- Temperature sensor threshold is exposed correct value.
---
 .../broadcomm/100g_1p_ocp_mezz.json           | 21 +++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/configurations/broadcomm/100g_1p_ocp_mezz.json b/configurations/broadcomm/100g_1p_ocp_mezz.json
index d3cb955..746cf46 100644
--- a/configurations/broadcomm/100g_1p_ocp_mezz.json
+++ b/configurations/broadcomm/100g_1p_ocp_mezz.json
@@ -3,17 +3,23 @@
         {
             "Address": "$address",
             "Bus": "$bus",
-            "Name": "BRCM OCP NIC FRU $bus",
+            "Name": "BRCM OCP NIC FRU 0",
             "Type": "EEPROM"
         },
+        {
+            "Address": "0x32",
+            "Bus": "$bus",
+            "Name": "NIC0",
+            "Type": "MCTPI2CTarget"
+        },
         {
             "Address": "0x1f",
             "Bus": "$bus",
             "Labels": [
                 "temp2"
             ],
-            "Name": "NIC Temp $bus",
-            "Name1": "NIC Temp $bus",
+            "Name": "NIC0_Temp_C",
+            "Name1": "NIC0_Temp_C",
             "Thresholds": [
                 {
                     "Direction": "less than",
@@ -28,12 +34,19 @@
                     "Name": "upper critical",
                     "Severity": 1,
                     "Value": 105
+                },
+                {
+                    "Direction": "greater than",
+                    "Index": 2,
+                    "Name": "upper non recoverable",
+                    "Severity": 4,
+                    "Value": 115
                 }
             ],
             "Type": "TMP421"
         }
     ],
-    "Name": "BRCM OCP NIC FRU $bus",
+    "Name": "BRCM OCP NIC FRU 0",
     "Probe": "xyz.openbmc_project.FruDevice({'BOARD_PRODUCT_NAME': 'BRCM 100G 1P.*57504 OCP Mezz'})",
     "Type": "Board",
     "xyz.openbmc_project.Inventory.Decorator.Asset": {
