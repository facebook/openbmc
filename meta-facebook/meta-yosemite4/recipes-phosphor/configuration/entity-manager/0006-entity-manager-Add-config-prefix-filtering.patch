From 0c54d1a36d55cdfc0f0dd621ea95fbd7c50cf92c Mon Sep 17 00:00:00 2001
From: Eric Yang <eric.yang.wiwynn@gmail.com>
Date: Tue, 11 Mar 2025 13:47:42 +0800
Subject: [PATCH 6/7] entity-manager: Add config-prefix filtering

This change introduces a new option "config-prefix" that enables
filtering of JSON configuration files by their filename prefix.
This feature reduces unnecessary D-Bus overhead and enhances
performance.

Change-Id: I94a1030edfd78b966aba44d5818b1da82f107c86
Signed-off-by: Eric Yang <eric.yang.wiwynn@gmail.com>
---
 meson.build                          |  5 ++
 meson.options                        |  6 +++
 src/entity_manager/configuration.cpp |  7 ++-
 src/utils.cpp                        | 78 ++++++++++++++++------------
 src/utils.hpp                        | 10 +++-
 5 files changed, 70 insertions(+), 36 deletions(-)

diff --git a/meson.build b/meson.build
index c364a9e..d347e67 100644
--- a/meson.build
+++ b/meson.build
@@ -7,6 +7,11 @@ project(
     meson_version: '>=1.3.0',
 )
 add_project_arguments('-Wno-psabi', language: 'cpp')
+config_prefix_val = get_option('config-prefix')
+add_project_arguments(
+    '-DCONFIG_PREFIX="@0@"'.format(config_prefix_val),
+    language: 'cpp',
+)
 
 boost_args = [
     '-DBOOST_ASIO_NO_DEPRECATED',
diff --git a/meson.options b/meson.options
index 8cdd903..efbf48c 100644
--- a/meson.options
+++ b/meson.options
@@ -53,3 +53,9 @@ option(
     value: true,
     description: 'Cache the current configuration to support new-device detection. This option can be set to false for development, which will force re-parsing of configuration.',
 )
+option(
+    'config-prefix',
+    type: 'string',
+    value: 'all',
+    description: 'Comma-separated list of JSON filename prefixes to filter. Default loads all JSON files.',
+)
diff --git a/src/entity_manager/configuration.cpp b/src/entity_manager/configuration.cpp
index 99f7f66..240faa5 100644
--- a/src/entity_manager/configuration.cpp
+++ b/src/entity_manager/configuration.cpp
@@ -26,10 +26,15 @@ Configuration::Configuration(
 void Configuration::loadConfigurations()
 {
     const auto start = std::chrono::steady_clock::now();
+    const std::string configPrefixesEnv = CONFIG_PREFIX;
+    std::vector<std::string> configPrefixes =
+        (configPrefixesEnv != "all" && !configPrefixesEnv.empty())
+            ? splitConfigString(configPrefixesEnv, ',', true)
+            : std::vector<std::string>{};
 
     // find configuration files
     std::vector<std::filesystem::path> jsonPaths;
-    if (!findFiles(configurationDirectories, R"(.*\.json)", jsonPaths))
+    if (!findFiles(configurationDirectories, R"(.*\.json)", jsonPaths, configPrefixes))
     {
         for (const auto& configurationDirectory : configurationDirectories)
         {
diff --git a/src/utils.cpp b/src/utils.cpp
index b5bac09..a99980f 100644
--- a/src/utils.cpp
+++ b/src/utils.cpp
@@ -19,8 +19,29 @@
 
 namespace fs = std::filesystem;
 
+std::vector<std::string> splitConfigString(const std::string& input,
+                                           char delimiter, bool ignoreSpaces)
+{
+    std::vector<std::string> parts;
+    std::istringstream stream(input);
+    std::string part;
+
+    while (std::getline(stream, part, delimiter))
+    {
+        if (ignoreSpaces)
+        {
+            part.erase(0, part.find_first_not_of(" \t"));
+            part.erase(part.find_last_not_of(" \t") + 1);
+        }
+
+        parts.emplace_back(std::move(part));
+    }
+    return parts;
+}
+
 bool findFiles(const fs::path& dirPath, const std::string& matchString,
-               std::vector<fs::path>& foundPaths)
+               std::vector<fs::path>& foundPaths,
+               const std::vector<std::string>& prefixes)
 {
     if (!fs::exists(dirPath))
     {
@@ -28,51 +49,42 @@ bool findFiles(const fs::path& dirPath, const std::string& matchString,
     }
 
     std::regex search(matchString);
-    std::smatch match;
-    for (const auto& p : fs::directory_iterator(dirPath))
+
+    for (const auto& entry : fs::recursive_directory_iterator(dirPath))
     {
-        std::string path = p.path().string();
-        if (std::regex_search(path, match, search))
+        const std::string filename = entry.path().filename().string();
+
+        if (!std::regex_search(filename, search))
         {
-            foundPaths.emplace_back(p.path());
+            continue;
+        }
+
+        if (!prefixes.empty() &&
+            !std::any_of(prefixes.begin(), prefixes.end(),
+                         [&filename](const std::string& prefix) {
+                             return filename.starts_with(prefix);
+                         }))
+        {
+            continue;
         }
+
+        foundPaths.emplace_back(entry.path());
     }
-    return true;
+
+    return !foundPaths.empty();
 }
 
 bool findFiles(const std::vector<fs::path>& dirPaths,
                const std::string& matchString,
-               std::vector<fs::path>& foundPaths)
+               std::vector<fs::path>& foundPaths,
+               const std::vector<std::string>& prefixes)
 {
-    std::map<fs::path, fs::path> paths;
-    std::regex search(matchString);
-    std::smatch match;
     for (const auto& dirPath : dirPaths)
     {
-        if (!fs::exists(dirPath))
+        if (fs::exists(dirPath))
         {
-            continue;
+            findFiles(dirPath, matchString, foundPaths, prefixes);
         }
-
-        for (const auto& p : fs::recursive_directory_iterator(dirPath))
-        {
-            std::error_code ec;
-            if (p.is_directory(ec))
-            {
-                continue;
-            }
-
-            std::string path = p.path().string();
-            if (std::regex_search(path, match, search))
-            {
-                paths[p.path().filename()] = p.path();
-            }
-        }
-    }
-
-    for (const auto& [key, value] : paths)
-    {
-        foundPaths.emplace_back(value);
     }
 
     return !foundPaths.empty();
diff --git a/src/utils.hpp b/src/utils.hpp
index 368de5a..241a940 100644
--- a/src/utils.hpp
+++ b/src/utils.hpp
@@ -23,10 +23,16 @@ using LastIndex = size_t;
 
 bool findFiles(const std::filesystem::path& dirPath,
                const std::string& matchString,
-               std::vector<std::filesystem::path>& foundPaths);
+               std::vector<std::filesystem::path>& foundPaths,
+               const std::vector<std::string>& prefixes = {});
+
 bool findFiles(const std::vector<std::filesystem::path>& dirPaths,
                const std::string& matchString,
-               std::vector<std::filesystem::path>& foundPaths);
+               std::vector<std::filesystem::path>& foundPaths,
+               const std::vector<std::string>& prefixes = {});
+
+std::vector<std::string> splitConfigString(
+    const std::string& input, char delimiter = ',', bool ignoreSpaces = true);
 
 bool getI2cDevicePaths(
     const std::filesystem::path& dirPath,
