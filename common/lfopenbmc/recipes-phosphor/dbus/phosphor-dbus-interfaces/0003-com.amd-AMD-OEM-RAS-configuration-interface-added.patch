diff --git a/yaml/com/amd/RAS/Configuration.interface.yaml b/yaml/com/amd/RAS/Configuration.interface.yaml
new file mode 100644
index 0000000..bedd92d
--- /dev/null
+++ b/yaml/com/amd/RAS/Configuration.interface.yaml
@@ -0,0 +1,72 @@
+description: >
+    Configuration parameters used by the AMD BMC RAS application.
+
+methods:
+    - name: SetAttribute
+      description: >
+          To set the new value on existing attribute name.
+      parameters:
+          - name: AttributeName
+            type: string
+            description: >
+                AttributeName which has to be changed.
+          - name: AttributeValue
+            type:
+                variant[boolean,string,int64,array[string],dict[string, string]]
+            description: >
+                New attribute value
+
+      errors:
+          - xyz.openbmc_project.Common.Error.InvalidArgument
+
+    - name: GetAttribute
+      description: >
+          To get the attribute value of existing attributes.
+      parameters:
+          - name: AttributeName
+            type: string
+            description: >
+                To get the RAS configuration attribute current values.
+
+      returns:
+          - name: Value
+            type:
+                variant[boolean,string,int64,array[string],dict[string, string]]
+            description: >
+                The attribute value.
+
+      errors:
+          - xyz.openbmc_project.Common.Error.InvalidArgument
+          - xyz.openbmc_project.Common.Error.InternalFailure
+          - xyz.openbmc_project.Common.File.Error.Open
+
+properties:
+    - name: RasConfigTable
+      type:
+          dict[string,struct[enum[self.AttributeType],string,variant[boolean,string,int64,array[string],dict[string,
+          string]],int64]]
+      description: >
+          map{attributeName,struct{attributeType,description,value,maxboundlimit}
+          Example : {"McaErrCounterOverflow",
+          {com.amd.RAS.Configuration.AttributeType.Integer,
+           "Error counter threshold overflow for MCA errors",10,0xFFF}
+enumerations:
+    - name: AttributeType
+      description: >
+          Attribute Type.
+      values:
+          - name: Boolean
+            description: >
+                Boolean value Type
+          - name: String
+            description: >
+                string value Type.
+          - name: Integer
+            description: >
+                unsigned integer value Type.
+          - name: ArrayOfStrings
+            description: >
+                Array of strings value Type.
+          - name: KeyValueMap
+            description: >
+                key-value pairs value Type.
diff --git a/yaml/com/amd/crashdump.interface.yaml b/yaml/com/amd/crashdump.interface.yaml
new file mode 100644
index 0000000..a0035d8
--- /dev/null
+++ b/yaml/com/amd/crashdump.interface.yaml
@@ -0,0 +1,22 @@
+description: >
+    This interface provides details about Common Platform Error Record (CPER)
+    files that are available on the BMC. Each CPER file is represented as a CPER
+    Record object, which holds key attributes of the file.
+properties:
+    - name: Filename
+      type: string
+      description: >
+          The name of the CPER file stored on the BMC. This attribute uniquely
+          identifies the file and can be used to locate or refer to the specific
+          CPER file in the system.
+    - name: Timestamp
+      type: string
+      description: >
+          Indicates the time when the CPER file was generated. This timestamp
+          provides critical information for correlating the error record with
+          system events or logs, aiding in diagnostics and root cause analysis.
+    - name: Log
+      type: string
+      description: >
+          An additional string that gives the file path of the CPER files
+          saved in the BMC.
