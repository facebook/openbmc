From 001ef4eaadeaa21f768bf56f7ccc9556a478ebbe Mon Sep 17 00:00:00 2001
From: Peter Yin <peter.yin@quantatw.com>
Date: Thu, 22 Aug 2024 22:50:05 +0800
Subject: [PATCH] ARM: dts: aspeed: Harma: enable uart dma mode

enable uart dma mode in uart4 and uart6.

BaseOn: https://lore.kernel.org/openbmc/20230320081133.23655-1-chiawei_wang@aspeedtech.com/
The DMA UART driver has not yet been merged upstream, so the patch is currently only in the meta layer.
---
 arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts
index 0a0a5a1e187a..9bba25187e60 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts
@@ -86,21 +86,30 @@ tpm@0 {
 	};
 };
 
+&udma {
+	status = "okay";
+};
+
 // HOST BIOS Debug
 &uart1 {
+	compatible = "aspeed,ast2600-uart";
 	status = "okay";
 };
 
 // SOL Host Console
 &uart2 {
+	compatible = "aspeed,ast2600-uart";
 	status = "okay";
 	pinctrl-0 = <>;
 };
 
 // SOL BMC Console
 &uart4 {
+	compatible = "aspeed,ast2600-uart";
 	status = "okay";
 	pinctrl-0 = <>;
+	dmas = <&udma 6>, <&udma 7>;
+	dma-names = "tx", "rx";
 };
 
 // BMC Debug Console
-- 
2.53.0-Meta

