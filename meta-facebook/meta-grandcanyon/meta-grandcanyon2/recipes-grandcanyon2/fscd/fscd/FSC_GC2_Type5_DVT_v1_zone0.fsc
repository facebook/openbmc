max_e1s_temp = max([
  e1s_iocm:e1s_x0_temp_c,
  e1s_iocm:e1s_x1_temp_c]);
max_mb_dimm_temp_c = max([
  server:mb_dimma2_temp_c,
  server:mb_dimma3_temp_c,
  server:mb_dimma6_temp_c,
  server:mb_dimma7_temp_c]);
max_mb_vr_temp_c = max([
  server:mb_vr_vccin_temp_c,
  server:mb_vr_fivra_temp_c,
  server:mb_vr_ehv_temp_c,
  server:mb_vr_vccd_temp_c,
  server:mb_vr_faon_temp_c]);
max_dpb_inlet_temp = max([
  dpb:dpb_0_inlet_temp_c,
  dpb:dpb_1_inlet_temp_c]);
max_ptb_dc_module_temp = max([
  dpb:ptb_dcmodule0_12v_temp_c,
  dpb:ptb_dcmodule1_12v_temp_c]);
max_scc_temp = max([
  scc:scc_bottom_temp_c,
  scc:scc_top_temp_c]);

max([
  linear_soc_therm_margin(server:mb_soc_thermal_margin_c) + pid_soc_therm_margin(server:mb_soc_thermal_margin_c),
  linear_nic_sensor_temp(nic:nic_sensor_temp_c) + pid_nic_sensor_temp(nic:nic_sensor_temp_c),
  linear_e1s_sensor_temp(max_e1s_temp) + pid_e1s_sensor_temp(max_e1s_temp),
  linear_scc_ioc_temp(scc:scc_ioc_temp_c) + pid_scc_ioc_temp(scc:scc_ioc_temp_c),
  linear_boot_drv_temp(server:mb_e1s_temp_c) + pid_boot_drv_temp(server:mb_e1s_temp_c),
  linear_uic_inlet_temp(uic:uic_inlet_temp_c),
  linear_mb_inlet_temp(server:mb_inlet_temp_c),
  linear_mb_pch_temp(server:mb_pch_temp_c),
  linear_mb_dimm_temp(max_mb_dimm_temp_c),
  linear_mb_efuse_temp(server:mb_efuse_temp_c),
  linear_mb_vr_temp(max_mb_vr_temp_c),
  linear_dpb_inlet_temp(max_dpb_inlet_temp),
  linear_dpb_outlet_temp(dpb:dpb_outlet_temp_c),
  linear_ptb_dc_module_temp(max_ptb_dc_module_temp),
  linear_scc_temp(max_scc_temp)
])
