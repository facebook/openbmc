From: James Athappilly <jamesatha@meta.com>
Subject: [PATCH] ntpd: use ASN.1 string accessors for OpenSSL 4

OpenSSL 4 makes ASN1_STRING opaque. Use the public accessors to
read the time without accessing its fields. Decode the subject key
identifier with the public extension API rather than assuming a fixed
DER header size; reject decoding and key conversion failures.

--- a/ntpd/ntp_crypto.c
+++ b/ntpd/ntp_crypto.c
@@ -2032,9 +2032,9 @@
 	 * Also note that two-digit years less than 50 map to years greater than
 	 * 100. Dontcha love ASN.1? Better than MIL-188.
 	 */
-	len = asn1time->length;
+	len = ASN1_STRING_length(asn1time);
 	REQUIRE(len < sizeof(v));
-	(void)strncpy(v, (char *)(asn1time->data), len);
+	(void)strncpy(v, (const char *)ASN1_STRING_get0_data(asn1time), len);
 	REQUIRE(len >= 13);
 	temp = strtoul(v+len-3, NULL, 10);
 	pjd->second = temp;
@@ -3550,9 +3550,20 @@
 		 * contains the GQ public key.
 		 */
 		case NID_subject_key_identifier:
-			data = X509_EXTENSION_get_data(ext);
-			ret->grpkey = BN_bin2bn(&data->data[2],
-			    data->length - 2, NULL);
+			data = X509V3_EXT_d2i(ext);
+			if (data == NULL) {
+				cert_free(ret);
+				X509_free(cert);
+				return (NULL);
+			}
+			ret->grpkey = BN_bin2bn(ASN1_STRING_get0_data(data),
+			    ASN1_STRING_length(data), NULL);
+			ASN1_OCTET_STRING_free(data);
+			if (ret->grpkey == NULL) {
+				cert_free(ret);
+				X509_free(cert);
+				return (NULL);
+			}
 			/* fall through */
 		default:
 			DPRINTF(1, ("cert_parse: %s\n",
