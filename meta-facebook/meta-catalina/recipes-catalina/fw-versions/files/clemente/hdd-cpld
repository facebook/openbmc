#!/bin/bash
set -e

if [ -z "$1" ]; then
    echo "Error: No instances parameter provided."
    exit 1
fi

instances=$1
max_retries=3
retry_count=0
version=""

# Wait before the first read to allow CPLD to power up
echo "Waiting 35s before first read to allow CPLD power-up..."
sleep 35

while [ $retry_count -lt $max_retries ]; do
    # Read CPLD version (allow failure without exiting)
    version=$(fw-util "hdd${instances}" --version cpld 2>&1 | awk '{print $NF}') || true
    echo "version: $version"

    # Check if version matches format 000XXXXX (X = 0-9A-F)
    if [[ "$version" =~ ^000[0-9A-Fa-f]{5}$ ]]; then
        # Valid format - success
        break
    fi

    retry_count=$((retry_count+1))
    if [ $retry_count -lt $max_retries ]; then
        echo "Retrying in 5 seconds... ($retry_count/$max_retries)"
        sleep 5
    fi
done

# If version format is still invalid after retries, treat as failure
if ! [[ "$version" =~ ^000[0-9A-Fa-f]{5}$ ]]; then
    echo "Error: Unable to read valid version after $max_retries attempts."
    version="NA"
fi

# Set the version property in D-Bus
busctl set-property \
    xyz.openbmc_project.Settings \
    "/xyz/openbmc_project/software/chassis/Clemente_HDD_cpld_${instances}" \
    xyz.openbmc_project.Software.Version \
    Version "s" "$version"