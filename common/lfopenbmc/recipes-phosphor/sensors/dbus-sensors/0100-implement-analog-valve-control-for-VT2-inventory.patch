+static bool probeI2CDevice(int busNum, int devAddr)
+{
+    std::string busPath = "/dev/i2c-" + std::to_string(busNum);
+
+    int fd = open(busPath.c_str(), O_RDWR);
+    if (fd < 0)
+        return false;
+
+    if (ioctl(fd, I2C_SLAVE_FORCE, devAddr) < 0)
+    {
+        close(fd);
+        return false;
+    }
+
+    char buf = 0;
+    bool alive = (read(fd, &buf, 1) >= 0);
+    close(fd);
+    return alive;
+}
+
+static std::string probeI2CBus(const std::string& devAddrHex)
+{
+    int addr = std::stoi(devAddrHex, nullptr, 16);
+    for (int bus : {3, 6})
+    {
+        if (probeI2CDevice(bus, addr))
+        {
+            debug("I2C probe OK: bus={BUS} addr=0x{ADDR}", "BUS", bus, "ADDR",
+                  devAddrHex);
+            return "/sys/bus/i2c/devices/" + std::to_string(bus) + "-" +
+                   devAddrHex;
+        }
+    }
+    return "";
+}
+
+struct ValveHW
+{
+    std::string dacAddr;
+    std::string dacChannel;
+    std::string adcAddr;
+    std::string adcChannel;
+    std::string reportCloseGpioLine;
+};
+
+static const std::unordered_map<std::string, ValveHW> hwMap = {
+    {"SupplyValve2_1",
+     {"000f", "out_voltage0_raw", "0008", "in_voltage0_raw",
+      "REPORT_VT2_SUPPLY1_CLOSE"}},
+    {"SupplyValve2_2",
+     {"000c", "out_voltage0_raw", "0008", "in_voltage1_raw",
+      "REPORT_VT2_SUPPLY2_CLOSE"}},
+    {"SupplyValve2_3",
+     {"000e", "out_voltage0_raw", "0009", "in_voltage0_raw",
+      "REPORT_VT2_SUPPLY3_CLOSE"}},
+};
+
+auto getAnalogValveConfig(sdbusplus::async::context& /*ctx*/,
+                          sdbusplus::message::object_path objectPath)
+    -> sdbusplus::async::task<std::optional<AnalogValveConfig>>
+{
+    AnalogValveConfig valveConfig = {};
+    valveConfig.name = objectPath.filename();
+
+    auto it = hwMap.find(valveConfig.name);
+    if (it == hwMap.end())
+    {
+        error("No HW mapping for valve {NAME}", "NAME", valveConfig.name);
+        co_return std::nullopt;
+    }
+
+    const auto& hw = it->second;
+
+    valveConfig.controlDevicePath = probeI2CBus(hw.dacAddr);
+    valveConfig.controlChannel = hw.dacChannel;
+    valveConfig.feedbackDevicePath = probeI2CBus(hw.adcAddr);
+    valveConfig.feedbackChannel = hw.adcChannel;
+    valveConfig.reportCloseGpioLine = hw.reportCloseGpioLine;
+
+    if (valveConfig.controlDevicePath.empty())
+    {
+        error("Failed to probe DAC for valve {NAME}", "NAME", valveConfig.name);
+        co_return std::nullopt;
+    }
+    if (valveConfig.feedbackDevicePath.empty())
+    {
+        error("Failed to probe ADC for valve {NAME}", "NAME", valveConfig.name);
+        co_return std::nullopt;
+    }
+
+    debug("Valve {NAME}: DAC={DAC}/{DCHAN} ADC={ADC}/{ACHAN}", "NAME",
+          valveConfig.name, "DAC", valveConfig.controlDevicePath, "DCHAN",
+          valveConfig.controlChannel, "ADC", valveConfig.feedbackDevicePath,
+          "ACHAN", valveConfig.feedbackChannel);
+
+    co_return valveConfig;
+}
