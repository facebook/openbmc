From e803d00b9f0b03479e880d39a17db45122e7fb35 Mon Sep 17 00:00:00 2001
From: Alan Tsai <alan-tsai@quantatw.com>
Date: Thu, 3 Sep 2026 14:28:59 +0800
Subject: [PATCH] aspeed: i2c: fix AST2700 target buffer mode NULL dereference

AST2700 target buffer mode does not use the DMA buffer, so
target_dma_buf is not allocated for this mode.

However, ast2700_i2c_target_packet_buff_irq() still reads received data
from target_dma_buf and passes the buffer pointer to i2c_slave_event().
When an I2C target transaction is received in buffer mode, this can
dereference a NULL target_dma_buf and cause a kernel panic in the I2C
slave callback path, such as ssif_bmc_cb().

Read the received bytes directly from the AST2700 target buffer MMIO
area instead, and pass each byte to I2C_SLAVE_WRITE_RECEIVED through a
local value.

This keeps the buffer-mode data path independent of target_dma_buf and
does not change the existing DMA-mode behavior.

Tested on AST2700 with the SSIF BMC target running in buffer mode.
SSIF transactions can be received without triggering the previous NULL
pointer dereference.
---
 drivers/i2c/busses/i2c-ast2600.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/drivers/i2c/busses/i2c-ast2600.c b/drivers/i2c/busses/i2c-ast2600.c
index 772bd9fc4..da7ab72e4 100644
--- a/drivers/i2c/busses/i2c-ast2600.c
+++ b/drivers/i2c/busses/i2c-ast2600.c
@@ -1320,8 +1320,8 @@ static void ast2700_i2c_target_packet_buff_irq(struct ast2600_i2c_bus *i2c_bus,
 			if (!i2c_bus->target)
 				ast2700_i2c_get_target(i2c_bus, sirq_log >> SLAVE_ADDR_SHIFT);
 			if (i2c_bus->target) {
-				i2c_slave_event(i2c_bus->target, I2C_SLAVE_WRITE_REQUESTED,
-						&i2c_bus->target_dma_buf[0]);
+				value = readb(i2c_bus->buf_base + 0x30);
+				i2c_slave_event(i2c_bus->target, I2C_SLAVE_WRITE_REQUESTED, &value);
 			}
 			sirq_log = readl(i2c_bus->reg_base + AST2700_I2CC_SIRQ_LOG);
 		}
@@ -1448,8 +1448,8 @@ static void ast2700_i2c_target_packet_buff_irq(struct ast2600_i2c_bus *i2c_bus,
 							  AST2600_I2CS_DMA_LEN_STS));
 		for (i = 0; i < target_rx_len; i++) {
 			if (i2c_bus->target) {
-				i2c_slave_event(i2c_bus->target, I2C_SLAVE_WRITE_RECEIVED,
-						&i2c_bus->target_dma_buf[i]);
+				value = readb(i2c_bus->buf_base + 0x30 + i);
+				i2c_slave_event(i2c_bus->target, I2C_SLAVE_WRITE_RECEIVED, &value);
 			}
 		}
 		sirq_log = readl(i2c_bus->reg_base + AST2700_I2CC_SIRQ_LOG);
@@ -1500,8 +1500,8 @@ static void ast2700_i2c_target_packet_buff_irq(struct ast2600_i2c_bus *i2c_bus,
 		if (!i2c_bus->target)
 			ast2700_i2c_get_target(i2c_bus, sirq_log >> SLAVE_ADDR_SHIFT);
 		if (i2c_bus->target) {
-			i2c_slave_event(i2c_bus->target, I2C_SLAVE_WRITE_REQUESTED,
-					&i2c_bus->target_dma_buf[0]);
+			value = readb(i2c_bus->buf_base + 0x30);
+			i2c_slave_event(i2c_bus->target, I2C_SLAVE_WRITE_REQUESTED, &value);
 		}
 		sirq_log = readl(i2c_bus->reg_base + AST2700_I2CC_SIRQ_LOG);
 		target_rx_len = AST2600_I2C_GET_RX_DMA_LEN(readl(i2c_bus->reg_base +
