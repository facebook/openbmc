From b1695226664fcfc017357292447c5f9dd5ad45b6 Mon Sep 17 00:00:00 2001
From: Zinc Lim <zinclim@meta.com>
Date: Wed, 12 Aug 2026 00:21:10 -0700
Subject: [PATCH] hw/i2c/aspeed: add target buffer mode RX support

The AST2600 target only implemented DMA mode RX: aspeed_i2c_bus_new_slave_event()
NAKed I2C_START_SEND_ASYNC whenever I2CS_CMD.RX_DMA_EN was clear. The Linux
i2c-ast2600 driver defaults to buffer mode -- DMA is opt-in via
"aspeed,enable-dma" -- so a board without that property could not receive as an
I2C target, and mctpd reported "MCTP Endpoint did not respond".

Implement buffer mode target RX. Bytes are stored in the upper half of the bus
buffer pool (pool + 0x10) and counted in I2CC_POOL_CTRL.RX_COUNT, where the
driver reads them. The pool is armed one chunk at a time: on an address match,
and again each time it fills, raise WAIT_RX_DMA and withhold the ACK until the
driver arms I2CS_CMD.RX_BUFF_EN, which is what lets a transfer exceed the 16 byte
pool. The STOP interrupt omits SLAVE_ADDR_RX_MATCH because
ast2600_i2c_target_packet_buff_irq() has no case for SLAVE_MATCH|RX_DONE|STOP.

WAIT_RX_DMA gates that withheld ACK, so it is not a write-to-clear status bit
like the rest of the low word: only arming RX_BUFF_EN or ending the transfer may
clear it. Clearing it while the ACK is still owed strands the initiator
mid-transfer and every later master transfer on the bus fails with -EBUSY.

Two supporting fixes: clear WAIT_TX_DMA when the guest W1Cs PKT_CMD_DONE, as a
stale flag is decoded as part of the next target interrupt; and return the real
I2CM_CMD register on read instead of -1, since the target ISR checks it for an
in-flight master command and all ones aborted every master transfer with -EBUSY.

DMA mode target RX is unchanged.

Signed-off-by: Zinc Lim <zinclim@meta.com>
---
 hw/i2c/aspeed_i2c.c         | 142 ++++++++++++++++++++++++++++++------
 include/hw/i2c/aspeed_i2c.h |   4 +
 2 files changed, 124 insertions(+), 22 deletions(-)

diff --git a/hw/i2c/aspeed_i2c.c b/hw/i2c/aspeed_i2c.c
index d358616b11..f82775a210 100644
--- a/hw/i2c/aspeed_i2c.c
+++ b/hw/i2c/aspeed_i2c.c
@@ -170,6 +170,7 @@ static uint64_t aspeed_i2c_bus_new_read(AspeedI2CBus *bus, hwaddr offset,
         value = extract64(bus->dma_dram_offset, 0, 32);
         break;
     case A_I2CM_CMD:
+        value = bus->regs[R_I2CM_CMD];
         value = SHARED_FIELD_DP32(value, BUS_BUSY_STS, i2c_bus_busy(bus->bus));
         break;
     case A_I2CM_DMA_TX_ADDR_HI:
@@ -889,6 +890,14 @@ static void aspeed_i2c_bus_new_write(AspeedI2CBus *bus, hwaddr offset,
         i2c_slave_set_address(bus->slave,
             SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CS_DEV_ADDR,
                                     SLAVE_DEV_ADDR1));
+        /* Arming the RX buffer releases a transfer held off waiting for it. */
+        if (SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CS_CMD, RX_BUFF_EN)) {
+            SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CC_POOL_CTRL, RX_COUNT, 0);
+            if (ARRAY_FIELD_EX32(bus->regs, I2CS_INTR_STS, WAIT_RX_DMA)) {
+                ARRAY_FIELD_DP32(bus->regs, I2CS_INTR_STS, WAIT_RX_DMA, 0);
+                i2c_ack(bus->bus);
+            }
+        }
         break;
     case A_I2CS_INTR_CTRL:
         bus->regs[R_I2CS_INTR_CTRL] = value;
@@ -898,9 +907,16 @@ static void aspeed_i2c_bus_new_write(AspeedI2CBus *bus, hwaddr offset,
         if (ARRAY_FIELD_EX32(bus->regs, I2CS_INTR_CTRL, PKT_CMD_DONE)) {
             if (ARRAY_FIELD_EX32(bus->regs, I2CS_INTR_STS, PKT_CMD_DONE) &&
                 FIELD_EX32(value, I2CS_INTR_STS, PKT_CMD_DONE)) {
-                bus->regs[R_I2CS_INTR_STS] &= 0xfffc0000;
+                /*
+                 * Also clears WAIT_TX_DMA, but not WAIT_RX_DMA: it gates the
+                 * bus ACK withheld in A_I2CS_CMD, so only arming RX_BUFF_EN
+                 * or ending the transfer may clear it.
+                 */
+                bus->regs[R_I2CS_INTR_STS] &= 0xfdfc0000;
             }
         } else {
+            /* Same invariant on the explicit write-to-clear path. */
+            value &= ~R_I2CS_INTR_STS_WAIT_RX_DMA_MASK;
             bus->regs[R_I2CS_INTR_STS] &= ~value;
         }
         if (!bus->regs[R_I2CS_INTR_STS]) {
@@ -1477,33 +1493,119 @@ static const char *I2C_EVENT[] = {
     [I2C_FINISH] = "I2C_FINISH",
 };
 
+static void aspeed_i2c_bus_slave_dma_rx_start(AspeedI2CBus *bus)
+{
+    AspeedI2CClass *aic = ASPEED_I2C_GET_CLASS(bus->controller);
+
+    ARRAY_FIELD_DP32(bus->regs, I2CS_DMA_LEN_STS, RX_LEN, 0);
+    bus->dma_dram_offset =
+        deposit64(bus->dma_dram_offset, 0, 32,
+                  bus->regs[R_I2CS_DMA_RX_ADDR] & aic->dma_addr_lo_mask);
+    bus->regs[R_I2CC_DMA_LEN] =
+        ARRAY_FIELD_EX32(bus->regs, I2CS_DMA_LEN, RX_BUF_LEN) + 1;
+    i2c_ack(bus->bus);
+}
+
+static void aspeed_i2c_bus_slave_dma_rx_store(AspeedI2CBus *bus, uint8_t data)
+{
+    assert(address_space_write(&bus->controller->dram_as,
+                               bus->dma_dram_offset,
+                               MEMTXATTRS_UNSPECIFIED, &data, 1) == MEMTX_OK);
+
+    bus->dma_dram_offset++;
+    bus->regs[R_I2CC_DMA_LEN]--;
+    ARRAY_FIELD_DP32(bus->regs, I2CS_DMA_LEN_STS, RX_LEN,
+                     ARRAY_FIELD_EX32(bus->regs, I2CS_DMA_LEN_STS, RX_LEN) + 1);
+    i2c_ack(bus->bus);
+}
+
+/*
+ * The buffer mode target pool is armed one chunk at a time, so withhold the
+ * ACK until the driver arms RX_BUFF_EN again (see A_I2CS_CMD).
+ */
+static void aspeed_i2c_bus_slave_buff_rx_wait(AspeedI2CBus *bus)
+{
+    SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CS_CMD, RX_BUFF_EN, 0);
+    ARRAY_FIELD_DP32(bus->regs, I2CS_INTR_STS, WAIT_RX_DMA, 1);
+    ARRAY_FIELD_DP32(bus->regs, I2CS_INTR_STS, PKT_CMD_DONE, 1);
+    aspeed_i2c_bus_raise_slave_interrupt(bus);
+}
+
+static void aspeed_i2c_bus_slave_buff_rx_start(AspeedI2CBus *bus)
+{
+    SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CC_POOL_CTRL, RX_COUNT, 0);
+    ARRAY_FIELD_DP32(bus->regs, I2CS_INTR_STS, SLAVE_ADDR_RX_MATCH, 1);
+    aspeed_i2c_bus_slave_buff_rx_wait(bus);
+}
+
+static void aspeed_i2c_bus_slave_buff_rx_store(AspeedI2CBus *bus, uint8_t data)
+{
+    AspeedI2CClass *aic = ASPEED_I2C_GET_CLASS(bus->controller);
+    uint32_t count = SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CC_POOL_CTRL,
+                                             RX_COUNT);
+    uint32_t size = MIN(SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CC_POOL_CTRL,
+                                                RX_SIZE) + 1,
+                        aic->pool_size - ASPEED_I2C_BUS_POOL_RX_OFFSET);
+
+    if (!SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CS_CMD, RX_BUFF_EN) ||
+        count >= size) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: Slave mode RX buffer is not armed\n", __func__);
+        return;
+    }
+
+    aic->bus_pool_base(bus)[ASPEED_I2C_BUS_POOL_RX_OFFSET + count++] = data;
+    SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CC_POOL_CTRL, RX_COUNT, count);
+    trace_aspeed_i2c_bus_recv(bus->id, "SBUF", count, size, data);
+
+    if (count == size) {
+        /* Pool is full: have it drained before ACKing this byte. */
+        SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CS_INTR_STS, RX_DONE, 1);
+        aspeed_i2c_bus_slave_buff_rx_wait(bus);
+        return;
+    }
+
+    i2c_ack(bus->bus);
+}
+
 static int aspeed_i2c_bus_new_slave_event(AspeedI2CBus *bus,
                                           enum i2c_event event)
 {
-    AspeedI2CClass *aic = ASPEED_I2C_GET_CLASS(bus->controller);
+    bool rx_dma = SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CS_CMD, RX_DMA_EN);
 
     trace_aspeed_i2c_bus_new_slave_event(bus->id, I2C_EVENT[event]);
 
     switch (event) {
     case I2C_START_SEND_ASYNC:
-        if (!SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CS_CMD, RX_DMA_EN)) {
+        if (rx_dma) {
+            aspeed_i2c_bus_slave_dma_rx_start(bus);
+        } else if (ARRAY_FIELD_EX32(bus->regs, I2CS_CMD, PKT_MODE_EN)) {
+            aspeed_i2c_bus_slave_buff_rx_start(bus);
+        } else {
             qemu_log_mask(LOG_GUEST_ERROR,
-                          "%s: Slave mode RX DMA is not enabled\n", __func__);
+                          "%s: Slave mode RX DMA/buffer is not enabled\n",
+                          __func__);
             return -1;
         }
-        ARRAY_FIELD_DP32(bus->regs, I2CS_DMA_LEN_STS, RX_LEN, 0);
-        bus->dma_dram_offset =
-            deposit64(bus->dma_dram_offset, 0, 32,
-                      bus->regs[R_I2CS_DMA_RX_ADDR] & aic->dma_addr_lo_mask);
-        bus->regs[R_I2CC_DMA_LEN] =
-            ARRAY_FIELD_EX32(bus->regs, I2CS_DMA_LEN, RX_BUF_LEN) + 1;
-        i2c_ack(bus->bus);
         break;
     case I2C_FINISH:
         ARRAY_FIELD_DP32(bus->regs, I2CS_INTR_STS, PKT_CMD_DONE, 1);
-        ARRAY_FIELD_DP32(bus->regs, I2CS_INTR_STS, SLAVE_ADDR_RX_MATCH, 1);
+        if (rx_dma) {
+            ARRAY_FIELD_DP32(bus->regs, I2CS_INTR_STS, SLAVE_ADDR_RX_MATCH, 1);
+            SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CS_INTR_STS, RX_DONE, 1);
+        } else {
+            /*
+             * No SLAVE_ADDR_RX_MATCH: buffer mode reported the match with
+             * the arming interrupt and only decodes a STOP without one.
+             */
+            SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CS_CMD, RX_BUFF_EN, 0);
+            ARRAY_FIELD_DP32(bus->regs, I2CS_INTR_STS, WAIT_RX_DMA, 0);
+            if (SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CC_POOL_CTRL,
+                                        RX_COUNT)) {
+                SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CS_INTR_STS, RX_DONE, 1);
+            }
+        }
         SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CS_INTR_STS, NORMAL_STOP, 1);
-        SHARED_ARRAY_FIELD_DP32(bus->regs, R_I2CS_INTR_STS, RX_DONE, 1);
         aspeed_i2c_bus_raise_slave_interrupt(bus);
         break;
     default:
@@ -1562,15 +1664,11 @@ static int aspeed_i2c_bus_slave_event(I2CSlave *slave, enum i2c_event event)
 
 static void aspeed_i2c_bus_new_slave_send_async(AspeedI2CBus *bus, uint8_t data)
 {
-    assert(address_space_write(&bus->controller->dram_as,
-                               bus->dma_dram_offset,
-                               MEMTXATTRS_UNSPECIFIED, &data, 1) == MEMTX_OK);
-
-    bus->dma_dram_offset++;
-    bus->regs[R_I2CC_DMA_LEN]--;
-    ARRAY_FIELD_DP32(bus->regs, I2CS_DMA_LEN_STS, RX_LEN,
-                     ARRAY_FIELD_EX32(bus->regs, I2CS_DMA_LEN_STS, RX_LEN) + 1);
-    i2c_ack(bus->bus);
+    if (SHARED_ARRAY_FIELD_EX32(bus->regs, R_I2CS_CMD, RX_DMA_EN)) {
+        aspeed_i2c_bus_slave_dma_rx_store(bus, data);
+    } else {
+        aspeed_i2c_bus_slave_buff_rx_store(bus, data);
+    }
 }
 
 static void aspeed_i2c_bus_slave_send_async(I2CSlave *slave, uint8_t data)
diff --git a/include/hw/i2c/aspeed_i2c.h b/include/hw/i2c/aspeed_i2c.h
index 8e8daa4865..b14f441525 100644
--- a/include/hw/i2c/aspeed_i2c.h
+++ b/include/hw/i2c/aspeed_i2c.h
@@ -37,6 +37,7 @@ OBJECT_DECLARE_TYPE(AspeedI2CState, AspeedI2CClass, ASPEED_I2C)
 #define ASPEED_I2C_NR_BUSSES 16
 #define ASPEED_I2C_SHARE_POOL_SIZE 0x800
 #define ASPEED_I2C_BUS_POOL_SIZE 0x40
+#define ASPEED_I2C_BUS_POOL_RX_OFFSET 0x10
 #define ASPEED_I2C_NEW_NUM_REG (0xa0 >> 2)
 
 #define A_I2CD_M_STOP_CMD       BIT(5)
@@ -189,6 +190,9 @@ REG32(I2CS_INTR_CTRL, 0x20)
 REG32(I2CS_INTR_STS, 0x24)
     /* 31:29 shared with I2CD_INTR_STS[31:29] */
     FIELD(I2CS_INTR_STS, SLAVE_PARKING_STS, 24, 2)
+    /* SLAVE_PARKING_STS bits, per direction: waiting to be armed */
+    FIELD(I2CS_INTR_STS, WAIT_TX_DMA, 25, 1)
+    FIELD(I2CS_INTR_STS, WAIT_RX_DMA, 24, 1)
     FIELD(I2CS_INTR_STS, SLAVE_ADDR3_NAK, 22, 1)
     FIELD(I2CS_INTR_STS, SLAVE_ADDR2_NAK, 21, 1)
     FIELD(I2CS_INTR_STS, SLAVE_ADDR1_NAK, 20, 1)
-- 
