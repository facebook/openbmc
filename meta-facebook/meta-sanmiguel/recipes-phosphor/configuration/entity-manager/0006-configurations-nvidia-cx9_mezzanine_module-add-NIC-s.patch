          │ ├─ /xyz/openbmc_project/inventory/system/board/NVIDIA_VR_NVL72_IO_Board_2/IOB2_NIC1_PWR_W
          │ ├─ /xyz/openbmc_project/inventory/system/board/NVIDIA_VR_NVL72_IO_Board_2/IOB2_NIC1_TEMP_C
