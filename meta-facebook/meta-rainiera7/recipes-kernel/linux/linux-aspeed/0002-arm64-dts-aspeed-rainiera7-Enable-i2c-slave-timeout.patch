From 2dbb24eddf7d8e2708b8dabb07bbd341f3e59d46 Mon Sep 17 00:00:00 2001
From: Neil Cheng <Neil.Cheng@quantatw.com>
Date: Tue, 23 Jun 2026 16:03:27 +0800
Subject: [PATCH] arm64: dts: aspeed: rainiera7: Enable i2c slave timeout

Enable the I2C slave timeout property for NIC,CXL,debug card to
prevent the slave interface from hanging due to incomplete or abnormal
I2C transactions, such as those occurring during HOST DC cycle but CXL
is doing i2c transfer.

Signed-off-by: Neil Cheng <Neil.Cheng@quantatw.com>
---
 arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts b/arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts
index 373e9f2256a6..2adf739cf648 100644
--- a/arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts
+++ b/arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts
@@ -238,6 +238,7 @@ &gpio1 {
 
 &i2c0 {
 	multi-master;
+    i2c-scl-clk-low-timeout-us = <31744>;
 	mctp-controller;
 	clock-frequency = <400000>;
 	status = "okay";
@@ -659,6 +660,7 @@ rtc@6f {
 /* MCIO 4A I2C */
 &i2c8 {
 	multi-master;
+    i2c-scl-clk-low-timeout-us = <31744>;
 	mctp-controller;
 	clock-frequency = <400000>;
 	status = "okay";
@@ -722,6 +724,7 @@ eeprom@51 {
 /* PROT reserve */
 &i2c10 {
 	multi-master;
+    i2c-scl-clk-low-timeout-us = <31744>;
 	status = "okay";
 
 	ipmb@10 {
-- 
