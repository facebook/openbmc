From: Bruce Hung <bruce.jy.hung@fii-foxconn.com>
Date: Fri, 17 Jul 2026 13:46:00 +0800
Subject: [PATCH] net: mctp: usb: fix tx queue stall and related issues

Squashed backport of six upstream fixes against drivers/net/mctp/mctp-usb.c,
none of which have landed on our tree since the driver was first added
(upstream commit ad39c12ea262 / 0791c0327a6e, "net: mctp: Add MCTP USB
transport driver"). Applied here in upstream chronological order:

 1. net: mctp: start tx queue on netdev open
    upstream 126cd7852a62c6fab11a4a4cb6fa96421929ab69
    https://patch.msgid.link/20250526-dev-mctp-usb-v1-1-c7bd6cb75aa0@codeconstruct.com.au

 2. net: mctp: usb: initialise mac header in RX path
    upstream e27e34bc99413a29cafae02ad572ea3c9beba2ce
    https://patch.msgid.link/20250829-mctp-usb-mac-header-v1-1-338ad725e183@codeconstruct.com.au

 3. net: mctp: Fix tx queue stall
    upstream da2522df3fcc6f57068470cbdcd6516d9eb76b37
    https://patch.msgid.link/20251027065530.2045724-1-jinliangw@google.com

 4. net: mctp: fix device leak on probe failure
    upstream 3224990fb16a831aabc50b67c74f5d0074ce80dd
    https://patch.msgid.link/20260305104549.16110-1-johan@kernel.org

 5. net: mctp: usb: fix race between urb completion and rx_retry
    cancellation
    upstream 9c46f3ee1837f6881cb99a52ffecb2760f11dc73
    https://patch.msgid.link/20260608-dev-mctp-usb-rx-requeue-v2-1-29a3aa507609@codeconstruct.com.au

 6. net: mctp: usb: don't fail mctp_usb_rx_queue on a deferred
    submission
    upstream 6c75ee4d1d4056ceeeb53fb20def3eb89bf0c5b0
    https://patch.msgid.link/20260608-dev-mctp-usb-rx-requeue-v2-2-29a3aa507609@codeconstruct.com.au

Fix #3 is the one that matters most on this platform: our SMA0/SMA1
bridged endpoints would go unresponsive under normal polling load.
init-sma's existing SMA-reset recovery path masked this, since it
resets the SMA MCU over GPIO, forcing a USB disconnect/reprobe that
discards the wedged queue along with it. Root cause is exactly the
race fix #3 describes: mctp_usb_start_xmit() calls netif_stop_queue()
only after usb_submit_urb(), so a URB completing first runs
mctp_usb_out_complete()'s netif_wake_queue() before the queue is ever
marked stopped, and the immediately-following netif_stop_queue() then
leaves it stopped forever.

Fixes #1, #4, #5, #6 are additional fixes to the same driver found
while auditing upstream history for #3; included together since they
touch the same small number of functions and are independently correct
regardless of platform.
---
--- a/drivers/net/mctp/mctp-usb.c	2026-07-17 15:40:31.096594054 +0800
+++ b/drivers/net/mctp/mctp-usb.c	2026-07-17 17:58:23.337535118 +0800
@@ -22,7 +22,6 @@
 struct mctp_usb {
 	struct usb_device *usbdev;
 	struct usb_interface *intf;
-	bool stopped;
 
 	struct net_device *netdev;
 
@@ -32,6 +31,9 @@
 	struct urb *tx_urb;
 	struct urb *rx_urb;
 
+	/* enforces atomic access to rx_stopped and requeuing the retry work */
+	spinlock_t rx_lock;
+	bool rx_stopped;
 	struct delayed_work rx_retry_work;
 };
 
@@ -97,11 +99,13 @@
 			  skb->data, skb->len,
 			  mctp_usb_out_complete, skb);
 
+	/* Stops TX queue first to prevent race condition with URB complete */
+	netif_stop_queue(dev);
 	rc = usb_submit_urb(urb, GFP_ATOMIC);
-	if (rc)
+	if (rc) {
+		netif_wake_queue(dev);
 		goto err_drop;
-	else
-		netif_stop_queue(dev);
+	}
 
 	return NETDEV_TX_OK;
 
@@ -121,6 +125,7 @@
 
 static int mctp_usb_rx_queue(struct mctp_usb *mctp_usb, gfp_t gfp)
 {
+	unsigned long flags;
 	struct sk_buff *skb;
 	int rc;
 
@@ -146,8 +151,11 @@
 	return rc;
 
 err_retry:
-	schedule_delayed_work(&mctp_usb->rx_retry_work, RX_RETRY_DELAY);
-	return rc;
+	spin_lock_irqsave(&mctp_usb->rx_lock, flags);
+	if (!mctp_usb->rx_stopped)
+		schedule_delayed_work(&mctp_usb->rx_retry_work, RX_RETRY_DELAY);
+	spin_unlock_irqrestore(&mctp_usb->rx_lock, flags);
+	return 0;
 }
 
 static void mctp_usb_in_complete(struct urb *urb)
@@ -184,6 +192,7 @@
 		struct mctp_usb_hdr *hdr;
 		u8 pkt_len; /* length of MCTP packet, no USB header */
 
+		skb_reset_mac_header(skb);
 		hdr = skb_pull_data(skb, sizeof(*hdr));
 		if (!hdr)
 			break;
@@ -247,9 +256,6 @@
 	struct mctp_usb *mctp_usb = container_of(work, struct mctp_usb,
 						 rx_retry_work.work);
 
-	if (READ_ONCE(mctp_usb->stopped))
-		return;
-
 	mctp_usb_rx_queue(mctp_usb, GFP_KERNEL);
 }
 
@@ -257,7 +263,9 @@
 {
 	struct mctp_usb *mctp_usb = netdev_priv(dev);
 
-	WRITE_ONCE(mctp_usb->stopped, false);
+	WRITE_ONCE(mctp_usb->rx_stopped, false);
+
+	netif_start_queue(dev);
 
 	return mctp_usb_rx_queue(mctp_usb, GFP_KERNEL);
 }
@@ -265,17 +273,21 @@
 static int mctp_usb_stop(struct net_device *dev)
 {
 	struct mctp_usb *mctp_usb = netdev_priv(dev);
+	unsigned long flags;
 
 	netif_stop_queue(dev);
 
 	/* prevent RX submission retry */
-	WRITE_ONCE(mctp_usb->stopped, true);
+	spin_lock_irqsave(&mctp_usb->rx_lock, flags);
+	mctp_usb->rx_stopped = true;
+	cancel_delayed_work(&mctp_usb->rx_retry_work);
+	spin_unlock_irqrestore(&mctp_usb->rx_lock, flags);
+
+	flush_delayed_work(&mctp_usb->rx_retry_work);
 
 	usb_kill_urb(mctp_usb->rx_urb);
 	usb_kill_urb(mctp_usb->tx_urb);
 
-	cancel_delayed_work_sync(&mctp_usb->rx_retry_work);
-
 	return 0;
 }
 
@@ -325,8 +337,9 @@
 	SET_NETDEV_DEV(netdev, &intf->dev);
 	dev = netdev_priv(netdev);
 	dev->netdev = netdev;
-	dev->usbdev = usb_get_dev(interface_to_usbdev(intf));
+	dev->usbdev = interface_to_usbdev(intf);
 	dev->intf = intf;
+	spin_lock_init(&dev->rx_lock);
 	usb_set_intfdata(intf, dev);
 
 	dev->ep_in = ep_in->bEndpointAddress;
@@ -361,7 +374,6 @@
 	mctp_unregister_netdev(dev->netdev);
 	usb_free_urb(dev->tx_urb);
 	usb_free_urb(dev->rx_urb);
-	usb_put_dev(dev->usbdev);
 	free_netdev(dev->netdev);
 }
 
