diff --git a/specification/json/sections/cper-mtia.json b/specification/json/sections/cper-mtia.json
new file mode 100644
index 0000000..e3726a8
--- /dev/null
+++ b/specification/json/sections/cper-mtia.json
@@ -0,0 +1,145 @@
+{
+    "$schema": "https://json-schema.org/draft/2020-12/schema",
+    "type": "object",
+    "description": "MTIA (Meta Training and Inference Accelerator) OEM Error Section",
+    "required": ["sectionHeader", "eventRecordCommon", "eventDetailRaw"],
+    "additionalProperties": false,
+    "properties": {
+        "sectionHeader": {
+            "type": "object",
+            "description": "MTIA section header (40 bytes).",
+            "required": ["version", "recordSize"],
+            "additionalProperties": false,
+            "properties": {
+                "version": {
+                    "type": "object",
+                    "description": "Major and minor version number of the MTIA section definition.",
+                    "required": ["major", "minor"],
+                    "additionalProperties": false,
+                    "properties": {
+                        "major": {
+                            "type": "integer",
+                            "minimum": 0
+                        },
+                        "minor": {
+                            "type": "integer",
+                            "minimum": 0
+                        }
+                    }
+                },
+                "recordSize": {
+                    "type": "integer",
+                    "description": "Size of the MTIA error record in bytes.",
+                    "minimum": 0
+                },
+                "deviceId": {
+                    "type": "string",
+                    "pattern": "^[0-9a-f]{24}$",
+                    "description": "PCIe device identifier of the MTIA component. Present only when validation bit 0 is set."
+                },
+                "deviceSerial": {
+                    "type": "string",
+                    "pattern": "^[0-9a-f]{30}$",
+                    "description": "ASIC serial number. Present only when validation bit 1 is set."
+                }
+            }
+        },
+        "eventRecordCommon": {
+            "type": "object",
+            "description": "Event record common fields (32 bytes).",
+            "required": [
+                "timestamp",
+                "eventId",
+                "severity",
+                "scope",
+                "deviceId",
+                "platformId",
+                "skuId",
+                "chipletId",
+                "moduleId",
+                "flags",
+                "detailFormatId",
+                "detailLength"
+            ],
+            "additionalProperties": false,
+            "properties": {
+                "timestamp": {
+                    "type": "integer",
+                    "description": "Raw boot-relative mtimer counter value.",
+                    "minimum": 0
+                },
+                "eventId": {
+                    "type": "integer",
+                    "description": "12-bit event identifier.",
+                    "minimum": 0
+                },
+                "severity": {
+                    "type": "object",
+                    "description": "Boot1 event severity bucket.",
+                    "required": ["raw"],
+                    "additionalProperties": false,
+                    "properties": {
+                        "raw": {
+                            "type": "integer",
+                            "minimum": 0
+                        },
+                        "value": {
+                            "type": "string",
+                            "enum": ["Info", "Warning", "Recoverable", "Fatal"]
+                        }
+                    }
+                },
+                "scope": {
+                    "type": "integer",
+                    "description": "Event scope (local/module/system).",
+                    "minimum": 0
+                },
+                "deviceId": {
+                    "type": "integer",
+                    "description": "Chip identity.",
+                    "minimum": 0
+                },
+                "platformId": {
+                    "type": "integer",
+                    "description": "Platform identity.",
+                    "minimum": 0
+                },
+                "skuId": {
+                    "type": "integer",
+                    "description": "SKU identity.",
+                    "minimum": 0
+                },
+                "chipletId": {
+                    "type": "integer",
+                    "description": "Source chiplet identifier.",
+                    "minimum": 0
+                },
+                "moduleId": {
+                    "type": "integer",
+                    "description": "Module identity.",
+                    "minimum": 0
+                },
+                "flags": {
+                    "type": "string",
+                    "description": "System-defined flags.",
+                    "pattern": "^0x[0-9A-Fa-f]+$"
+                },
+                "detailFormatId": {
+                    "type": "integer",
+                    "description": "Discriminator for the eventDetailRaw schema.",
+                    "minimum": 0
+                },
+                "detailLength": {
+                    "type": "integer",
+                    "description": "Bytes valid in the payload section.",
+                    "minimum": 0
+                }
+            }
+        },
+        "eventDetailRaw": {
+            "type": "string",
+            "description": "Raw event detail bytes (48 bytes), lowercase hex.",
+            "pattern": "^[0-9a-f]{96}$"
+        }
+    }
+}
