From 713db7090fb698be72f589ee359e20de6df2c0c7 Mon Sep 17 00:00:00 2001
From: Kimi Chen <kimi.zy.chen@fii-foxconn.com>
Date: Thu, 27 Nov 2025 18:31:21 +0800
Subject: [PATCH 14/15] hwmontemp: Remove newly created sensor from
 sensorsChanged during rescan

When a sensor is recreated during rescan, the existing sensor object is
destroyed first, which calls deactivate() and sets the sensor to
unavailable. If a sensor created during a rescan is not removed from
sensorsChanged, it will still be present in sensorsChanged during the
next rescan cycle. This causes the sensor to be unnecessarily recreated
and marked unavailable, which is redundant and triggers an
InvalidSensorReading event [1].

To fix this, remove newly created sensors from sensorsChanged during
rescan, as they do not require further change processing.

[1] https://gerrit.openbmc.org/c/openbmc/dbus-sensors/+/84145

Change-Id: I021daa03e97bfb7b3fec3509f96fe14f4232324a
Signed-off-by: Kimi Chen <kimi.zy.chen@fii-foxconn.com>
---
 src/hwmon-temp/HwmonTempMain.cpp | 34 +++++++++++++++++++++-----------
 1 file changed, 22 insertions(+), 12 deletions(-)

diff --git a/src/hwmon-temp/HwmonTempMain.cpp b/src/hwmon-temp/HwmonTempMain.cpp
index 7059c84..3b1d6af 100644
--- a/src/hwmon-temp/HwmonTempMain.cpp
+++ b/src/hwmon-temp/HwmonTempMain.cpp
@@ -411,24 +411,34 @@ void createSensors(
                     std::get<std::string>(findSensorName->second);
                 // on rescans, only update sensors we were signaled by
                 auto findSensor = sensors.find(sensorName);
-                if (!firstScan && findSensor != sensors.end())
+                if (!firstScan)
                 {
-                    bool found = false;
-                    auto it = sensorsChanged->begin();
-                    while (it != sensorsChanged->end())
+                    if (findSensor != sensors.end())
                     {
-                        if (it->ends_with(findSensor->second->name))
+                        bool found = false;
+                        auto it = sensorsChanged->begin();
+                        while (it != sensorsChanged->end())
                         {
-                            it = sensorsChanged->erase(it);
-                            findSensor->second = nullptr;
-                            found = true;
-                            break;
+                            if (it->ends_with(findSensor->second->name))
+                            {
+                                it = sensorsChanged->erase(it);
+                                findSensor->second = nullptr;
+                                found = true;
+                                break;
+                            }
+                            ++it;
+                        }
+                        if (!found)
+                        {
+                            continue;
                         }
-                        ++it;
                     }
-                    if (!found)
+                    else
                     {
-                        continue;
+                        // Remove the sensor from sensorsChanged if it was
+                        // first created during a rescan, as it does not
+                        // require further change processing.
+                        sensorsChanged->erase(interfacePath);
                     }
                 }
 
