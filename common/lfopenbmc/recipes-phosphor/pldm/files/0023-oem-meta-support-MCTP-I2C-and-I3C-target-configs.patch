+std::optional<std::string> getConfigPathByTID(const pldm_tid_t& tid)
+{
+    const eid EID = mapTIDtoEID(tid);
+    const auto& configurations = configurationDiscovery->getConfigurations();
+    auto configurationIter = configurations.find(EID);
+    if (configurationIter == configurations.end())
+    {
+        return std::nullopt;
+    }
+
+    return configurationIter->second.objectPath;
+}
