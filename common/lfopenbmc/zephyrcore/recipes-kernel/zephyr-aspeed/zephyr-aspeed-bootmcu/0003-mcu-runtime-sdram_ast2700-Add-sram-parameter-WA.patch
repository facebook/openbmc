From 4558129c579d1b5b108d494d8174742d23938d93 Mon Sep 17 00:00:00 2001
From: Cool Lee <cool_lee@aspeedtech.com>
Date: Mon, 18 May 2026 17:40:58 +0800
Subject: [PATCH] mcu-runtime: sdram_ast2700: Add sram parameter WA

Followed Synposys SRAM setting.

Signed-off-by: Cool Lee <cool_lee@aspeedtech.com>
Change-Id: I073dc4fb13b4f6860d3870f13efa697eaad5522f
---
 apps/mcu-runtime/soc/ast2700/sdram_phy.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/apps/mcu-runtime/soc/ast2700/sdram_phy.c b/apps/mcu-runtime/soc/ast2700/sdram_phy.c
index a62d4e0..f3523a5 100644
--- a/apps/mcu-runtime/soc/ast2700/sdram_phy.c
+++ b/apps/mcu-runtime/soc/ast2700/sdram_phy.c
@@ -271,6 +271,13 @@ int dwc_phy_init(struct sdramc *sdramc)
 {
 	uint32_t err = -1;
 
+	sys_write32(0xabcd2700, 0x13c00000);
+	while (sys_read32(0x13c00000) != 1);
+	sys_write32(0x16c, 0x13c00050);
+	sys_write32(0x16c, 0x13c00054);
+	sys_write32(0xaaa, 0x13c00000);
+	while (sys_read32(0x13c00000) != 0);
+
 	if (is_ddr4()) {
 		LOG_DBG("%s: Starting ddr4 training\n", __func__);
 		#include "dwc_ddrphy_phyinit_ddr4-3200-nodimm-train2D.c"
-- 
2.34.1

