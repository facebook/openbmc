+static void ast2600_i3c_set_ibi_mdb(struct dw_i3c_master *dw, u8 mdb)
+{
+	u32 reg;
+
+	reg = readl(dw->regs + DEVICE_CTRL);
+	reg &= ~DEV_CTRL_SLAVE_MDB;
+	reg |= FIELD_PREP(DEV_CTRL_SLAVE_MDB, mdb);
+	writel(reg, dw->regs + DEVICE_CTRL);
+}
