         {
             "Level": "Warning",
-            "Name": "CPU_DIMM_Cold_Plate",
-            "PinName": "Channel6_leakage_CPU_DIMM",
+            "Name": "CPU_Cold_Plate",
+            "PinName": "Channel6_leakage",
             "Polarity": "High",
             "SubType": "LeakSensingCable",
             "Type": "GPIOLeakDetector"
@@ -359,7 +359,7 @@
         {
             "Level": "Warning",
             "Name": "EAM2_Cold_Plate",
-            "PinName": "Channel7_leakage_EAM2",
+            "PinName": "Channel7_leakage",
             "Polarity": "High",
             "SubType": "LeakSensingCable",
             "Type": "GPIOLeakDetector"
