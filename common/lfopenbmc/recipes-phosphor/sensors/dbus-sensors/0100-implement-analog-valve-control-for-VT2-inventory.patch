+// ═════════════════════════════════════════════════════════════════════════════
+// Internal helper: FeedbackADC
+// Polls a sysfs IIO ADC channel and converts raw counts to volts.
+// ═════════════════════════════════════════════════════════════════════════════
+
+struct AnalogValve::FeedbackADC
+{
+    using Callback_t = std::function<sdbusplus::async::task<>(double volt)>;
+
+    FeedbackADC(sdbusplus::async::context& ctx, const std::string& devicePath,
+                const std::string& channel, double gain, unsigned intervalSec,
+                Callback_t callback) :
+        ctx(ctx), devicePath(devicePath), channel(channel), gain(gain),
+        interval(intervalSec), callback(std::move(callback))
+    {}
+
+    auto start() -> sdbusplus::async::task<>
+    {
+        // Spawn background loop, then read once immediately for initial state
+        ctx.spawn(pollLoop());
+        co_await readOnce();
+        co_return;
+    }
+
+  private:
+    // Expand glob e.g. /sys/bus/i2c/devices/6-0008/iio:device*/in_voltage0_raw
+    auto resolvePath() -> std::filesystem::path
+    {
+        std::string pattern = devicePath + "/iio:device*/" + channel;
+        glob_t result{};
+
+        if (glob(pattern.c_str(), GLOB_NOSORT, nullptr, &result) != 0 ||
+            result.gl_pathc == 0)
+        {
+            globfree(&result);
+            throw std::runtime_error(
+                "Feedback ADC sysfs path not found: " + pattern);
+        }
+
+        std::filesystem::path resolved = result.gl_pathv[0];
+        globfree(&result);
+        return resolved;
+    }
+
+    auto readOnce() -> sdbusplus::async::task<>
+    {
+        try
+        {
+            auto path = resolvePath();
+            std::ifstream ifs(path);
+            if (!ifs)
+            {
+                error("Cannot open feedback ADC path {PATH}", "PATH",
+                      path.string());
+                co_return;
+            }
+
+            std::string rawStr;
+            std::getline(ifs, rawStr);
+
+            long raw = 0;
+            auto [ptr, ec] = std::from_chars(
+                rawStr.data(), rawStr.data() + rawStr.size(), raw);
+            if (ec != std::errc{})
+            {
+                error("Failed to parse feedback ADC raw value: {VAL}", "VAL",
+                      rawStr);
+                co_return;
+            }
+
+            // Linear conversion: volt = raw * gain / 1000.0
+            double volt = static_cast<double>(raw) * gain / 1000.0;
+            // debug("Feedback ADC: raw={RAW} volt={VOLT}V", "RAW", raw, "VOLT",
+            //       volt);
+
+            co_await callback(volt);
+        }
+        catch (const std::exception& e)
+        {
+            error("FeedbackADC::readOnce exception: {ERR}", "ERR", e);
+        }
+        co_return;
+    }
+
+    auto pollLoop() -> sdbusplus::async::task<>
+    {
+        while (!ctx.stop_requested())
+        {
+            co_await sdbusplus::async::sleep_for(ctx, interval);
+            co_await readOnce();
+        }
+        co_return;
+    }
+
+    sdbusplus::async::context& ctx;
+    std::string devicePath;
+    std::string channel;
+    double gain;
+    std::chrono::seconds interval;
+    Callback_t callback;
+};
+
+// ═════════════════════════════════════════════════════════════════════════════
+// Internal helper: ControlDAC
+// Converts a target voltage to a raw integer and writes it to a sysfs IIO
+// DAC channel.
+// ═════════════════════════════════════════════════════════════════════════════
+
+struct AnalogValve::ControlDAC
+{
+    ControlDAC(const std::string& devicePath, const std::string& channel,
+               double offset, double scale) :
+        devicePath(devicePath), channel(channel), offset(offset), scale(scale)
+    {}
+
+    // Returns true on success, false on any error
+    bool setVoltage(double volt)
+    {
+        try
+        {
+            // Linear conversion: raw = round((volt - offset) / scale)
+            long raw = static_cast<long>(std::round((volt - offset) / scale));
+
+            auto path = resolvePath();
+            std::ofstream ofs(path);
+            if (!ofs)
+            {
+                error("Cannot open control DAC path {PATH}", "PATH",
+                      path.string());
+                return false;
+            }
+
+            ofs << raw;
+            if (!ofs)
+            {
+                error("Failed to write raw={RAW} to DAC path {PATH}", "RAW",
+                      raw, "PATH", path.string());
+                return false;
+            }
+
+            debug("Control DAC write: volt={VOLT}V -> raw={RAW}", "VOLT", volt,
+                  "RAW", raw);
+
+            return true;
+        }
+        catch (const std::exception& e)
+        {
+            error("ControlDAC::setVoltage exception: {ERR}", "ERR", e);
+            return false;
+        }
+    }
+
+    std::optional<long> getRaw()
+    {
+        try
+        {
+            auto path = resolvePath();
+            std::ifstream ifs(path);
+            if (!ifs)
+            {
+                error("Cannot open control DAC path {PATH}", "PATH",
+                      path.string());
+                return std::nullopt;
+            }
+
+            std::string rawStr;
+            std::getline(ifs, rawStr);
+
+            long raw = 0;
+            auto [ptr, ec] = std::from_chars(
+                rawStr.data(), rawStr.data() + rawStr.size(), raw);
+            if (ec != std::errc{})
+            {
+                error("Failed to parse DAC raw value: {VAL}", "VAL", rawStr);
+                return std::nullopt;
+            }
+
+            debug("Control DAC read: raw={RAW}", "RAW", raw);
+            return raw;
+        }
+        catch (const std::exception& e)
+        {
+            error("ControlDAC::getRaw exception: {ERR}", "ERR", e);
+            return std::nullopt;
+        }
+    }
+
+  private:
+    // Expand glob e.g. /sys/bus/i2c/devices/3-000f/iio:device*/out_voltage0_raw
+    std::filesystem::path resolvePath()
+    {
+        std::string pattern = devicePath + "/iio:device*/" + channel;
+        glob_t result{};
+
+        if (glob(pattern.c_str(), GLOB_NOSORT, nullptr, &result) != 0 ||
+            result.gl_pathc == 0)
+        {
+            globfree(&result);
+            throw std::runtime_error(
+                "Control DAC sysfs path not found: " + pattern);
+        }
+
+        std::filesystem::path resolved = result.gl_pathv[0];
+        globfree(&result);
+        return resolved;
+    }
+
+    std::string devicePath;
+    std::string channel;
+    double offset;
+    double scale;
+};
+
+// ═════════════════════════════════════════════════════════════════════════════
+// AnalogValve
+// ═════════════════════════════════════════════════════════════════════════════
