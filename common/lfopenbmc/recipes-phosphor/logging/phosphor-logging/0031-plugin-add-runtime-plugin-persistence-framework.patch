+nlohmann::json deserializePlugins(const fs::path& path)
+{
+    std::ifstream is(path.c_str());
+
+    nlohmann::json j;
+    is >> j;
+
+    if (auto it = j.find("plugins"); it != j.end())
+    {
+        return *it;
+    }
+
+    return nlohmann::json::object();
+}
