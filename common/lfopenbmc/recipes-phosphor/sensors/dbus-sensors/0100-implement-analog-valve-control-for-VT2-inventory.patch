+struct AnalogValveConfig
+{
+    std::string name = Defaults::name;
+
+    // Feedback (ADC): reads actual valve LPM feedback voltage
+    std::string feedbackDevicePath = Defaults::devicePath;
+    std::string feedbackChannel = "in_voltage0_raw";
+    double feedbackGain = 2.5;       // volt = raw * gain
+    double feedbackTolerance = 0.03;
+    double openThreshold = 2.1;      // volt > openThreshold means Open
+    std::string reportCloseGpioLine; // e.g. "REPORT_SUPPLY_VALVE_CLOSE"
+
+    // Control (DAC): drives valve LPM setpoint voltage
+    std::string controlDevicePath = Defaults::devicePath;
+    std::string controlChannel = "out_voltage0_raw";
+    double controlOffset = 1.05; // raw = (volt - offset) / scale
+    double controlScale = 0.008826979;
+    double maxVolt = 10.0;       // 333 LPM
+    double minVolt = 2.0;        // 0 LPM
+    double openVolt = (180.0 / 333.0) * (maxVolt - minVolt) +
+                      minVolt;  // 180 LPM mapped to voltage (0~333 LPM → 2~10V)
+    double closeVolt = minVolt; // DAC voltage to close the valve
+
+    unsigned pollIntervalSec = 1;
+
+    struct Defaults
+    {
+        static constexpr auto name = "unknown";
+        static constexpr auto devicePath = "unknown";
+    };
+};
