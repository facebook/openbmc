+static void minerva_bmc_i2c_init(AspeedSoCState *soc)
+{
+    I2CBus *i2c[16];
+    I2CBus *fcb_channels[8];  /* PCA9548 has 8 channels */
+    DeviceState *dev;
+
+    for (int i = 0; i < 16; i++) {
+        i2c[i] = aspeed_i2c_get_bus(&soc->i2c, i);
+    }
+
+    /* I2C0: Power monitors and GPIO expander */
+    i2c_slave_create_simple(i2c[0], "ina230", 0x40);
+    i2c_slave_create_simple(i2c[0], "ina230", 0x41);
+    /* LTC4287 hotswap controller - using ADM1272 as compatible substitute */
+    i2c_slave_create_simple(i2c[0], "adm1272", 0x44);
+    /* XDP710 is defined in device tree, don't create here to avoid conflict */
+    /* i2c_slave_create_simple(i2c[0], "xdp710", 0x43); */
+    /* No PCA9555 model in QEMU; PCA9552 is used as a stand-in */
+    i2c_slave_create_simple(i2c[0], "pca9552", 0x19);
+
+    /* I2C1: Temperature sensors and EEPROM */
+    dev = DEVICE(i2c_slave_create_simple(i2c[1], TYPE_LM75, 0x4b));
+    object_property_set_int(OBJECT(dev), "temperature", 25000, &error_abort);
+
+    dev = DEVICE(i2c_slave_create_simple(i2c[1], TYPE_LM75, 0x4f));
+    object_property_set_int(OBJECT(dev), "temperature", 25000, &error_abort);
+
+    at24c_eeprom_init_rom(i2c[1], 0x54, 16 * KiB, minerva_fruid_bmc,
+                          sizeof(minerva_fruid_bmc));
+
+    /* I2C2: PCA9548 mux with 6 Fan Controller Boards (uses channels 0-5) */
+    pca954x_i2c_get_channels(i2c[2], 0x77, "pca9548", fcb_channels);
+
+    /* Each of the 6 FCBs has identical I2C devices */
+    for (int i = 0; i < 6; i++) {
+        at24c_eeprom_init_rom(fcb_channels[i], 0x50, 16 * KiB,
+                              minerva_fruid_fcb, sizeof(minerva_fruid_fcb));
+
+        /* MAX31790 fan controller with Minerva-specific channel config */
+        DeviceState *max31790_dev = qdev_new("max31790");
+        /* Channels 0-1: Tach-only mode (0x09) - unused PWM outputs */
+        qdev_prop_set_uint8(max31790_dev, "channel0-config", 0x09);
+        qdev_prop_set_uint8(max31790_dev, "channel1-config", 0x09);
+        /* Channels 2-5: PWM mode (0x08) - default, no need to set */
+        qdev_prop_set_uint8(max31790_dev, "address", 0x5e);
+        i2c_slave_realize_and_unref(I2C_SLAVE(max31790_dev), fcb_channels[i],
+                                    &error_abort);
+
+        /* INA230/INA238-compatible power monitors */
+        i2c_slave_create_simple(fcb_channels[i], "ina230", 0x40);
+        i2c_slave_create_simple(fcb_channels[i], "ina230", 0x41);
+        i2c_slave_create_simple(fcb_channels[i], "ina230", 0x44);
+        i2c_slave_create_simple(fcb_channels[i], "ina230", 0x45);
+
+        /* TMP75 temperature sensor */
+        dev = DEVICE(i2c_slave_create_simple(fcb_channels[i], TYPE_LM75, 0x4b));
+        object_property_set_int(OBJECT(dev), "temperature", 25000,
+                                &error_abort);
+    }
+
+    /* I2C9: EEPROM and RTC */
+    at24c_eeprom_init_rom(i2c[9], 0x50, 8 * KiB, minerva_fruid_chassis,
+                          sizeof(minerva_fruid_chassis));
+    i2c_slave_create_simple(i2c[9], "pcf8563", 0x51);
+
+    /* I2C14: IPMB device - not implemented */
+
+    /* I2C15: EEPROMs with FRU data */
+    at24c_eeprom_init_rom(i2c[15], 0x50, 16 * KiB, minerva_fruid_bb,
+                          sizeof(minerva_fruid_bb));
+    at24c_eeprom_init_rom(i2c[15], 0x56, 8 * KiB, minerva_fruid_bmc_storage,
+                          sizeof(minerva_fruid_bmc_storage));
+}
