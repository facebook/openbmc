#!/bin/bash

# ARGUMENTS:
# 1: firmware-upgrade service template parameter, <device_type>:<device_location>:<component>:<uuid>
#    device_location is in <position>_<device_number> format
#      On RMCv1, position = unique device address and device_number = "NA"
#      On RMCv2, position = shelf (starts with 100) and device_number = spot in shelf
#    component is the component within the device, or NA if the device has a single firmware
# The firmware image is expected at /tmp/firmware-<device_type>-<device_location>-<component>

if [ $# -ne 1 ]; then
    echo "Usage: $0 <device_type>:<device_location>:<component>:<uuid>
      device_type: device type we will be upgrading
      device_location: The location of the modbus device to upgrade in <position>_<device_number> format
      component: The sub-component in this device. Or NA if not applicable (Single firmware for device)
      uuid: Unique identifier for this upgrade request
    The firmware image is expected at /tmp/firmware-<device_type>-<device_location>-<component>"
    exit 1
fi

set -u

IFS=: read -r DEVICE_TYPE DEVICE_LOCATION COMPONENT _ <<< "$1"

if [[ ! "$DEVICE_TYPE" =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo "Invalid device type: $DEVICE_TYPE" >&2
    exit 1
fi

if [[ ! "$DEVICE_LOCATION" =~ ^[0-9]+_([0-9]+|NA)$ ]]; then
    echo "Invalid device location: $DEVICE_LOCATION" >&2
    exit 1
fi

if [[ ! "$COMPONENT" =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo "Invalid component: $COMPONENT" >&2
    exit 1
fi

if [[ "$COMPONENT" != "NA" ]]; then
    echo "Component upgrades are not supported yet" >&2
    exit 1
fi

OVERRIDE_CONFIG_FILE=/run/mnt-persist/var-data/lib/modbus-device-util/override-config.json

position="${DEVICE_LOCATION%%_*}"
device_number="${DEVICE_LOCATION#*_}"
if [[ "$device_number" == "NA" ]]; then
    UDA="$position"
else
    echo "This upgrade is not supported yet"
    exit 1
fi

CONFIG_FILE="/var/lib/modbus-device-util/default-config.json"

if [ -f "$OVERRIDE_CONFIG_FILE" ]; then
    CONFIG_FILE="$OVERRIDE_CONFIG_FILE"
fi

echo "Using $CONFIG_FILE config file"
script_dir=$( dirname "${BASH_SOURCE[0]}" )

FLOCK="flock /tmp/modbus_dynamo_solitonbeam.lock"

ERRORS=""
SUCCESSES=""
FIRMWARE_FILE="/tmp/firmware-${DEVICE_TYPE}-${DEVICE_LOCATION}-${COMPONENT}"
trap "rm ${FIRMWARE_FILE}" EXIT
UPDATE_COMMANDS=()
manufacturer=$("$script_dir/get-manufacturer" "$DEVICE_TYPE" "$UDA" "$CONFIG_FILE")

case "$manufacturer" in
        "artesyn")
            case "$DEVICE_TYPE" in
                "psu")
                    UPDATE_COMMANDS+=("$FLOCK /usr/local/bin/psu-update-aei.py --addr $UDA $FIRMWARE_FILE")
                    ;;
                *)
                    ERRORS+="${DEVICE_TYPE} at address ${UDA} has ${manufacturer} without known firmware upgrade process\n"
                    ;;
            esac
            ;;
        "coolermaster")
            case "$DEVICE_TYPE" in
                "rpu2")
                    UPDATE_COMMANDS+=("$FLOCK /usr/local/bin/rpu-update-coolermaster.py --addr $UDA $FIRMWARE_FILE")
                    ;;
                *)
                    ERRORS+="${DEVICE_TYPE} at address ${UDA} has ${manufacturer} without known firmware upgrade process\n"
                    ;;
            esac
            ;;
        "delta")
            case "$DEVICE_TYPE" in
                "bbu")
                    UPDATE_COMMANDS+=("$FLOCK /usr/local/bin/orv3-device-update-mailbox.py -vendor delta --addr $UDA $FIRMWARE_FILE")
                    ;;
                "psu")
                    UPDATE_COMMANDS+=("$FLOCK /usr/local/bin/psu-update-delta-orv3.py --addr $UDA $FIRMWARE_FILE")
                    ;;
                "rpu")
                    UPDATE_COMMANDS+=("$FLOCK /usr/local/bin/rpu-update-delta-plc.py --addr $UDA --oem-block $FIRMWARE_FILE")
                    ;;
                *)
                    ERRORS+="${DEVICE_TYPE} at address ${UDA} has ${manufacturer} without known firmware upgrade process\n"
                    ;;
            esac
            ;;
        "panasonic")
            case "$DEVICE_TYPE" in
                "bbu")
                    UPDATE_COMMANDS+=("$FLOCK /usr/local/bin/orv3-device-update-mailbox.py -vendor panasonic --addr $UDA $FIRMWARE_FILE")
                    ;;
                *)
                    ERRORS+="${DEVICE_TYPE} at address ${UDA} has ${manufacturer} without known firmware upgrade process\n"
                    ;;
            esac
            ;;
        *)
            ERRORS+="Could not identify manufacturer for ${DEVICE_TYPE} at address ${UDA}\n"
            ;;
esac

for cmd in "${UPDATE_COMMANDS[@]}"; do
    if eval "$cmd"; then
        SUCCESSES+="Successfully upgraded ${DEVICE_TYPE} with command: ${cmd}\n"
    else
        ERRORS+="Failed to upgrade ${DEVICE_TYPE} with command: ${cmd}\n"
    fi
done

if [ -z "$ERRORS" ]; then
    echo "No errors"
    echo -e "${SUCCESSES}"
    exit 0
fi

echo -e "${SUCCESSES}"
echo "FAILED TO UPGRADE DEVICE. LOOK ABOVE FOR LOGS"
echo -e "${ERRORS}"
exit 1
