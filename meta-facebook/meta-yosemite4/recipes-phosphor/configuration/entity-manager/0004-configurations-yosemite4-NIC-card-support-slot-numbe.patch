From adb294a2d403512a9cce28a3a58fca82b3e6908a Mon Sep 17 00:00:00 2001
From: IngridChen-wiwynn <Ingrid_Chen@wiwynn.com>
Date: Mon, 12 Aug 2024 11:41:09 +0800
Subject: [PATCH] configurations: yosemite4: NIC card support slot number

Support NIC card with slot number.
---
 configurations/broadcomm/200g_1p_ocp_mezz.json  | 3 +++
 configurations/meta/terminus_100g_nic_tsff.json | 3 +++
 configurations/ocp/cx7_ocp.json                 | 3 +++
 3 files changed, 9 insertions(+)

diff --git a/configurations/broadcomm/200g_1p_ocp_mezz.json b/configurations/broadcomm/200g_1p_ocp_mezz.json
index 25e6386..ea79791 100644
--- a/configurations/broadcomm/200g_1p_ocp_mezz.json
+++ b/configurations/broadcomm/200g_1p_ocp_mezz.json
@@ -41,5 +41,8 @@
         "Model": "$BOARD_PRODUCT_NAME",
         "PartNumber": "$BOARD_PART_NUMBER",
         "SerialNumber": "$BOARD_SERIAL_NUMBER"
+    },
+    "xyz.openbmc_project.Inventory.Decorator.Slot": {
+        "SlotNumber": "$bus % 24"
     }
 }
diff --git a/configurations/meta/terminus_100g_nic_tsff.json b/configurations/meta/terminus_100g_nic_tsff.json
index 261ccd6..67cf024 100644
--- a/configurations/meta/terminus_100g_nic_tsff.json
+++ b/configurations/meta/terminus_100g_nic_tsff.json
@@ -40,5 +40,8 @@
         "Model": "$BOARD_PRODUCT_NAME",
         "PartNumber": "$BOARD_PART_NUMBER",
         "SerialNumber": "$BOARD_SERIAL_NUMBER"
+    },
+    "xyz.openbmc_project.Inventory.Decorator.Slot": {
+        "SlotNumber": "$bus % 24"
     }
 }
diff --git a/configurations/ocp/cx7_ocp.json b/configurations/ocp/cx7_ocp.json
index 9403a23..ce705ae 100644
--- a/configurations/ocp/cx7_ocp.json
+++ b/configurations/ocp/cx7_ocp.json
@@ -45,5 +45,8 @@
     },
     "xyz.openbmc_project.Inventory.Decorator.AssetTag": {
         "AssetTag": "$PRODUCT_ASSET_TAG"
+    },
+    "xyz.openbmc_project.Inventory.Decorator.Slot": {
+        "SlotNumber": "$bus % 24"
     }
 }
-- 
2.53.0-Meta

