From d69a8ec4b5a263dec920fa28d1c55a4c1745d9df Mon Sep 17 00:00:00 2001
From: Cosmo Chou <cosmo.chou@quantatw.com>
Date: Mon, 16 Mar 2026 14:16:36 +0800
Subject: [PATCH] boards: ast2700_evb: bootmcu: revise baudrate config

Change uart12 baudrate from 115200 to 57600.

Signed-off-by: Cosmo Chou <cosmo.chou@quantatw.com>
---
 boards/aspeed/ast2700_evb/ast2700_evb_ast2700_bootmcu.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/boards/aspeed/ast2700_evb/ast2700_evb_ast2700_bootmcu.dts b/boards/aspeed/ast2700_evb/ast2700_evb_ast2700_bootmcu.dts
index 42d664ec..56fb17a6 100644
--- a/boards/aspeed/ast2700_evb/ast2700_evb_ast2700_bootmcu.dts
+++ b/boards/aspeed/ast2700_evb/ast2700_evb_ast2700_bootmcu.dts
@@ -217,7 +217,7 @@
 &uart12 {
 	status = "okay";
 	clock-frequency = <1846153>;
-	current-speed = <115200>;
+	current-speed = <57600>;
 };
 
 #if 0
-- 
2.53.0

