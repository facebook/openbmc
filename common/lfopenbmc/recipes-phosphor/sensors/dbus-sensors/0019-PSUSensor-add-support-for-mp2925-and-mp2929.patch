From 63de7a0f95e527865aa4fdabb2e4858ca6639b42 Mon Sep 17 00:00:00 2001
From: Kevin Tung <kevin.tung@quantatw.com>
Date: Thu, 13 Nov 2025 19:11:44 +0800
Subject: [PATCH] PSUSensor: add support for mp2925 and mp2929

Add support for the MPS MP2925 and MP2929 voltage regulator.
The corresponding driver is available in linux-staging.git [1].

[1] https://git.kernel.org/pub/scm/linux/kernel/git/groeck/linux-staging.git/commit/?h=hwmon-next&id=a79472e30be48e6693f83d298836880b56afc5a7

Change-Id: I2116acb2cacf9e66c21d22ea0cffb39e9523b6f7
Signed-off-by: Kevin Tung <kevin.wtmh@gmail.com>
---
 src/psu/PSUSensorMain.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/psu/PSUSensorMain.cpp b/src/psu/PSUSensorMain.cpp
index 1c9d128..9f89326 100644
--- a/src/psu/PSUSensorMain.cpp
+++ b/src/psu/PSUSensorMain.cpp
@@ -115,6 +115,8 @@ static const I2CDeviceTypeMap sensorTypes{
     {"MP2856", I2CDeviceType{"mp2856", true}},
     {"MP2857", I2CDeviceType{"mp2857", true}},
     {"MP2869", I2CDeviceType{"mp2869", true}},
+    {"MP2925", I2CDeviceType{"mp2925", true}},
+    {"MP2929", I2CDeviceType{"mp2929", true}},
     {"MP2971", I2CDeviceType{"mp2971", true}},
     {"MP2973", I2CDeviceType{"mp2973", true}},
     {"MP2975", I2CDeviceType{"mp2975", true}},
-- 
2.51.2

