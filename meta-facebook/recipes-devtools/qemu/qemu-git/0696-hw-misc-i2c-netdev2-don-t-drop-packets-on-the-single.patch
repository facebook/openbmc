From 38b90c27a3b6d87b01e8d203d01e7f58335e1190 Mon Sep 17 00:00:00 2001
From: Zinc Lim <zinclim@meta.com>
Date: Tue, 15 Sep 2026 11:56:57 -0700
Subject: [PATCH] hw/misc/i2c-netdev2: don't drop packets on the single receive
 slot

STOP is the only inbound packet type that is not ACK-gated, so the next
transaction's START can overwrite it before the bottom half runs.
i2c_end_transfer() is then skipped and two frames reach the target as
one transfer.

Hold the slot until the bottom half is done with it, expose that
through .can_receive, and flush once free.

Signed-off-by: Zinc Lim <zinclim@meta.com>
---
 hw/misc/i2c-netdev2.c | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/hw/misc/i2c-netdev2.c b/hw/misc/i2c-netdev2.c
index 1c7f7449cb..e380fefe1c 100644
--- a/hw/misc/i2c-netdev2.c
+++ b/hw/misc/i2c-netdev2.c
@@ -32,6 +32,12 @@ struct I2CNetdev2 {
     uint8_t rx_buf[10];
     int rx_len;
     bool rx_ack_pending;
+    /*
+     * rx_buf/rx_len is a single slot. Every inbound type is ACK-gated except
+     * STOP, so without back-pressure the next START overwrites an unprocessed
+     * STOP and i2c_end_transfer() never runs, merging two frames into one.
+     */
+    bool rx_busy;
 };
 
 static void print_bytes(const uint8_t *buf, size_t len)
@@ -50,6 +56,20 @@ static void print_bytes(const uint8_t *buf, size_t len)
 
 static ssize_t i2c_netdev2_nic_receive(NetClientState *nc, const uint8_t *buf, size_t len);
 
+static bool i2c_netdev2_can_receive(NetClientState *nc)
+{
+    I2CNetdev2 *s = I2C_NETDEV2(qemu_get_nic_opaque(nc));
+
+    return !s->rx_busy;
+}
+
+static void i2c_netdev2_rx_release(I2CNetdev2 *s)
+{
+    s->rx_len = 0;
+    s->rx_busy = false;
+    qemu_flush_queued_packets(qemu_get_queue(s->nic));
+}
+
 static void i2c_netdev2_nic_cleanup(NetClientState *nc)
 {
     I2CNetdev2 *s = I2C_NETDEV2(qemu_get_nic_opaque(nc));
@@ -60,6 +80,7 @@ static void i2c_netdev2_nic_cleanup(NetClientState *nc)
 static NetClientInfo i2c_netdev2_client_info = {
     .type = NET_CLIENT_DRIVER_NIC,
     .size = sizeof(NetClientState),
+    .can_receive = i2c_netdev2_can_receive,
     .receive = i2c_netdev2_nic_receive,
     .cleanup = i2c_netdev2_nic_cleanup,
 };
@@ -83,6 +104,7 @@ static ssize_t i2c_netdev2_nic_receive(NetClientState *nc, const uint8_t *buf, s
     assert(len <= sizeof(s->rx_buf));
     memcpy(s->rx_buf, buf, len);
     s->rx_len = len;
+    s->rx_busy = true;
 
     printf("next rx_buf: ");
     print_bytes(s->rx_buf, sizeof(s->rx_buf));
@@ -121,8 +143,9 @@ static void i2c_netdev2_slave_mode_rx(void *opaque)
     if (s->rx_ack_pending) {
         printf("%s: guest OS ack rx, clearing rx_len\n", __func__);
         s->rx_ack_pending = false;
-        s->rx_len = 0;
         qemu_send_packet(netdev, ack, sizeof(ack));
+        /* Release only once the ACK is out, or the flush can refill the slot. */
+        i2c_netdev2_rx_release(s);
         return;
     }
 
@@ -136,7 +159,7 @@ static void i2c_netdev2_slave_mode_rx(void *opaque)
             ack[0] = 0;
             i2c_bus_release(s->bus);
             qemu_send_packet(netdev, ack, sizeof(ack));
-            s->rx_len = 0;
+            i2c_netdev2_rx_release(s);
             return;
         }
         break;
@@ -146,6 +169,7 @@ static void i2c_netdev2_slave_mode_rx(void *opaque)
     case STOP_LEN:
         i2c_end_transfer(s->bus);
         i2c_bus_release(s->bus);
+        i2c_netdev2_rx_release(s);
         return;
     default:
         printf("%s: unexpected rx_len %d\n", __func__, s->rx_len);
-- 
