From 9b1c4d48e46b024444bc61380130104741cfcb37 Mon Sep 17 00:00:00 2001
From: "Frank Tsao" <Frank.Tsao@quantatw.com>
Date: Fri, 24 Jul 2026 15:12:14 +0800
Subject: [PATCH] arm64: dts: aspeed: Add i3c nodes to rainiera7 dts

Add i3c nodes to rainiera7 dts.
---
 .../aspeed/aspeed-bmc-facebook-rainiera7.dts  | 64 ++++++++++++++++++-
 1 file changed, 63 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts b/arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts
index 5580c498b..c7772eac7 100644
--- a/arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts
+++ b/arch/arm64/boot/dts/aspeed/aspeed-bmc-facebook-rainiera7.dts
@@ -36,7 +36,11 @@ aliases {
		i2c17 = &i2c5mux0ch1;
		i2c18 = &i2c5mux1ch0;
		i2c19 = &i2c5mux1ch1;
-	};
+		i3c0 = &i3c4;
+		i3c1 = &i3c5;
+		i3c2 = &i3c6;
+		i3c3 = &i3c7;
+	};

	chosen {
		stdout-path = "serial4:57600n8";
@@ -777,6 +781,64 @@ &i2c14 {
	pinctrl-0 = <&pinctrl_di2c14_default>;
 };

+&i3c4 {
+	status = "disabled";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i3c4_default>;
+
+	i3c-scl-hz = <2500000>;
+	i3c-od-scl-hi-period-ns = <380>;
+	i3c-od-scl-lo-period-ns = <620>;
+	i3c-pp-scl-hi-period-ns = <250>;
+	i3c-pp-scl-lo-period-ns = <250>;
+	sda-tx-hold-ns = <70>;
+	sda-pullup-ohms = <2000>;
+};
+
+&i3c5 {
+	status = "disabled";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i3c5_default>;
+
+	i3c-scl-hz = <2500000>;
+	i3c-od-scl-hi-period-ns = <380>;
+	i3c-od-scl-lo-period-ns = <620>;
+	i3c-pp-scl-hi-period-ns = <250>;
+	i3c-pp-scl-lo-period-ns = <250>;
+	sda-tx-hold-ns = <70>;
+	sda-pullup-ohms = <2000>;
+};
+
+&i3c6 {
+	status = "disabled";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i3c6_default>;
+
+	i3c-scl-hz = <2500000>;
+	i3c-od-scl-hi-period-ns = <380>;
+	i3c-od-scl-lo-period-ns = <620>;
+	i3c-pp-scl-hi-period-ns = <250>;
+	i3c-pp-scl-lo-period-ns = <250>;
+	sda-tx-hold-ns = <70>;
+	sda-pullup-ohms = <2000>;
+};
+
+&i3c7 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i3c7_default>;
+
+	i3c-scl-hz = <2500000>;
+	i3c-od-scl-hi-period-ns = <380>;
+	i3c-od-scl-lo-period-ns = <620>;
+	i3c-pp-scl-hi-period-ns = <250>;
+	i3c-pp-scl-lo-period-ns = <250>;
+	sda-tx-hold-ns = <70>;
+	sda-pullup-ohms = <2000>;
+
+	mctp-controller;
+};
+
 &mac0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rmii0_default>;
--
2.25.1
