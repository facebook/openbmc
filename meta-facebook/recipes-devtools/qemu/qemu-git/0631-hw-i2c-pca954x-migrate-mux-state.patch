From 4cf7f42588a3821f82c1d6b0275925384d87226a Mon Sep 17 00:00:00 2001
From: Emmanuel Blot <emmanuel.blot@free.fr>
Date: Thu, 23 Jul 2026 12:17:51 +0200
Subject: [PATCH] hw/i2c: pca954x: migrate mux state

The pca954x model had no VMStateDescription, so nothing survived
migration or snapshot/restore: neither the channel-selection control
byte nor, on the PCA9545, the per-channel interrupt status.

Add a shared vmstate covering the SMBus base, control and int_status.
The derived enabled[] array and the int_out wire are not migrated; a
post_load rebuilds the channel-enable state from control and re-drives
the INT output to match the restored status.

This breaks compatibility for the pre-existing PCA9546 and PCA9548
types, which until now emitted no section of their own. A stream
produced by this build carries a pca954x section that a QEMU without
this patch does not recognise, so loading it there fails outright.
Going the other way the older stream simply lacks the section and
nothing rejects it, but the mux resumes at its reset state with every
channel closed and no pending interrupt.

The PCA9545 is introduced by this series and has no stream history, so
it is unaffected either way.

Signed-off-by: Emmanuel Blot <emmanuel.blot@free.fr>
---
 hw/i2c/i2c_mux_pca954x.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/hw/i2c/i2c_mux_pca954x.c b/hw/i2c/i2c_mux_pca954x.c
index 81edf6a30c..7b50c7309b 100644
--- a/hw/i2c/i2c_mux_pca954x.c
+++ b/hw/i2c/i2c_mux_pca954x.c
@@ -19,6 +19,10 @@
  * - On reset the cached per-channel interrupt state is cleared; a downstream
  *   INT input that stays asserted across the reset is not re-sampled until it
  *   next toggles.
+ * - Adding migration state to parts that previously had none means a stream
+ *   from this model cannot be loaded by a QEMU predating it. In the reverse
+ *   direction the older stream simply carries no section and the mux is
+ *   restored to its reset state.
  */
 
 #include "qemu/osdep.h"
@@ -28,6 +32,7 @@
 #include "hw/core/irq.h"
 #include "hw/core/qdev.h"
 #include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
 #include "qemu/log.h"
 #include "qemu/queue.h"
 #include "qom/object.h"
@@ -285,6 +290,32 @@ static void pca954x_init(Object *obj)
     }
 }
 
+static int pca954x_post_load(void *opaque, int version_id)
+{
+    Pca954xState *s = PCA954X(opaque);
+
+    /*
+     * enabled[] is derived from control and int_out is a wire, so neither is
+     * migrated: rebuild the channel-enable state and re-drive the INT output.
+     */
+    pca954x_enable_channel(s, s->control);
+    qemu_set_irq(s->int_out, s->int_status == 0);
+    return 0;
+}
+
+static const VMStateDescription vmstate_pca954x = {
+    .name = "pca954x",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = pca954x_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SMBUS_DEVICE(parent, Pca954xState),
+        VMSTATE_UINT8(control, Pca954xState),
+        VMSTATE_UINT8(int_status, Pca954xState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
 static const Property pca954x_props[] = {
     DEFINE_PROP_STRING("name", Pca954xState, name),
 };
@@ -302,6 +333,7 @@ static void pca954x_class_init(ObjectClass *klass, const void *data)
 
     dc->desc = "Pca954x i2c-mux";
     dc->realize = pca954x_realize;
+    dc->vmsd = &vmstate_pca954x;
 
     k->write_data = pca954x_write_data;
     k->receive_byte = pca954x_read_byte;
-- 
