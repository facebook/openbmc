diff --git a/src/common.c b/src/common.c
index 70f0742..a1dde2c 100644
--- a/src/common.c
+++ b/src/common.c
@@ -126,18 +126,10 @@ int read_file(const char* filename, void** data, size_t* size) {
 	}
