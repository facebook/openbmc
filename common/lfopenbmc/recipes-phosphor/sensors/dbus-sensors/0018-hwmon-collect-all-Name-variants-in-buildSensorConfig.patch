From 89bad6f22e476deeaa55300ad08f2bad80326b7e Mon Sep 17 00:00:00 2001
From: Rick Yazwinski <rickyaz@meta.com>
Date: Fri, 27 Feb 2026 20:22:08 -0500
Subject: [PATCH 18/18] hwmon: collect all Name* variants in
 buildSensorConfigMap

Previously the function used an index loop (Name, Name1, Name2,..)
to collect sensor names.  This broke when NameHumidity and NamePressure
were introduced in recent refactoring

Replaced the indexed loop with a range-based loop over all cfg entries,
collecting any key that starts with 'Name'.  This handles all current
and future Name* variants without requiring further code changes.

Tested against bletchley hardware with humidity sensor: humidity
was missing (how we discovered the problem), and returned with patch
in place.

Fixes: 838bd71374cf ("hwmontempsensor: Add support for BME280")

Change-Id: I6be9e60e74add06ddc6c45c2b172e7f2bbafaea3
Signed-off-by: Rick Yazwinski <rickyaz@meta.com>
---
 src/hwmon-temp/HwmonTempMain.cpp | 24 +++++++-----------------
 1 file changed, 7 insertions(+), 17 deletions(-)

diff --git a/src/hwmon-temp/HwmonTempMain.cpp b/src/hwmon-temp/HwmonTempMain.cpp
index 3b1d6af..c5785ee 100644
--- a/src/hwmon-temp/HwmonTempMain.cpp
+++ b/src/hwmon-temp/HwmonTempMain.cpp
@@ -38,7 +38,6 @@
 #include <algorithm>
 #include <array>
 #include <chrono>
-#include <cstddef>
 #include <cstdint>
 #include <filesystem>
 #include <functional>
@@ -227,7 +226,6 @@ static SensorConfigMap buildSensorConfigMap(
             {
                 continue;
             }
-
             if ((std::get_if<uint64_t>(&busCfg->second) == nullptr) ||
                 (std::get_if<uint64_t>(&addrCfg->second) == nullptr))
             {
@@ -236,28 +234,20 @@ static SensorConfigMap buildSensorConfigMap(
             }
 
             std::vector<std::string> hwmonNames;
-            auto nameCfg = cfg.find("Name");
-            if (nameCfg != cfg.end())
+            for (const auto& [confKey, confValue] : cfg)
             {
-                hwmonNames.push_back(std::get<std::string>(nameCfg->second));
-                size_t i = 1;
-                while (true)
+                // Collect all "Name" and "Name<...>" variants (e.g. Name,
+                // Name1, Name2, NameHumidity).
+                if (confKey.starts_with("Name"))
                 {
-                    auto sensorNameCfg = cfg.find("Name" + std::to_string(i));
-                    if (sensorNameCfg == cfg.end())
-                    {
-                        break;
-                    }
-                    hwmonNames.push_back(
-                        std::get<std::string>(sensorNameCfg->second));
-                    i++;
+                    hwmonNames.push_back(std::get<std::string>(confValue));
                 }
             }
 
             SensorConfigKey key = {std::get<uint64_t>(busCfg->second),
                                    std::get<uint64_t>(addrCfg->second)};
-            SensorConfig val = {path.str, cfgData, intf, cfg, hwmonNames};
-
+            SensorConfig val = {path.str, cfgData, intf, cfg,
+                                std::move(hwmonNames)};
             auto [it, inserted] = configMap.emplace(key, std::move(val));
             if (!inserted)
             {
-- 
