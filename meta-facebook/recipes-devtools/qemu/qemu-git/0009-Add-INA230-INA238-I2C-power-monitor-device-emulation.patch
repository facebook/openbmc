From 6eef577cdc352140aa35e594321306c4f4fd41fd Mon Sep 17 00:00:00 2001
From: James Athappilly <jamesatha@meta.com>
Date: Fri, 26 Jun 2026 12:06:37 -0700
Subject: [PATCH 11/14] Add INA230/INA238 I2C power monitor device emulation
 for BMC platforms.

The INA230/INA238 provide voltage, current, and power monitoring over I2C.
These devices are register-compatible and share the same emulation.
Used in server power distribution for real-time power monitoring.
---
 hw/arm/Kconfig        |   1 +
 hw/sensor/Kconfig     |   4 +
 hw/sensor/ina230.c    | 330 ++++++++++++++++++++++++++++++++++++++++++
 hw/sensor/meson.build |   1 +
 4 files changed, 336 insertions(+)
 create mode 100644 hw/sensor/ina230.c

diff --git a/hw/arm/Kconfig b/hw/arm/Kconfig
index 4e50fb1111..f5d96f55f8 100644
--- a/hw/arm/Kconfig
+++ b/hw/arm/Kconfig
@@ -548,6 +548,7 @@ config ASPEED_SOC
     select TMP105
     select TMP421
     select EMC141X
