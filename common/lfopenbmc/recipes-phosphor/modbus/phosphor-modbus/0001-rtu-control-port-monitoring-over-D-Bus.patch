 BasePort::BasePort(sdbusplus::async::context& ctx, const config::Config& config,
                    const std::string& devicePath) :
+    PortControlIntf(ctx, sdbusplus::object_path(
+                             sdbusplus::common::xyz::openbmc_project::control::
