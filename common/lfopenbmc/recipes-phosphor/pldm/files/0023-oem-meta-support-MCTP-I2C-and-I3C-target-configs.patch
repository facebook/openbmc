+bool ConfigurationDiscoveryHandler::appendConfigFromAssociatedMctpTarget(
+    uint8_t targetEid, const MctpInfo& mctpInfo)
+{
+    constexpr auto mctpInfoNameIndex = 4;
+    constexpr auto mctpInfoAssociatedPathIndex = 5;
+
+    if (configurations.contains(targetEid))
+    {
+        return true;
+    }
+
+    const auto& associatedPath =
+        std::get<mctpInfoAssociatedPathIndex>(mctpInfo);
+    if (!associatedPath.has_value())
+    {
+        return false;
+    }
+
+    for (const auto& targetInterface : interfaceFilter)
+    {
+        try
+        {
+            dBusIntf->getService(associatedPath->c_str(),
+                                 targetInterface.c_str());
+        }
+        catch (const sdbusplus::exception_t&)
+        {
+            // The associated path only needs to expose one of the supported
+            // target interfaces. Missing the current candidate is expected.
+            continue;
+        }
+        catch (const std::exception& e)
+        {
+            error(
+                "{FUNC}: Failed to resolve associated MCTP target in path={PATH}, interface={INTERFACE}, error={ERROR}",
+                "FUNC", std::string(__func__), "PATH", *associatedPath,
+                "INTERFACE", targetInterface, "ERROR", e.what());
+            return false;
+        }
+
+        const auto& endpointName = std::get<mctpInfoNameIndex>(mctpInfo);
+        configurations.emplace(targetEid,
+                               MctpEndpoint{0, 0, endpointName.value_or(""),
+                                            std::nullopt, *associatedPath});
+        return true;
+    }
+
+    return false;
+}
