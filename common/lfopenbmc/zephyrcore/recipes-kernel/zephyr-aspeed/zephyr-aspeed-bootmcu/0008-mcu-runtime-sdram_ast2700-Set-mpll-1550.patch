From a19ccae62ea047b38a970552f0c953c39d122115 Mon Sep 17 00:00:00 2001
From: Cool Lee <cool_lee@aspeedtech.com>
Date: Wed, 1 Jul 2026 17:50:58 +0800
Subject: [PATCH] mcu-runtime: sdram_ast2700: Set mpll 1550

Define mpll parameter and optimize sequence

Signed-off-by: Cool Lee <cool_lee@aspeedtech.com>
Change-Id: I09f9882dce0e40786d9894c8908c851931d2b0f8
---
 apps/mcu-runtime/soc/ast2700/sdram_ast2700.c | 59 +++++++++++++++++++-
 1 file changed, 57 insertions(+), 2 deletions(-)

diff --git a/apps/mcu-runtime/soc/ast2700/sdram_ast2700.c b/apps/mcu-runtime/soc/ast2700/sdram_ast2700.c
index ea7f2ab..16e0572 100644
--- a/apps/mcu-runtime/soc/ast2700/sdram_ast2700.c
+++ b/apps/mcu-runtime/soc/ast2700/sdram_ast2700.c
@@ -1148,19 +1148,74 @@ void sdramc_reset(struct sdramc *sdramc)
 	k_busy_wait(1000);
 }
 
+#define MPLL_RESET_BIT		BIT(24)
+#define MPLL_BYPASS_BIT		BIT(25)
+#define MPLL_CLKOD_MASK		GENMASK(22, 19)
+#define MPLL_CLKNR_MASK		GENMASK(18, 13)
+#define MPLL_CLKNF_MASK		GENMASK(12, 0)
+
+#define MPLL_1550
+
+#if defined(MPLL_1600)
+#define MPLL_OD	1
+#define MPLL_NR 1
+#define MPLL_NF (549755813888ULL / 4 / 1024 / 1024 / 1024 / 2)
+#elif defined(MPLL_1625)
+#define MPLL_OD	1
+#define MPLL_NR 1
+#define MPLL_NF (558345748480ULL / 4 / 1024 / 1024 / 1024 / 2)
+#elif defined(MPLL_1590)
+#define MPLL_OD	1
+#define MPLL_NR 5
+#define MPLL_NF (2731599200256ULL / 4 / 1024 / 1024 / 1024 / 2)
+#elif defined(MPLL_1586)
+#define MPLL_OD	1
+#define MPLL_NR 17
+#define MPLL_NF (9264072658780ULL / 4 / 1024 / 1024 / 1024 / 2)
+#elif defined(MPLL_1575)
+#define MPLL_OD	1
+#define MPLL_NR 1
+#define MPLL_NF (541165879296ULL  / 4 / 1024 / 1024 / 1024 / 2)
+#elif defined(MPLL_1560)
+#define MPLL_OD	1
+#define MPLL_NR 3
+#define MPLL_NF (1608035755622ULL / 4 / 1024 / 1024 / 1024 / 2)
+#elif defined(MPLL_1560_B)
+#define MPLL_OD	1
+#define MPLL_NR 5
+#define MPLL_NF (2680059592704ULL / 4 / 1024 / 1024 / 1024 / 2)
+#elif defined(MPLL_1550)
+#define MPLL_OD	1
+#define MPLL_NR 1
+#define MPLL_NF (532575944704ULL  / 4 / 1024 / 1024 / 1024 / 2)
+#elif defined(MPLL_1500)
+#define MPLL_OD	1
+#define MPLL_NR 1
+#define MPLL_NF (515396075520ULL  / 4 / 1024 / 1024 / 1024 / 2)
+#endif
 void sdramc_pll_reset(struct sdramc *sdramc)
 {
 	uint32_t pll_para;
 
+	printf("MPLL NF = 0x%llx, NR = %d, OD = %d\n", MPLL_NF, MPLL_NR, MPLL_OD);
+
+	/* clock stop for ddrphy and mclk */
+	sys_write32(0x801, 0x12c02240);
+
 	// mpll reset sequence
 	pll_para = sys_read32(0x12c02310);
-	sys_write32(pll_para | BIT(24) | BIT(25), 0x12c02310);
-	sys_write32(pll_para | BIT(24), 0x12c02310);
+	pll_para &= ~(MPLL_CLKOD_MASK | MPLL_CLKNR_MASK | MPLL_CLKNF_MASK);
+	pll_para |= MPLL_NF | ((MPLL_NR - 1) << 13) | ((MPLL_OD - 1) << 19);
+	sys_write32(pll_para | MPLL_RESET_BIT | MPLL_BYPASS_BIT, 0x12c02310);
+	sys_write32(pll_para | MPLL_RESET_BIT, 0x12c02310);
 	sys_write32(pll_para, 0x12c02310);
 
 	// wait for mpll lock
 	while (!(sys_read32(0x12c02314) & BIT(31)))
 		;
+
+	/* clock start for ddrphy and mclk */
+	sys_write32(0x801, 0x12c02244);
 }
 
 void sdramc_preset(struct sdramc *sdramc)
-- 
2.34.1

