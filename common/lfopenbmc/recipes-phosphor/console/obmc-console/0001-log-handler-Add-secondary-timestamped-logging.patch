-	}
-	pos = lseek(lh->fd, 0, SEEK_END);
-	if (pos < 0) {
-		warn("Can't query log position for file %s", lh->log_filename);
-		close(lh->fd);
-		return -1;
-	}
-	lh->size = pos;
-	if ((size_t)pos >= lh->maxsize) {
-		return log_trim(lh);
-	}
-
