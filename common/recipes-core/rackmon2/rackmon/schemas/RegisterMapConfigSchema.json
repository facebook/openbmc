{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regmap",
  "title": "Rackmon Register Map Configuration",
  "description": "Schema to test the Register Map JSON configuration",
  "type": "object",
  "required": ["name", "address_range", "probe", "baudrate", "registers"],
  "additionalProperties": false,
  
  "properties": {
    "name": {
      "type": "string"
    },
    "address_range": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "probe": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["register"],
        "properties": {
          "register": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "value": {
            "type": "array",
            "minItems": 1,
            "maxItems": 65535,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      }
    },
    "time_sync": {
      "type": "object",
      "required": ["address"],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "interval": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "baudrate": {
      "type": "integer",
      "minimum": 19200,
      "maximum": 115200
    },
    "max_span_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "parity": {
      "type": "string",
      "enum": ["EVEN", "ODD", "NONE"]
    },
    "registers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {
        "$ref": "registermap/register.json#/definitions"
      }
    }
  }
}
