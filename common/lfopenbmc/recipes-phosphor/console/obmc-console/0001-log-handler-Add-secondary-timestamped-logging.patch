 }
 
@@ -96,7 +83,6 @@ static int log_data(struct log_handler *lh, uint8_t *buf, size_t len)
 	}
 
 	lh->size += len;
-
 	return 0;
 }
 
@@ -108,8 +94,6 @@ static enum ringbuffer_poll_ret log_ringbuffer_poll(void *arg, size_t force_len
 	size_t len;
 	int rc;
 
-	/* we log synchronously, so just dequeue everything we can, and
-	 * commit straight away. */
 	for (;;) {
 		len = ringbuffer_dequeue_peek(lh->rbc, 0, &buf);
 		if (!len) {
@@ -127,29 +111,6 @@ static enum ringbuffer_poll_ret log_ringbuffer_poll(void *arg, size_t force_len
 	return RINGBUFFER_POLL_OK;
 }
 
-static int log_create(struct log_handler *lh)
-{
-	off_t pos;
-
-	lh->fd = open(lh->log_filename, O_WRONLY | O_CREAT | O_APPEND, 0644);
