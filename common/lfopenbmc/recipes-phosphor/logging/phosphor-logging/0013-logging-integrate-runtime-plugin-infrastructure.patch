From d489df2baa18f0f462a98e0ec2bb8b2a5ecb8bef Mon Sep 17 00:00:00 2001
From: Jayanth Othayoth <ojayanth@gmail.com>
Date: Sun, 2 Aug 2026 10:29:57 -0500
Subject: [PATCH] logging: integrate runtime plugin infrastructure

Integrate the plugin framework into the logging infrastructure.

Extend log entries to own runtime plugin instances associated with
the entry. Plugins remain active for the lifetime of the owning entry,
establishing plugin lifetime management through the existing entry
lifecycle.

This change establishes the runtime plugin ownership model used by
future plugin request handling and log entry processing support.

No producer-facing plugin APIs are introduced by this change and no
functional behavior changes are intended.

Change-Id: Ia98e29f229d7b9f1ff0683b46eaef3a87e28dd48
Signed-off-by: Jayanth Othayoth <ojayanth@gmail.com>
---
 elog_entry.hpp | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/elog_entry.hpp b/elog_entry.hpp
index 8710e13..8f4d6be 100644
--- a/elog_entry.hpp
+++ b/elog_entry.hpp
@@ -2,6 +2,7 @@
 
 #include "config.h"
 
+#include "plugin/plugin.hpp"
 #include "xyz/openbmc_project/Logging/Entry/server.hpp"
 #include "xyz/openbmc_project/Object/Delete/server.hpp"
 #include "xyz/openbmc_project/Software/Version/server.hpp"
@@ -62,14 +63,17 @@ class Entry : public EntryIfaces
      *  @param[in] fwVersion - The BMC code version.
      *  @param[in] filePath - Serialization path
      *  @param[in] parent - The error's parent.
