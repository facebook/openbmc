From 9eeb6ce439da9c4ad8c2d31050bacb79cd6cc601 Mon Sep 17 00:00:00 2001
From: KayYCHuang-wiwynn <kay.yc.huang.wiwynn@gmail.com>
Date: Mon, 17 Mar 2025 02:25:46 +0000
Subject: [PATCH 15/17] meta-facebook: yosemite4: Disable in2_alarm event

---
 meson.build               | 4 ++++
 meson.options             | 6 ++++++
 src/psu/PSUSensorMain.cpp | 2 ++
 3 files changed, 12 insertions(+)

diff --git a/meson.build b/meson.build
index c7f6996..1b30ce6 100644
--- a/meson.build
+++ b/meson.build
@@ -31,6 +31,10 @@ add_project_arguments(
     language: 'cpp',
 )
 
+if get_option('disable-in2-alarm-event')
+    add_project_arguments('-DDISABLE_IN2_ALARM_EVENT', language : 'cpp')
+endif
+
 threads = dependency('threads')
 # i2c-tools doesn't ship a pkg-config file for libi2c
 i2c = meson.get_compiler('cpp').find_library('i2c')
diff --git a/meson.options b/meson.options
index c8a8d34..b87ed5f 100644
--- a/meson.options
+++ b/meson.options
@@ -107,3 +107,9 @@ option(
     value: 'enabled',
     description: 'Enable Cable monitor.',
 )
+option(
+    'disable-in2-alarm-event',
+    type: 'boolean',
+    value: 'false',
+    description: 'Disable in2_alarm event.',
+)
diff --git a/src/psu/PSUSensorMain.cpp b/src/psu/PSUSensorMain.cpp
index eebded6..c08b6c3 100644
--- a/src/psu/PSUSensorMain.cpp
+++ b/src/psu/PSUSensorMain.cpp
@@ -240,7 +240,9 @@ static constexpr std::array<PSUProperty, 22> labelMatch{{
 }};
 
 const static EventPathList eventMatch{{"PredictiveFailure", {"power1_alarm"}},
+#ifndef DISABLE_IN2_ALARM_EVENT
                                       {"Failure", {"in2_alarm"}},
+#endif
                                       {"ACLost", {"in1_beep"}},
                                       {"ConfigureError", {"in1_fault"}}};
 const static EventPathList limitEventMatch{
-- 
