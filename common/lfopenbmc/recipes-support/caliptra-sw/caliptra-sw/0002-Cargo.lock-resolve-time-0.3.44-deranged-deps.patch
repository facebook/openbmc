From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Amithash Prasad <amithash@meta.com>
Date: Sun, 15 Jun 2026 00:00:00 +0000
Subject: [PATCH] Cargo.lock: resolve time 0.3.44 dependency graph

The workspace pins `time = "=0.3.44"` (root Cargo.toml), but the
committed Cargo.lock was never re-resolved after that bump: it still
carried `deranged 0.3.7`, `time-core 0.1.2` and `time-macros 0.2.15`
left over from an older `time`. time 0.3.44 actually requires
`deranged = "0.5.2"`, `time-core = "=0.1.6"` and `time-macros = "=0.2.24"`,
and also pulls in `num-conv` and `powerfmt` directly. An online cargo
would silently re-resolve and fetch these, but the offline/--frozen
BitBake build cannot, and fails with:

  error: failed to select a version for the requirement `deranged = "^0.5.2"`
  candidate versions found which didn't match: 0.3.11, 0.3.9, 0.3.7
  required by package `time v0.3.44`

Re-resolve the time subtree to a consistent set:
  deranged   0.3.7  -> 0.5.8  (adds powerfmt dep)
  time-core  0.1.2  -> 0.1.6
  time-macros 0.2.15 -> 0.2.24 (adds num-conv dep)
  + num-conv 0.1.0, powerfmt 0.2.0 (new, also direct deps of time)

The matching crate tarballs are added in caliptra-sw-crates.inc.

Upstream-Status: Pending
Signed-off-by: Amithash Prasad <amithash@meta.com>
---
 Cargo.lock | 30 +++++++++++++++++++++++++-----
 1 file changed, 25 insertions(+), 5 deletions(-)

--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1282,9 +1282,12 @@
 
 [[package]]
 name = "deranged"
-version = "0.3.7"
+version = "0.5.8"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "7684a49fb1af197853ef7b2ee694bc1f5b4179556f1e5710e1760c5db6f5e929"
+checksum = "7cd812cc2bc1d69d4764bd80df88b4317eaef9e773c75226407d9bc0876b211c"
+dependencies = [
+ "powerfmt",
+]
 
 [[package]]
 name = "derive_arbitrary"
@@ -1843,6 +1846,12 @@
 ]
 
 [[package]]
+name = "num-conv"
+version = "0.1.0"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "51d515d32fb182ee37cda2ccdcb92950d6a3c2893aa280e540671c2cd0f3b1d9"
+
+[[package]]
 name = "num-integer"
 version = "0.1.45"
 source = "registry+https://github.com/rust-lang/crates.io-index"
@@ -2018,6 +2027,12 @@
 ]
 
 [[package]]
+name = "powerfmt"
+version = "0.2.0"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "439ee305def115ba05938db6eb1644ff94165c5ab5e9420d1c1bcedbba909391"
+
+[[package]]
 name = "ppv-lite86"
 version = "0.2.17"
 source = "registry+https://github.com/rust-lang/crates.io-index"
@@ -2468,6 +2483,8 @@
 dependencies = [
  "deranged",
  "itoa",
+ "num-conv",
+ "powerfmt",
  "serde",
  "time-core",
  "time-macros",
@@ -2475,16 +2492,17 @@
 
 [[package]]
 name = "time-core"
-version = "0.1.2"
+version = "0.1.6"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "ef927ca75afb808a4d64dd374f00a2adf8d0fcff8e7b184af886c3c87ec4a3f3"
+checksum = "40868e7c1d2f0b8d73e4a8c7f0ff63af4f6d19be117e90bd73eb1d62cf831c6b"
 
 [[package]]
 name = "time-macros"
-version = "0.2.15"
+version = "0.2.24"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "4ad70d68dba9e1f8aceda7aa6711965dfec1cac869f311a51bd08b3a2ccbce20"
+checksum = "30cfb0125f12d9c277f35663a0a33f8c30190f4e4574868a330595412d34ebf3"
 dependencies = [
+ "num-conv",
  "time-core",
 ]
 

