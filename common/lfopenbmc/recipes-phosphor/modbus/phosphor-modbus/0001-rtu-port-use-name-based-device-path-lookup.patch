From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jagpal Singh Gill <paligill@gmail.com>
Date: Sun, 4 May 2026 00:00:00 +0000
Subject: [PATCH] rtu: port: use name-based device path lookup

Replace regex-based hardware config lookup in getDevicePath
with a simple name-based /dev/<name> check. This works with
udev symlinks (e.g., /dev/ttyRS485-5 -> ttyUSB5) since
fs::exists() follows symlinks.

Signed-off-by: Jagpal Singh Gill <paligill@gmail.com>
---
 rtu/port/usb_port.cpp | 27 ++++-----------------------
 1 file changed, 4 insertions(+), 23 deletions(-)

diff --git a/rtu/port/usb_port.cpp b/rtu/port/usb_port.cpp
index 13c500a..fca5370 100644
--- a/rtu/port/usb_port.cpp
+++ b/rtu/port/usb_port.cpp
@@ -35,31 +35,18 @@ struct USBPortConfig : public PortFactoryConfig

 } // namespace config

-static auto getDevicePath(const config::PortFactoryConfig& inConfig)
+static auto getDevicePath(const config::PortFactoryConfig& config)
     -> std::string
 {
     namespace fs = std::filesystem;
-    auto config = static_cast<const config::USBPortConfig&>(inConfig);

-    std::regex pattern(
-        std::format("platform-{}\\.usb-usb.*{}-port{}", config.address,
-                    config.interface, config.port));
-    fs::path searchDir = "/dev/serial/by-path/";
-
-    for (const auto& entry : fs::recursive_directory_iterator(searchDir))
+    auto path = fs::path("/dev") / config.name;
+    if (fs::exists(path))
     {
-        if (entry.is_symlink())
-        {
-            auto filePath = entry.path();
-            if (std::regex_search(filePath.filename().string(), pattern))
-            {
-                return ("/dev/" +
-                        fs::read_symlink(filePath).filename().string());
-            }
-        }
+        return path.string();
     }

-    throw std::runtime_error("Failed to get device path");
+    throw std::runtime_error("Failed to get device path: " + path.string());
 }

 USBPort::USBPort(sdbusplus::async::context& ctx,
