From 5c77aae76882d63a2b9abd804275975c13709817 Mon Sep 17 00:00:00 2001
From: Yang Chen <yang.chen@quantatw.com>
Date: Fri, 22 Aug 2025 17:26:59 +0800
Subject: [PATCH] ARM: dts: aspeed: Ventura: Enable i2c slave timeout

Enable the I2C slave timeout property in the Harma device tree to
prevent the slave interface from hanging due to incomplete or abnormal
I2C transactions, such as those occurring during MMC reboot.
---
 arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-ventura.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-ventura.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-ventura.dts
index 72076cf2f635..ecf1420f2bd5 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-ventura.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-ventura.dts
@@ -1394,7 +1394,7 @@ &i2c7 {
 	status = "okay";
 	bus-frequency = <100000>;
 	multi-master;
-	aspeed,hw-timeout-ms = <1000>;
+	i2c-scl-clk-low-timeout-us = <31744>;
 
 	//USB Debug Connector
 	ipmb@10 {
-- 
2.53.0-Meta

