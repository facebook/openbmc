+TEST(GetChassisSensorNode, SensorUri)
+{
+    boost::container::flat_set<std::pair<std::string, std::string>> sensors;
+    boost::container::flat_set<PortMetricsNode> ports;
+    std::vector<std::string> uris = {
+        "/redfish/v1/Chassis/MB/Sensors/temperature_MB_INLET_TEMP_C"};
+
+    EXPECT_EQ(getChassisSensorNode(uris, sensors, ports), std::nullopt);
+    EXPECT_THAT(sensors, ElementsAre(std::make_pair("MB", "Sensors")));
+    EXPECT_THAT(ports, IsEmpty());
+}
+
+TEST(GetChassisSensorNode, PortMetricsUri)
+{
+    boost::container::flat_set<std::pair<std::string, std::string>> sensors;
+    boost::container::flat_set<PortMetricsNode> ports;
+    std::vector<std::string> uris = {
+        "/redfish/v1/Chassis/MB/NetworkAdapters/NIC3/Ports/0/Metrics#/RXBytes",
+        "/redfish/v1/Chassis/MB/NetworkAdapters/NIC3/Ports/0/Metrics#/Networking/RXFCSErrors",
+        "/redfish/v1/Chassis/MB/NetworkAdapters/NIC3/Ports/1/Metrics#/TXBytes"};
+
+    EXPECT_EQ(getChassisSensorNode(uris, sensors, ports), std::nullopt);
+    EXPECT_THAT(sensors, IsEmpty());
+    EXPECT_THAT(ports, ElementsAre(PortMetricsNode{"MB", "NIC3", "0"},
+                                   PortMetricsNode{"MB", "NIC3", "1"}));
+}
+
+TEST(GetChassisSensorNode, IncorrectUri)
+{
+    boost::container::flat_set<std::pair<std::string, std::string>> sensors;
+    boost::container::flat_set<PortMetricsNode> ports;
+    std::vector<std::string> uris = {
+        "/redfish/v1/Chassis/MB/Sensors/temperature_MB_INLET_TEMP_C",
+        "/redfish/v1/Chassis/MB/NetworkAdapters/NIC3/Ports/0#/RXBytes"};
+
+    std::optional<IncorrectMetricUri> error =
+        getChassisSensorNode(uris, sensors, ports);
+    ASSERT_TRUE(error);
+    EXPECT_EQ(error->uri, uris[1]);
+    EXPECT_EQ(error->index, 1U);
+}
