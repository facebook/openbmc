+static struct i2c_driver ri_host_driver = {
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = ri_host_of_match,
+	},
+	.id_table = ri_host_id,
+	.probe = ri_host_probe,
+	.remove = ri_host_remove,
