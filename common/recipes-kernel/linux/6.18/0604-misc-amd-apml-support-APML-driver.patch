diff --git a/drivers/misc/amd-apml/Kconfig b/drivers/misc/amd-apml/Kconfig
new file mode 100644
index 000000000..94a245f6a
--- /dev/null
+++ b/drivers/misc/amd-apml/Kconfig
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# AMD APML BMC interface drivers
+#
+
+config APML_COMMON
+	tristate
+	help
+	  Common device registration framework shared by the AMD APML
+	  (Advanced Platform Management Link) SB-RMI, SB-TSI and Alert_L
+	  drivers. It maintains a registry of probed APML endpoints so that
+	  the Alert_L driver can dispatch RAS and thermal alerts to them.
+	  It is selected automatically by the drivers that need it.
+
+config APML_SBRMI
+	tristate "Emulated SB-RMI interface driver over i2c or i3c bus"
+	depends on I2C || I3C
+	select APML_COMMON
+	select REGMAP_I3C if I3C
+	select REGMAP_I2C if I2C
+	help
+	  If you say yes here you get support for emulated RMI
+	  interface on AMD SoCs with APML interface connected to a BMC device.
+
+	  This driver can also be built as a module. If so, the module will
+	  be called apml_sbrmi.
+
+config APML_SBTSI
+	tristate "Emulated SB-TSI interface driver over i2c or i3c bus"
+	depends on I2C || I3C
+	select APML_COMMON
+	select REGMAP_I3C if I3C
+	select REGMAP_I2C if I2C
+	help
+	  If you say yes here you get support for emulated TSI
+	  interface on AMD SoCs with APML interface connected to a BMC device.
+
+	  This driver can also be built as a module. If so, the module will
+	  be called apml_sbtsi.
+
+config APML_ALERTL
+	tristate "AMD APML Alert_L interface driver"
+	depends on APML_SBRMI || APML_SBTSI
+	select APML_COMMON
+	help
+	  This driver provides support for the AMD APML Alert_L interface,
+	  enabling alert notification from AMD SoCs to a BMC (Baseboard
+	  Management Controller) over the I2C/I3C bus.
+
+	  The driver monitors RAS and thermal events by handling alerts
+	  from SBRMI and SBTSI devices, and reports these events to userspace
+	  via uevents. Device configuration is managed via device tree bindings.
+
+	  This driver can also be built as a module. If so, the module will
+	  be called apml_alertl.
