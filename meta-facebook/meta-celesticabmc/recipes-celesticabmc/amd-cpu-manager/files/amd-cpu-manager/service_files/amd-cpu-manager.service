[Unit]
Description=AMD CPU Manager Daemon
Wants=xyz.openbmc_project.State.Host@0.service
Wants=come_identify.service
After=xyz.openbmc_project.State.Host@0.service
After=come_identify.service
ConditionPathExists=/dev/sbtsi-4c

[Service]
Type=simple
ExecStart=/usr/bin/amd-cpu-manager
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
