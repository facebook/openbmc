+/* BIOS Flash */
+&spi0 {
+	status = "okay";
+	pinctrl-0 = <&pinctrl_spi0_default>;
+	pinctrl-names = "default";
+
+	flash@0 {
+		status = "okay";
+		m25p,fast-read;
+		label = "pnor";
+		spi-max-frequency = <12000000>;
+		spi-tx-bus-width = <2>;
+		spi-rx-bus-width = <2>;
+	};
+};
+
+&udma {
+	status = "okay";
+};
+
+/* Host Console */
+&uart0 {
+	status = "okay";
+};
+
+&uart1 {
+	status = "okay";
+	/delete-property/ pinctrl-0;
+};
+
+&uart9 {
+	compatible = "aspeed,ast2700-uart";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart9_default>;
+	status = "okay";
+	dmas = <&udma 16>, <&udma 17>;
+	dma-names = "tx", "rx";
+};
+
+&uart10 {
+	compatible = "aspeed,ast2700-uart";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart10_default>;
+	status = "okay";
+	dmas = <&udma 18>, <&udma 19>;
+	dma-names = "tx", "rx";
+};
+
+&uart12 {
+	status = "okay";
+};
+
+&lpc0_uart_routing {
+	status = "okay";
+};
