From 8b4a59137065a1f808f6fd09583e023f4f497a53 Mon Sep 17 00:00:00 2001
From: Sora Su <sora_su@wiwynn.com>
Date: Fri, 13 Mar 2026 13:02:16 +0800
Subject: [PATCH] oem-meta: Add retry event deduplication for unified BIOS
 events

Refactor event handler signatures from raw pointers to std::span
(eventMsg) for safer bounds-checked access.

Add timestamp-based deduplication in handleUnifiedBIOSEvent to
skip retry events already processed, keyed by TID and event type.

Also fix an inverted return-value check in handleOemEvent and
replace bare 0 returns with PLDM_SUCCESS for clarity.

[YV4T1M-2254] Reconstruct the BIC timestamp with a proper non-overlapping
shift (the previous <<12/<<8/<<4 was lossy and collided), include the event
sub-type byte in the dedup key, and only treat a match as a retry within a
short window -- so a genuine event is no longer dropped as a false retry.

Change-Id: I957cc6375443e40ab586c4e654468a5a1f7107e2
Signed-off-by: Sora Su <sora_su@wiwynn.com>
---
 oem/meta/event/oem_event_manager.cpp | 82 ++++++++++++++++++++++++----
 oem/meta/event/oem_event_manager.hpp | 19 +++++--
 2 files changed, 85 insertions(+), 16 deletions(-)

diff --git a/oem/meta/event/oem_event_manager.cpp b/oem/meta/event/oem_event_manager.cpp
index 2b311fa..f1e9633 100644
--- a/oem/meta/event/oem_event_manager.cpp
+++ b/oem/meta/event/oem_event_manager.cpp
@@ -6,35 +6,54 @@
 #include <phosphor-logging/lg2.hpp>
 #include <xyz/openbmc_project/Inventory/Decorator/Slot/client.hpp>
 
+#include <chrono>
 #include <cstdint>
 #include <iostream>
 #include <sstream>
+#include <tuple>
 
 namespace pldm
 {
 namespace oem_meta
 {
 
+// YV4T1M-2254: key includes the event sub-type byte (eventData[7]) so that
+// cert / HTTP-boot-fail / PXE-boot-fail (all GeneralInfo POST 0x28) do not
+// share one dedup key; the value carries the BIC timestamp plus the
+// steady-clock time it was seen, so a match only counts as a retry within a
+// short window (BIC resends are seconds apart; loops are minutes apart).
+std::map<std::tuple<pldm_tid_t, uint8_t, uint8_t>,
+         std::pair<uint32_t, std::chrono::steady_clock::time_point>>
+    receivedEventMsgTimeStamp;
+
 int OemEventManager::processOemMetaEvent(
     pldm_tid_t tid, const uint8_t* eventData, size_t eventDataSize) const
 {
+    auto data = std::span(eventData, eventDataSize);
+
     RecordType recordType = static_cast<RecordType>(eventData[0]);
     std::string errorLog;
     switch (recordType)
     {
         case RecordType::SYSTEM_EVENT_RECORD:
         {
-            handleSystemEvent(eventData, errorLog);
+            handleSystemEvent(data, errorLog);
             break;
         }
         case RecordType::UNIFIED_BIOS_SEL:
         {
-            handleUnifiedBIOSEvent(eventData, errorLog);
+            // PLDM_SUCCESS is returned for retry events that have already been
+            // handled.
+            if (handleUnifiedBIOSEvent(tid, data, errorLog) == PLDM_SUCCESS)
+            {
+                return PLDM_SUCCESS;
+            }
             break;
         }
         default:
         {
-            return PLDM_ERROR;
+            lg2::info("oem platform event: unsupported event type");
+            return PLDM_SUCCESS;
         }
     }
 
@@ -60,7 +79,7 @@ int OemEventManager::processOemMetaEvent(
                                             "RAW_EVENT", rawLog));
     }
 
-    return 0;
+    return PLDM_SUCCESS;
 }
 
 int OemEventManager::handleOemEvent(
@@ -75,7 +94,7 @@ int OemEventManager::handleOemEvent(
         lg2::error("Receive OEM Meta event from not Meta specific device");
         return PLDM_ERROR;
     }
-    if (!processOemMetaEvent(tid, eventData, eventDataSize))
+    if (processOemMetaEvent(tid, eventData, eventDataSize))
     {
         return PLDM_ERROR;
     }
@@ -83,7 +102,7 @@ int OemEventManager::handleOemEvent(
     return PLDM_SUCCESS;
 }
 
-void OemEventManager::handleSystemEvent(const uint8_t* eventData,
+void OemEventManager::handleSystemEvent(const eventMsg& eventData,
                                         std::string& errorLog) const
 {
     errorLog = "Standard (0x02), ";
@@ -234,9 +253,51 @@ void OemEventManager::handleSystemEvent(const uint8_t* eventData,
     }
 }
 
-void OemEventManager::handleUnifiedBIOSEvent(const uint8_t* eventData,
-                                             std::string& errorLog) const
+int OemEventManager::handleUnifiedBIOSEvent(
+    pldm_tid_t tid, const eventMsg& eventData, std::string& errorLog) const
 {
+    if (eventData.size() == eventMsgLengthWithTimestamp)
+    {
+        // Check whether the event is a retry event based on the timestamp
+        // recorded by the BIC. This works as long as each event type is sent by
+        // only one thread on the BIC, i.e., no race condition occurs for the
+        // same event type.
+        // YV4T1M-2254: reconstruct the 4-byte BIC timestamp with a proper,
+        // non-overlapping shift. The previous (<<12/<<8/<<4) overlapped nibbles
+        // and was lossy, so distinct events collided on one value and a genuine
+        // event was dropped as a false "retry".
+        uint32_t eventTimeStamp =
+            (static_cast<uint32_t>(eventData[16]) << 24) |
+            (static_cast<uint32_t>(eventData[17]) << 16) |
+            (static_cast<uint32_t>(eventData[18]) << 8) |
+            static_cast<uint32_t>(eventData[19]);
+        auto eventKey = std::make_tuple(
+            tid, static_cast<uint8_t>(0xF & eventData[1]), eventData[7]);
+        auto now = std::chrono::steady_clock::now();
+        constexpr auto retryWindow = std::chrono::seconds(10);
+        lg2::info(
+            "oem event msg: detected retry event, type {TYPE}, timestamp {TIMEST}",
+            "TYPE", 0xF & eventData[1], "TIMEST", eventTimeStamp);
+        auto prev = receivedEventMsgTimeStamp.find(eventKey);
+        if (prev != receivedEventMsgTimeStamp.end() &&
+            prev->second.first == eventTimeStamp &&
+            (now - prev->second.second) < retryWindow)
+        {
+            lg2::info(
+                "oem platform event: skip retry event, TID {TID}, event type {EVTT}, event time stamp {TIMEST}",
+                "TID", tid, "EVTT", 0xF & eventData[1], "TIMEST",
+                eventTimeStamp);
+            return PLDM_SUCCESS;
+        }
+        receivedEventMsgTimeStamp[eventKey] = {eventTimeStamp, now};
+    }
+    else
+    {
+        lg2::info(
+            "oem platform event: not handle retry event, event type {EVTT}, event len {LEN}",
+            "EVTT", 0xF & eventData[1], "LEN", eventData.size());
+    }
+
     errorLog = "Facebook Unified SEL (0xFB), ";
 
     DimmInfo dimmInfo = {
@@ -566,10 +627,11 @@ void OemEventManager::handleUnifiedBIOSEvent(const uint8_t* eventData,
             break;
         }
     }
+    return -1;
 }
 
 void OemEventManager::handleMemoryError(
-    const uint8_t* eventData, std::string& errorLog, const DimmInfo& dimmInfo,
+    const eventMsg& eventData, std::string& errorLog, const DimmInfo& dimmInfo,
     uint8_t generalInfo) const
 {
     std::string dimmLocation, dimm;
@@ -618,7 +680,7 @@ void OemEventManager::handleMemoryError(
 }
 
 void OemEventManager::handleSystemPostEvent(
-    const uint8_t* eventData, std::string& errorLog, uint8_t generalInfo) const
+    const eventMsg& eventData, std::string& errorLog, uint8_t generalInfo) const
 {
     uint8_t certEventIdx = (eventData[10] < certEvent.size())
                                ? eventData[10]
