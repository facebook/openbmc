diff --git a/tests/src/test_sensor.cpp b/tests/src/test_sensor.cpp
index 3a3bcc9..f9e6aef 100644
--- a/tests/src/test_sensor.cpp
+++ b/tests/src/test_sensor.cpp
@@ -7,6 +7,7 @@
 #include "utils/clock.hpp"
 
 #include <sdbusplus/asio/property.hpp>
+#include <xyz/openbmc_project/Metric/Value/common.hpp>
 
 #include <thread>
 
@@ -220,3 +221,58 @@ TEST_F(TestSensorNotification,
     sensorObject = makeSensorObject();
     DbusEnvironment::waitForFuture("notify-create");
 }
+
+class TestMetricSensor : public Test
+{
+  public:
+    void TearDown() override
+    {
+        DbusEnvironment::synchronizeIoc();
+    }
+
+    static constexpr const char* metricPath =
+        "/xyz/openbmc_project/metric/port_0/nic/rx_bytes";
+
+    std::unique_ptr<stubs::DbusSensorObject> metricObject =
+        std::make_unique<stubs::DbusSensorObject>(
+            DbusEnvironment::getIoc(), DbusEnvironment::getBus(),
+            DbusEnvironment::getObjServer(), metricPath,
+            sdbusplus::common::xyz::openbmc_project::metric::Value::interface);
+
+    SensorCache sensorCache;
+    Milliseconds timestamp = Clock().steadyTimestamp();
+    std::shared_ptr<Sensor> sut = sensorCache.makeSensor<Sensor>(
+        DbusEnvironment::serviceName(), metricPath, "metadata",
+        DbusEnvironment::getIoc(), DbusEnvironment::getBus());
+    std::shared_ptr<SensorListenerMock> listenerMock =
+        std::make_shared<StrictMock<SensorListenerMock>>();
+};
+
+TEST_F(TestMetricSensor, readsMetricValueAfterRegister)
+{
+    metricObject->setValue(1234.);
+
+    EXPECT_CALL(*listenerMock, sensorUpdated(Ref(*sut), Ge(timestamp), 1234.))
+        .WillOnce(InvokeWithoutArgs(DbusEnvironment::setPromise("async_read")));
+
+    sut->registerForUpdates(listenerMock);
+
+    ASSERT_TRUE(DbusEnvironment::waitForFuture("async_read"));
+    EXPECT_EQ(sut->updatedTime(), 0u);
+}
+
+TEST_F(TestMetricSensor, notifiesWhenMetricValueChanges)
+{
+    InSequence seq;
+    EXPECT_CALL(*listenerMock, sensorUpdated(Ref(*sut), Ge(timestamp), 0.))
+        .WillOnce(InvokeWithoutArgs(DbusEnvironment::setPromise("async_read")));
+    EXPECT_CALL(*listenerMock, sensorUpdated(Ref(*sut), Ge(timestamp), 99.))
+        .WillOnce(InvokeWithoutArgs(DbusEnvironment::setPromise("notify")));
+
+    sut->registerForUpdates(listenerMock);
+    ASSERT_TRUE(DbusEnvironment::waitForFuture("async_read"));
+
+    metricObject->setValue(99.);
+
+    ASSERT_TRUE(DbusEnvironment::waitForFuture("notify"));
+}
