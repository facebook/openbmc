diff --git a/hw/sensor/ina230.c b/hw/sensor/ina230.c
new file mode 100644
index 0000000000..27598fe286
--- /dev/null
+++ b/hw/sensor/ina230.c
@@ -0,0 +1,330 @@
+/*
+ * TI INA230/INA238 Power Monitor
+ *
+ * This is a minimal implementation of the INA230/INA238 I2C power monitor
+ * (voltage/current/power telemetry) that provides enough functionality for
+ * BMC testing in QEMU.
+ *
+ * Copyright (c) 2025 Meta Platforms, Inc. and affiliates.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_INA230 "ina230"
+
+typedef struct INA230State INA230State;
+OBJECT_DECLARE_SIMPLE_TYPE(INA230State, INA230)
+
+/* INA230 Registers */
+#define INA230_CONFIG           0x00
+#define INA230_SHUNT_VOLTAGE    0x01
+#define INA230_BUS_VOLTAGE      0x02
+#define INA230_POWER            0x03
+#define INA230_CURRENT          0x04
+#define INA230_CALIBRATION      0x05
+#define INA230_MASK_ENABLE      0x06
+#define INA230_ALERT_LIMIT      0x07
+#define INA230_MANUFACTURER_ID  0xFE
+#define INA230_DIE_ID           0xFF
+
+/* Default Values */
+#define INA230_CONFIG_DEFAULT       0x4127
+#define INA230_CALIBRATION_DEFAULT  0x0000
+#define INA230_MASK_ENABLE_DEFAULT  0x0000
+#define INA230_MANUFACTURER_ID_VAL  0x5449  /* "TI" */
+#define INA230_DIE_ID_VAL           0x2270
+
+/* Simulated measurement values (12V, 1A, 12W) */
+// 100 * 2.5uV = 250uV (for 250mOhm shunt @ 1A)
+#define INA230_SHUNT_VOLTAGE_DEFAULT  100
+
+// 9600 * 1.25mV = 12V
+#define INA230_BUS_VOLTAGE_DEFAULT    9600
+
+// Calculated based on calibration
+#define INA230_POWER_DEFAULT          480
+
+// Calculated based on calibration
+#define INA230_CURRENT_DEFAULT        4000
+
+struct INA230State {
+    I2CSlave i2c;
+
+    uint8_t pointer;
+    bool addr_byte;
+    uint8_t byte_idx;
+    uint8_t byte_count;
+    uint8_t byte_buf[2];
+
+    uint16_t config;
+    uint16_t shunt_voltage;
+    uint16_t bus_voltage;
+    uint16_t power;
+    uint16_t current;
+    uint16_t calibration;
+    uint16_t mask_enable;
+    uint16_t alert_limit;
+};
+
+static void ina230_reset(DeviceState *dev)
+{
+    INA230State *s = INA230(dev);
+
+    s->pointer = 0;
+    s->addr_byte = false;
+    s->byte_idx = 0;
+    s->byte_count = 0;
+    s->byte_buf[0] = 0;
+    s->byte_buf[1] = 0;
+    s->config = INA230_CONFIG_DEFAULT;
+    s->shunt_voltage = INA230_SHUNT_VOLTAGE_DEFAULT;
+    s->bus_voltage = INA230_BUS_VOLTAGE_DEFAULT;
+    s->power = INA230_POWER_DEFAULT;
+    s->current = INA230_CURRENT_DEFAULT;
+    s->calibration = INA230_CALIBRATION_DEFAULT;
+    s->mask_enable = INA230_MASK_ENABLE_DEFAULT;
+    s->alert_limit = 0x0000;
+}
+
+static uint16_t ina230_read_register(INA230State *s, uint8_t reg)
+{
+    switch (reg) {
+    case INA230_CONFIG:
+        return s->config;
+    case INA230_SHUNT_VOLTAGE:
+        return s->shunt_voltage;
+    case INA230_BUS_VOLTAGE:
+        return s->bus_voltage;
+    case INA230_POWER:
+        return s->power;
+    case INA230_CURRENT:
+        return s->current;
+    case INA230_CALIBRATION:
+        return s->calibration;
+    case INA230_MASK_ENABLE:
+        return s->mask_enable;
+    case INA230_ALERT_LIMIT:
+        return s->alert_limit;
+    case INA230_MANUFACTURER_ID:
+        return INA230_MANUFACTURER_ID_VAL;
+    case INA230_DIE_ID:
+        return INA230_DIE_ID_VAL;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: read from unsupported register 0x%02x\n",
+                      __func__,
+                      reg);
+        return 0;
+    }
+}
+
+static void ina230_write_register(INA230State *s, uint8_t reg, uint16_t value)
+{
+    switch (reg) {
+    case INA230_CONFIG:
+        s->config = value;
+        break;
+    case INA230_CALIBRATION:
+        s->calibration = value;
+        break;
+    case INA230_MASK_ENABLE:
+        s->mask_enable = value;
+        break;
+    case INA230_ALERT_LIMIT:
+        s->alert_limit = value;
+        break;
+    case INA230_MANUFACTURER_ID:
+    case INA230_DIE_ID:
+    case INA230_SHUNT_VOLTAGE:
+    case INA230_BUS_VOLTAGE:
+    case INA230_POWER:
+    case INA230_CURRENT:
+        /* Read-only registers */
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: write to read-only register 0x%02x\n",
+                      __func__,
+                      reg);
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: write to unsupported register 0x%02x\n",
+                      __func__,
+                      reg);
+        break;
+    }
+}
+
+static uint8_t ina230_recv(I2CSlave *i2c)
+{
+    INA230State *s = INA230(i2c);
+    uint16_t value;
+    uint8_t ret;
+
+    if (s->byte_idx == 0) {
+        value = ina230_read_register(s, s->pointer);
+        ret = (value >> 8) & 0xFF;
+        s->byte_idx = 1;
+    } else {
+        value = ina230_read_register(s, s->pointer);
+        ret = value & 0xFF;
+        s->byte_idx = 0;
+    }
+
+    return ret;
+}
+
+static int ina230_send(I2CSlave *i2c, uint8_t data)
+{
+    INA230State *s = INA230(i2c);
+
+    if (s->addr_byte) {
+        s->pointer = data;
+        s->addr_byte = false;
+        s->byte_count = 0;
+    } else {
+        s->byte_buf[s->byte_count++] = data;
+
+        if (s->byte_count == 2) {
+            uint16_t value = (s->byte_buf[0] << 8) | s->byte_buf[1];
+            ina230_write_register(s, s->pointer, value);
+            s->byte_count = 0;
+        }
+    }
+
+    return 0;
+}
+
+static int ina230_event(I2CSlave *i2c, enum i2c_event event)
+{
+    INA230State *s = INA230(i2c);
+
+    switch (event) {
+    case I2C_START_SEND:
+        s->addr_byte = true;
+        break;
+    case I2C_START_RECV:
+        /* A fresh read always starts at the MSB of the pointed register */
+        s->byte_idx = 0;
+        break;
+    default:
+        break;
+    }
+
+    return 0;
+}
+
+static void ina230_get_voltage(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    INA230State *s = INA230(obj);
+    uint32_t value = s->bus_voltage * 125 / 100; /* Convert to millivolts */
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void ina230_set_voltage(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    INA230State *s = INA230(obj);
+    uint32_t value;
+
+    if (!visit_type_uint32(v, name, &value, errp)) {
+        return;
+    }
+
+    s->bus_voltage = (value * 100) / 125; /* Convert from millivolts */
+}
+
+static void ina230_get_current(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    INA230State *s = INA230(obj);
+    uint32_t value = s->current; /* Already in milliamps */
+    visit_type_uint32(v, name, &value, errp);
+}
+
+static void ina230_set_current(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    INA230State *s = INA230(obj);
+    uint32_t value;
+
+    if (!visit_type_uint32(v, name, &value, errp)) {
+        return;
+    }
+
+    s->current = value;
+
+    // Approximate power calculation
+    s->power = (uint32_t)s->bus_voltage * value / 20000;
+}
+
+static const VMStateDescription vmstate_ina230 = {
+    .name = "ina230",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(i2c, INA230State),
+        VMSTATE_UINT8(pointer, INA230State),
+        VMSTATE_BOOL(addr_byte, INA230State),
+        VMSTATE_UINT8(byte_idx, INA230State),
+        VMSTATE_UINT8(byte_count, INA230State),
+        VMSTATE_UINT8_ARRAY(byte_buf, INA230State, 2),
+        VMSTATE_UINT16(config, INA230State),
+        VMSTATE_UINT16(shunt_voltage, INA230State),
+        VMSTATE_UINT16(bus_voltage, INA230State),
+        VMSTATE_UINT16(power, INA230State),
+        VMSTATE_UINT16(current, INA230State),
+        VMSTATE_UINT16(calibration, INA230State),
+        VMSTATE_UINT16(mask_enable, INA230State),
+        VMSTATE_UINT16(alert_limit, INA230State),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void ina230_initfn(Object *obj)
+{
+    object_property_add(obj, "voltage", "uint32",
+                        ina230_get_voltage,
+                        ina230_set_voltage, NULL, NULL);
+
+    object_property_add(obj, "current", "uint32",
+                        ina230_get_current,
+                        ina230_set_current, NULL, NULL);
+}
+
+static void ina230_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    k->event = ina230_event;
+    k->recv = ina230_recv;
+    k->send = ina230_send;
+    device_class_set_legacy_reset(dc, ina230_reset);
+    dc->vmsd = &vmstate_ina230;
+    dc->desc = "TI INA230/INA238 Power Monitor";
+}
+
+static const TypeInfo ina230_info = {
+    .name = TYPE_INA230,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(INA230State),
+    .instance_init = ina230_initfn,
+    .class_init = ina230_class_init,
+};
+
+static void ina230_register_types(void)
+{
+    type_register_static(&ina230_info);
+}
+
+type_init(ina230_register_types)
diff --git a/hw/sensor/meson.build b/hw/sensor/meson.build
index 420fdc3359..0326c76c82 100644
--- a/hw/sensor/meson.build
+++ b/hw/sensor/meson.build
@@ -4,6 +4,7 @@ system_ss.add(when: 'CONFIG_DPS310', if_true: files('dps310.c'))
 system_ss.add(when: 'CONFIG_EMC141X', if_true: files('emc141x.c'))
 system_ss.add(when: 'CONFIG_ADM1266', if_true: files('adm1266.c'))
 system_ss.add(when: 'CONFIG_ADM1272', if_true: files('adm1272.c'))
+system_ss.add(when: 'CONFIG_INA230', if_true: files('ina230.c'))
 system_ss.add(when: 'CONFIG_MAX34451', if_true: files('max34451.c'))
 system_ss.add(when: 'CONFIG_LSM303DLHC_MAG', if_true: files('lsm303dlhc_mag.c'))
 system_ss.add(when: 'CONFIG_ISL_PMBUS_VR', if_true: files('isl_pmbus_vr.c'))
