From b1683bad43d8482b3184018a0cce988eeb1e86f0 Mon Sep 17 00:00:00 2001
From: Eldin Lee <eldin.lee@quantatw.com>
Date: Mon, 27 Apr 2026 17:11:11 +0800
Subject: [PATCH 102/102] valve-monitor: switch to percentage tolerance and
 iio-hwmon ADC

Use percentage-based tolerance check instead of absolute difference.
Update ADC probing to use iio-hwmon sysfs via glob.

Signed-off-by: Eldin Lee <eldin.lee@quantatw.com>
---
 src/valve-monitor/AnalogValve.cpp | 52 +++++++++++++++++++------------
 1 file changed, 32 insertions(+), 20 deletions(-)

diff --git a/src/valve-monitor/AnalogValve.cpp b/src/valve-monitor/AnalogValve.cpp
index e354c64..b8f1560 100644
--- a/src/valve-monitor/AnalogValve.cpp
+++ b/src/valve-monitor/AnalogValve.cpp
@@ -6,6 +6,8 @@
 #include "SystemdInterface.hpp"
 #include "ValveEvents.hpp"
 
+#include <glob.h>
+
 #include <phosphor-logging/lg2.hpp>
 #include <sdbusplus/async.hpp>
 #include <sdbusplus/message/native_types.hpp>
@@ -269,8 +271,20 @@ auto AnalogValve::checkSetPointTolerance(double voltage)
         co_return;
     }
 
-    bool outOfTolerance =
-        std::abs(voltage - currentSetPointVoltage) > analogConfig.tolerance;
+    double toleranceRatio = analogConfig.tolerance / 100.0;
+    bool outOfTolerance = false;
+    double actualError = std::abs(voltage - currentSetPointVoltage);
+    double percentError = actualError / std::abs(currentSetPointVoltage);
+
+    outOfTolerance = percentError > toleranceRatio;
+
+    debug("Voltage tolerance check: voltage={VOLTAGE}, setpoint={SETPOINT}, "
+          "actualError={ACT_ERR}, percentError={PCT_ERR}%, "
+          "toleranceRatio={TOL_RATIO}%, outOfTolerance={OOT}",
+          "VOLTAGE", voltage, "SETPOINT", currentSetPointVoltage, "ACT_ERR",
+          actualError, "PCT_ERR", percentError * 100.0, "TOL_RATIO",
+          toleranceRatio * 100.0, "OOT", outOfTolerance);
+
     co_await events.handleValveSetPointWarning(inventoryPath, outOfTolerance);
 }
 
@@ -437,29 +451,27 @@ auto AnalogValve::findDACSysfsPath() -> std::optional<std::string>
 
 auto AnalogValve::findADCSysfsPath() -> std::optional<std::string>
 {
-    // ADC is a platform IIO device, look for
-    // /sys/bus/iio/devices/iio:device*/in_voltage<index>_raw
-    std::string iioBasePath = "/sys/bus/iio/devices";
-
-    if (!fs::exists(iioBasePath))
+    std::string pattern = "/sys/class/hwmon/hwmon*/in" +
+                          std::to_string(analogConfig.adc.index) + "_input";
+    glob_t result{};
+    if (glob(pattern.c_str(), GLOB_NOSORT, nullptr, &result) != 0 ||
+        result.gl_pathc == 0)
     {
-        error("IIO devices path {PATH} does not exist", "PATH", iioBasePath);
+        globfree(&result);
+        error("Failed to find IIO ADC channel for index {IDX}", "IDX",
+              analogConfig.adc.index);
         return std::nullopt;
     }
 
-    for (const auto& entry : fs::directory_iterator(iioBasePath))
+    std::string path = result.gl_pathv[0];
+    globfree(&result);
+
+    std::ifstream ifs(path);
+    std::string val;
+    if (std::getline(ifs, val) && !val.empty())
     {
-        auto dirName = entry.path().filename().string();
-        if (dirName.starts_with("iio:device"))
-        {
-            auto inPath =
-                std::format("{}/in_voltage{}_raw", entry.path().string(),
-                            analogConfig.adc.index);
-            if (fs::exists(inPath))
-            {
-                return inPath;
-            }
-        }
+        debug("ADC iio-hwmon sysfs node probe OK: path={PATH}", "PATH", path);
+        return fs::canonical(path).string();
     }
 
     error("Failed to find IIO ADC channel for index {IDX}", "IDX",
-- 
