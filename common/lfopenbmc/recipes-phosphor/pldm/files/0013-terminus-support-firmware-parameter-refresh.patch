+void MctpDiscovery::refreshFirmwareParameters(const MctpInfos& mctpInfos)
+{
+    for (const auto& handler : handlers)
+    {
+        if (handler)
+        {
+            handler->handleConfigurations(configurations);
+            handler->refreshFirmwareParameters(mctpInfos);
+        }
+    }
+}
