From d86c72a4d9191d38efb280ed42fa7a2f5bd5f576 Mon Sep 17 00:00:00 2001
From: Jayanth Othayoth <ojayanth@gmail.com>
Date: Sun, 2 Aug 2026 01:52:14 -0500
Subject: [PATCH] lg2: replace extractEvent tuple with EventInfo

Replace the tuple returned by extractEvent() with a named EventInfo
structure.

EventInfo groups together the message identifier, log level, and event
metadata into a single type, improving readability and simplifying
future event processing changes.

No functional changes are intended.

Change-Id: I440fa9620485cec86a8ddffeb203504938b2c382
Signed-off-by: Jayanth Othayoth <ojayanth@gmail.com>
---
 lib/lg2_commit.cpp | 10 +++++++---
 lib/lg2_commit.hpp | 31 +++++++++++++++++++++++--------
 log_manager.cpp    |  6 ++++--
 3 files changed, 34 insertions(+), 13 deletions(-)

diff --git a/lib/lg2_commit.cpp b/lib/lg2_commit.cpp
index 9bf03b6..380651d 100644
--- a/lib/lg2_commit.cpp
+++ b/lib/lg2_commit.cpp
@@ -106,10 +106,14 @@ static auto data_from_json(sdbusplus::exception::generated_event_base& t)
     return result;
 }
 
-auto extractEvent(sdbusplus::exception::generated_event_base&& t)
-    -> std::tuple<std::string, Entry::Level, std::map<std::string, std::string>>
+auto extractEvent(sdbusplus::exception::generated_event_base&& event)
+    -> EventInfo
 {
-    return {t.name(), severity_from_syslog(t.severity()), data_from_json(t)};
+    return {
+        .message = event.name(),
+        .level = severity_from_syslog(event.severity()),
+        .additionalData = data_from_json(event),
+    };
 }
 
 } // namespace details
diff --git a/lib/lg2_commit.hpp b/lib/lg2_commit.hpp
index 9c76e04..1f9beaf 100644
--- a/lib/lg2_commit.hpp
+++ b/lib/lg2_commit.hpp
@@ -1,24 +1,39 @@
 #pragma once
+
 #include <sdbusplus/exception.hpp>
 #include <xyz/openbmc_project/Logging/Entry/client.hpp>
 
+#include <map>
 #include <string>
-#include <tuple>
-#include <vector>
 
 namespace lg2::details
 {
 
 using Entry = sdbusplus::client::xyz::openbmc_project::logging::Entry<>;
 
-/** Extract the message, level, and additional data from agenerated event.
+/**
+ * Information extracted from a generated event.
+ */
+struct EventInfo
+{
+    /** Event message identifier. */
+    std::string message;
+
+    /** Event level. */
+    Entry::Level level;
+
+    /** Event metadata. */
+    std::map<std::string, std::string> additionalData;
+};
+
+/** Extract information from a generated event.
+ *
+ * @param[in] event - The event to extract data from.
  *
- *  @param[in] The event to extract data from.
- *  @return A tuple containing the message, level, and additional data.
+ * @return Extracted event information.
  */
-auto extractEvent(sdbusplus::exception::generated_event_base&&)
-    -> std::tuple<std::string, Entry::Level,
-                  std::map<std::string, std::string>>;
+auto extractEvent(sdbusplus::exception::generated_event_base&& event)
+    -> EventInfo;
 
 bool filterEvent(const std::string&);
 bool filterError(const std::string&);
diff --git a/log_manager.cpp b/log_manager.cpp
index a0158f9..de96f40 100644
--- a/log_manager.cpp
+++ b/log_manager.cpp
@@ -310,8 +310,10 @@ auto Manager::createFromEvent(
     sdbusplus::exception::generated_event_base&& event)
     -> sdbusplus::object_path
 {
-    auto [msg, level, data] = lg2::details::extractEvent(std::move(event));
-    return this->createEntry(msg, level, std::move(data));
+    auto eventInfo = lg2::details::extractEvent(std::move(event));
+
+    return this->createEntry(eventInfo.message, eventInfo.level,
+                             std::move(eventInfo.additionalData));
 }
 
 bool Manager::isQuiesceOnErrorEnabled()
-- 
