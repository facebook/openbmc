From 04ce6653071a19fcef6410d5110b688ba973bb4d Mon Sep 17 00:00:00 2001
From: Peter Yin <peteryin.openbmc@gmail.com>
Date: Fri, 14 Jun 2024 13:36:36 +0800
Subject: [PATCH 1002/1007] ARM: dts: aspeed: Harma: read cpu temp and power

Add sbrmi and sbtsi device

There are no sbrmi and sbtsi drivers in upstream,
so it only patch in Meta tree.

Signed-off-by: Peter Yin <peteryin.openbmc@gmail.com>
---
 arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts
index fa9de5c97bd4..ea40c529e6f9 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-harma.dts
@@ -425,6 +425,16 @@ power-monitor@45 {
 
 &i2c7 {
 	status = "okay";
+	sbrmi@3C {
+		compatible = "amd,sbrmi";
+		reg = <0x3C>;
+		dimm-count = <8>;
+		dimm-ids = <0x00 0x01 0x02 0x03 0x10 0x11 0x12 0x13>;
+	};
+	sbtsi@4C {
+		compatible = "amd,sbtsi";
+		reg = <0x4C>;
+	};
 };
 
 &i2c8 {
-- 
2.49.0

