--- a/platform.cpp
+++ b/platform.cpp
@@ -1,8 +1,11 @@
+#include "bmc.h"
 #include "bmc_cpld.h"
+#include "nic.h"
+#include "platform.hpp"
 #include "vr_fw.h"
+#include <cstring>
 #include <syslog.h>
-#include <facebook/netlakenext_common.h>
-#include "nic.h"
+#include <openbmc/kv.h>
 
 BmcCpldComponent  cpld_server("server", "cpld", "LFMXO5-25", "3", "0x40");
 
@@ -11,3 +14,48 @@ NicComponent  nic("nic", "nic");
 VrComponent vr_vddcr("server", "vr_vddcr", "VR_VDDCR/VR_VDDCR_SOC");
 VrComponent vr_vdd_misc("server", "vr_vdd_misc", "VR_VDD_MISC");
 
+const std::array<VersionRange, BOARD_REV_COUNT> verMap =
+{
+    VersionRange{"EVT", "", ""},
+    VersionRange{"EVT2", "", "netlakenext-v2026.20.1"},
+    VersionRange{"EVT3", "", ""},
+    VersionRange{"PreDVT", "", ""},
+    VersionRange{"DVT", "", ""},
+    VersionRange{"PVT", "netlakenext-v2026.21.1", ""},
+    VersionRange{"MP", "", ""},
+};
+
+bool BmcComponent::pre_check(const std::string& image) {
+    uint8_t sysCfg = 0;
+    uint8_t boardRev = 0;
+    int ret = 0;
+    char value[MAX_VALUE_LEN] = {0};
+
+    ret = kv_get(SKIP_BMC_FWUPD_PRECHK_KV_KEY, value, NULL, 0);
+
+    if ((ret == 0) &&
+        (strncmp(value, HIGH_STR, strlen(HIGH_STR)) == 0)) {
+        sys().output << "Skip pre-check\n";
+        return true;
+    }
+
+    ret = netlakenext_common_get_sys_cfg(&sysCfg);
+    if (ret < 0) {
+        sys().error << "Failed to get system configuration, pre-check failed\n";
+        return false;
+    }
+    boardRev = (sysCfg & CPLD_REV_ID_BIT);
+    if (boardRev >= verMap.size()) {
+        sys().error << "Invalid board revision(dec): " << int(boardRev)
+                    << ", system config(dec): " << int(sysCfg) << "\n";
+        return false;
+    }
+
+    sys().output << "Detected " << verMap[boardRev].stage << " stage board\n";
+
+    if(is_version_valid(image, verMap[boardRev].minVer, verMap[boardRev].maxVer) == false) {
+        return false;
+    }
+
+    return true;
+}
