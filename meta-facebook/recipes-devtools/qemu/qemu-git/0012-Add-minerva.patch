+
+    /* Chassis control */
+    /* power-chassis-control */
+    object_property_set_bool(OBJECT(gpio), "gpioQ5", true, &error_fatal);
+    /* power-chassis-good */
+    object_property_set_bool(OBJECT(gpio), "gpioV6", true, &error_fatal);
+
+    /* host0-ready */
+    object_property_set_bool(OBJECT(gpio), "gpioS7", false, &error_fatal);
+
+    /* BAT_DETECT */
+    object_property_set_bool(OBJECT(gpio), "gpioV4", false, &error_fatal);
+
+    /*
+     * Blade UART selection - these are mux control signals
+     * Default all to low
+     */
+    /* BLADE_UART_SEL0 */
+    object_property_set_bool(OBJECT(gpio), "gpioL4", false, &error_fatal);
+    /* BLADE_UART_SEL1 */
+    object_property_set_bool(OBJECT(gpio), "gpioM5", false, &error_fatal);
+    /* BLADE_UART_SEL2 */
+    object_property_set_bool(OBJECT(gpio), "gpioC4", false, &error_fatal);
+    /* BLADE_UART_SEL3 */
+    object_property_set_bool(OBJECT(gpio), "gpioX2", false, &error_fatal);
+
+    /* LED control - initial states */
+    /* bmc_heartbeat_amber - will be toggled by kernel */
+    object_property_set_bool(OBJECT(gpio), "gpioP7", false, &error_fatal);
+    /* fp_id_amber */
+    object_property_set_bool(OBJECT(gpio), "gpioB5", false, &error_fatal);
+    /* power_blue */
+    object_property_set_bool(OBJECT(gpio), "gpioP4", false, &error_fatal);
+}
+
+static void minerva_i2c_init(AspeedMachineState *bmc)
+{
+    AspeedSoCState *soc = bmc->soc;
+    minerva_bmc_i2c_init(soc);
+    minerva_bmc_reset_gpios(soc);
+}
+
+static void aspeed_machine_minerva_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    AspeedMachineClass *amc = ASPEED_MACHINE_CLASS(oc);
+
+    mc->desc       = "Meta Platforms Minerva CMM BMC (Cortex-A7)";
+    amc->fmc_model = "n25q00";
+    amc->num_cs    = 2;
+    amc->macs_mask = ASPEED_MAC3_ON;
+    amc->i2c_init  = minerva_i2c_init;
+    mc->default_ram_size = 2 * GiB;
+    aspeed_machine_class_init_cpus_defaults(mc);
+}
+
+static const TypeInfo aspeed_ast2600_minerva_types[] = {
+    {
+        .name          = MACHINE_TYPE_NAME("minerva-bmc"),
+        .parent        = MACHINE_TYPE_NAME("ast2600-evb"),
+        .class_init    = aspeed_machine_minerva_class_init,
+        .interfaces    = arm_machine_interfaces,
+    }
+};
+
+DEFINE_TYPES(aspeed_ast2600_minerva_types)
