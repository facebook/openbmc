From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Amithash Prasad <amithash@meta.com>
Date: Sun, 15 Jun 2026 00:00:00 +0000
Subject: [PATCH] Cargo.lock: add missing thiserror 2.0.18 entries

The workspace pins `simple_asn1 = "=0.6.3"`, and simple_asn1 0.6.3
requires `thiserror = "2"`. The committed Cargo.lock references
`thiserror 2.0.18` from simple_asn1's dependency list but never declares
the corresponding `[[package]]` blocks for `thiserror 2.0.18` and
`thiserror-impl 2.0.18` (it only carries the 1.0.56 packages). cargo
therefore fails to resolve the graph offline:

  error: failed to select a version for the requirement `thiserror = "^2"`
  candidate versions found which didn't match: 1.0.56, 1.0.50

Add the missing package entries and disambiguate the now-ambiguous
`thiserror`/`thiserror-impl` references in the 1.x consumers (asn1-rs,
x509-parser, and the thiserror 1.0.56 package itself).

Upstream-Status: Pending
Signed-off-by: Amithash Prasad <amithash@meta.com>
---
 Cargo.lock | 26 ++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

--- a/Cargo.lock
+++ b/Cargo.lock
@@ -89,7 +89,7 @@
  "nom",
  "num-traits",
  "rusticata-macros",
- "thiserror",
+ "thiserror 1.0.56",
  "time",
 ]
 
@@ -2426,7 +2426,16 @@
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "d54378c645627613241d077a3a79db965db602882668f9136ac42af9ecb730ad"
 dependencies = [
- "thiserror-impl",
+ "thiserror-impl 1.0.56",
+]
+
+[[package]]
+name = "thiserror"
+version = "2.0.18"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "4288b5bcbc7920c07a1149a35cf9590a2aa808e0bc1eafaade0b80947865fbc4"
+dependencies = [
+ "thiserror-impl 2.0.18",
 ]
 
 [[package]]
@@ -2441,6 +2450,17 @@
 ]
 
 [[package]]
+name = "thiserror-impl"
+version = "2.0.18"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "ebc4ee7f67670e9b64d05fa4253e753e016c6c95ff35b89b7941d6b856dec1d5"
+dependencies = [
+ "proc-macro2",
+ "quote",
+ "syn 2.0.117",
+]
+
+[[package]]
 name = "time"
 version = "0.3.44"
 source = "registry+https://github.com/rust-lang/crates.io-index"
@@ -2986,7 +3006,7 @@
  "nom",
  "oid-registry",
  "rusticata-macros",
- "thiserror",
+ "thiserror 1.0.56",
  "time",
 ]
 
