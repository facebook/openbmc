From d58b61f07301413a6b2089d77f7812e00bc8fd2a Mon Sep 17 00:00:00 2001
From: Ken Chen <Ken.Chen@quantatw.com>
Date: Wed, 3 Dec 2025 20:12:25 +0800
Subject: [PATCH] enable uart dma

---
 .../boot/dts/aspeed/aspeed-bmc-facebook-yosemite5.dts  | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-yosemite5.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-yosemite5.dts
index 72ef04726..8d1dd59b5 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-yosemite5.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-yosemite5.dts
@@ -1065,6 +1065,10 @@ flash@0 {
 	};
 };
 
+&udma {
+	status = "okay";
+};
+
 /* Host Console */
 &uart1 {
 	status = "okay";
@@ -1076,11 +1080,17 @@ &uart2 {
 
 /* SOL */
 &uart3 {
+	compatible = "aspeed,ast2600-uart";
 	status = "okay";
+	dmas = <&udma 4>, <&udma 5>;
+	dma-names = "tx", "rx";
 };
 
 &uart4 {
+	compatible = "aspeed,ast2600-uart";
 	status = "okay";
+	dmas = <&udma 6>, <&udma 7>;
+	dma-names = "tx", "rx";
 };
 
 /* BMC Console */
-- 
