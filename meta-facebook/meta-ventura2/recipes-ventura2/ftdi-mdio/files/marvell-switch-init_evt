#!/bin/bash

# shellcheck source=meta-facebook/recipes-fb/obmc_functions/files/fb-common-functions
source /usr/libexec/fb-common-functions

get_devnum_by_udev_id_path() {
    for d in /sys/bus/usb/devices/*; do
        [[ -f "$d/devnum" ]] || continue
        udevadm info -p "$d" | grep -qx "E: ID_PATH=$1" || continue
        cat "$d/devnum"
    done
}
ID_PATH="platform-1e6a1000.usb-usb-0:1.4"
USB_DEV_NUM=$(get_devnum_by_udev_id_path "$ID_PATH")
FTDI_CH=1

cleanup() {
    echo "[trap] triggered, killing daemon"
    kill "$DAEMON_PID" 2>/dev/null
}
trap cleanup EXIT INT TERM

ftdi-mdio-daemon -d "$USB_DEV_NUM" -i "$FTDI_CH" --quiet &
DAEMON_PID=$!

mdio_read() {
    local dev_addr=$1 dev_reg=$2
    local val
    if ! val=$(ftdi-mdio read -p "$dev_addr" -r "$dev_reg"); then
        printf "mdio_read: phy=%d reg=0x%02X FAILED\n" \
            "$dev_addr" "$dev_reg" >&2
        return 1
    fi
    printf "mdio_read: phy=%d reg=0x%02X val=0x%04X\n" \
        "$dev_addr" "$dev_reg" "$val" >&2
    echo "$val"
}

mdio_write() {
    local dev_addr=$1 dev_reg=$2 val=$3
    if ! ftdi-mdio write -p "$dev_addr" -r "$dev_reg" -v "$val"; then
        printf "mdio_write: phy=%d reg=0x%02X val=0x%04X FAILED\n" \
            "$dev_addr" "$dev_reg" "$val" >&2
        return 1
    fi
    printf "mdio_write: phy=%d reg=0x%02X val=0x%04X\n" \
        "$dev_addr" "$dev_reg" "$val" >&2
}

SMI_PHY_SMIBusy=$((0x01 << 15))
SMI_PHY_SMIMode_C22=$((0x01 << 12))
SMI_PHY_SMIOp_C22_Write=$((0x01 << 10))
SMI_PHY_SMIOp_C22_Read=$((0x02 << 10))
SMI_PHY_SMIMode_C45=$((0x00 << 12))
SMI_PHY_SMIOp_C45_WriteAddr=$((0x00 << 10))
SMI_PHY_SMIOp_C45_WriteData=$((0x01 << 10))
SMI_PHY_SMIOp_C45_ReadData=$((0x03 << 10))

smi_wait_busy() {
    local timeout=200  # iterations, ~200ms total (1ms sleep + mdio overhead)
    local val i

    for ((i = 0; i < timeout; i++)); do
        val=$(mdio_read 0x1C 0x18 2>/dev/null) || return 1
        if (( (val & 0x8000) == 0 )); then
            return 0
        fi
        usleep 1000
    done

    printf "smi_wait_busy: timeout after %d iterations\n" "$timeout" >&2
    return 1
}

smi_phy_read_reg_c45() {
    local phy_ex=$1 phy_addr=$2 phy_dev=$3 phy_reg=$4 phy_reg_val
    local cmd_base=$((SMI_PHY_SMIBusy | SMI_PHY_SMIMode_C45 | phy_ex << 13 | phy_addr << 5 | phy_dev))
    local phy_type log
    phy_type=$( ((phy_ex)) && echo "external" || echo "internal" )

    if ! log=$({
            mdio_write 0x1C 0x19 "$phy_reg" &&
            mdio_write 0x1C 0x18 $((cmd_base | SMI_PHY_SMIOp_C45_WriteAddr)) &&
            smi_wait_busy &&
            mdio_write 0x1C 0x19 0x00 &&
            mdio_write 0x1C 0x18 $((cmd_base | SMI_PHY_SMIOp_C45_ReadData)) &&
            smi_wait_busy &&
            mdio_read 0x1C 0x19
        } 2>&1); then
        printf "smi_phy_read_c45: phy=%s/%d dev=%d reg=0x%04X FAILED\n" \
            "$phy_type" "$phy_addr" "$phy_dev" "$phy_reg" >&2
        echo "$log" >&2
        return 1
    fi

    phy_reg_val=$(echo "$log" | tail -n 1)
    printf "smi_phy_read_c45: phy=%s/%d dev=%d reg=0x%04X val=0x%04X\n" \
        "$phy_type" "$phy_addr" "$phy_dev" "$phy_reg" "$phy_reg_val" >&2
    echo "$phy_reg_val"
}

smi_phy_write_reg_c45() {
    local phy_ex=$1 phy_addr=$2 phy_dev=$3 phy_reg=$4 phy_reg_val=$5
    local cmd_base=$((SMI_PHY_SMIBusy | SMI_PHY_SMIMode_C45 | phy_ex << 13 | phy_addr << 5 | phy_dev))
    local phy_type log
    phy_type=$( ((phy_ex)) && echo "external" || echo "internal" )

    if ! log=$({
            mdio_write 0x1C 0x19 "$phy_reg" &&
            mdio_write 0x1C 0x18 $((cmd_base | SMI_PHY_SMIOp_C45_WriteAddr)) &&
            smi_wait_busy &&
            mdio_write 0x1C 0x19 "$phy_reg_val" &&
            mdio_write 0x1C 0x18 $((cmd_base | SMI_PHY_SMIOp_C45_WriteData)) &&
            smi_wait_busy
        } 2>&1); then
        printf "smi_phy_write_c45: phy=%s/%d dev=%d reg=0x%04X val=0x%04X FAILED\n" \
            "$phy_type" "$phy_addr" "$phy_dev" "$phy_reg" "$phy_reg_val" >&2
        echo "$log" >&2
        return 1
    fi

    printf "smi_phy_write_c45: phy=%s/%d dev=%d reg=0x%04X val=0x%04X\n" \
        "$phy_type" "$phy_addr" "$phy_dev" "$phy_reg" "$phy_reg_val" >&2
}

smi_phy_read_paged_reg() {
    local phy_ex=$1 phy_addr=$2 phy_page=$3 phy_reg=$4 phy_reg_val
    local cmd_base=$((SMI_PHY_SMIBusy | SMI_PHY_SMIMode_C22 | phy_ex << 13 | phy_addr << 5))
    local phy_type log
    phy_type=$( ((phy_ex)) && echo "external" || echo "internal" )

    if ! log=$({
            mdio_write 0x1C 0x19 "$phy_page" &&
            mdio_write 0x1C 0x18 $((cmd_base | SMI_PHY_SMIOp_C22_Write | 22)) &&
            smi_wait_busy &&
            mdio_write 0x1C 0x19 0x00 &&
            mdio_write 0x1C 0x18 $((cmd_base | SMI_PHY_SMIOp_C22_Read | phy_reg)) &&
            smi_wait_busy &&
            mdio_read 0x1C 0x19
        } 2>&1); then
        printf "smi_phy_read_paged: phy=%s/%d page=%d reg=0x%04X FAILED\n" \
            "$phy_type" "$phy_addr" "$phy_page" "$phy_reg" >&2
        echo "$log" >&2
        return 1
    fi

    phy_reg_val=$(echo "$log" | tail -n 1)
    printf "smi_phy_read_paged: phy=%s/%d page=%d reg=0x%04X val=0x%04X\n" \
        "$phy_type" "$phy_addr" "$phy_page" "$phy_reg" "$phy_reg_val" >&2
    echo "$phy_reg_val"
}

smi_phy_write_paged_reg() {
    local phy_ex=$1 phy_addr=$2 phy_page=$3 phy_reg=$4 phy_reg_val=$5
    local cmd_base=$((SMI_PHY_SMIBusy | SMI_PHY_SMIMode_C22 | phy_ex << 13 | phy_addr << 5))
    local phy_type log
    phy_type=$( ((phy_ex)) && echo "external" || echo "internal" )

    if ! log=$({
            mdio_write 0x1C 0x19 "$phy_page" &&
            mdio_write 0x1C 0x18 $((cmd_base | SMI_PHY_SMIOp_C22_Write | 22)) &&
            smi_wait_busy &&
            mdio_write 0x1C 0x19 "$phy_reg_val" &&
            mdio_write 0x1C 0x18 $((cmd_base | SMI_PHY_SMIOp_C22_Write | phy_reg)) &&
            smi_wait_busy
        } 2>&1); then
        printf "smi_phy_write_paged: phy=%s/%d page=%d reg=0x%04X val=0x%04X FAILED\n" \
            "$phy_type" "$phy_addr" "$phy_page" "$phy_reg" "$phy_reg_val" >&2
        echo "$log" >&2
        return 1
    fi

    printf "smi_phy_write_paged: phy=%s/%d page=%d reg=0x%04X val=0x%04X\n" \
        "$phy_type" "$phy_addr" "$phy_page" "$phy_reg" "$phy_reg_val" >&2
}

marvell_switch_init() {
    {
        echo "Quick check to determine whether this board is an EVT board" >&2
        val=$(mdio 1* 0 0 2>/dev/null)
        echo "Read p0 [0]=${val:-null} via BMC MDIO interface"
        if [[ -n "$val" && "$val" != "0xffff" ]]; then
            echo "Since MDIO already returns a valid response, we do not need to use ftdi-mdio for the Marvell switch initialization flow."
            return 0
        fi
    }

    {
        echo "Drive PWRGD signals high to release the reset pin of the Marvell 88E6393X" >&2
        set_gpio FPGA_PWRGD_P1V05_AUX_R 1
        set_gpio FPGA_PWRGD_P5V_AUX_R2 1
        set_gpio FPGA_PWRGD_P12V_AUX_R2 1
        set_gpio FPGA_PWRGD_P1V5_AUX_R 1
    }

    {
        echo "Toggle reset pin for Marvell 88E6393X" >&2
        set_gpio FPGA_PWRGD_P1V5_AUX_R 0
        set_gpio FPGA_PWRGD_P1V5_AUX_R 1
    }

    {
        echo "Toggle reset pin for Marvell 88E1512" >&2
        set_gpio FPGA_RST_88E1512_PLD 0
        set_gpio FPGA_RST_88E1512_PLD 1
    }

    echo "Clear PHY detect on Port 0" >&2
    mdio_write 0x00 0x00 0x04

    {
        echo "Disable Port 9 and Port 10 before configuring PHY Mode" >&2
        mdio_write 0x09 0x04 0x7C
        mdio_write 0x0a 0x04 0x7C
    }

    {
        echo "Configure external PHY on Port 9 and Port 10 to SGMII mode" >&2
        smi_phy_write_paged_reg 1 0x00 18 20 0x8001
        smi_phy_write_paged_reg 1 0x01 18 20 0x8001
    }

    {
        echo "Configure switch Port 9 and Port 10 to SGMII mode" >&2
        mdio_write 0x09 0x00 0x0a
        mdio_write 0x0a 0x00 0x0a
    }

    {
        echo "Configure LED on Port 9 and Port 10" >&2
        # LED0 Gb Link (off = no link, on = Gb link)
        # LED1 On - Link, Blink - Activity, Off - No Link
        local MASK=0xFF00
        local LED_CONFIG=0x0017
        for p in {0..1};
        do
            # Read default register value
            DATA=$(smi_phy_read_paged_reg 1 "$p" 3 16)
            VAL=$(( (DATA & MASK) | LED_CONFIG ))
            # Write LED Config into register
            smi_phy_write_paged_reg 1 "$p" 3 16 "$VAL"
        done
    }

    {
        echo "Enable Port 9 and Port 10" >&2
        mdio_write 0x09 0x04 0x7F
        mdio_write 0x0a 0x04 0x7F
    }

    # ERRATA 4.7: When changing C_Mode on SERDES port from any mode to 1000BASE-X mode the link may not come up due to invalid 1000BASE-X advertisement
    local val_4_2000
    {
        echo "Apply ERRTA 4.7 for Port 9" >&2
        smi_phy_write_reg_c45 0 9 4 0x2004 0x20
        val_4_2000=$(smi_phy_read_reg_c45 0 9 4 0x2000)
        smi_phy_write_reg_c45 0 9 4 0x2000 $(( val_4_2000 | 1<<15 ))
        echo "Apply ERRTA 4.7 for Port 10" >&2
        smi_phy_write_reg_c45 0 10 4 0x2004 0x20
        val_4_2000=$(smi_phy_read_reg_c45 0 10 4 0x2000)
        smi_phy_write_reg_c45 0 10 4 0x2000 $(( val_4_2000 | 1<<15 ))
    }

    # ERRATA 4.8: Link may not come up after hardware reset or software reset in 1000BASE-X or SGMII mode
    local val_4_F074
    {
        echo "Apply ERRTA 4.8 for Port 9" >&2
        val_4_F074=$(smi_phy_read_reg_c45 0 9 4 0xF074)
        smi_phy_write_reg_c45 0 9 4 0xF074 $(( val_4_F074 | 1<<14 ))
        echo "Apply ERRTA 4.8 for Port 10" >&2
        val_4_F074=$(smi_phy_read_reg_c45 0 10 4 0xF074)
        smi_phy_write_reg_c45 0 10 4 0xF074 $(( val_4_F074 | 1<<14 ))
    }

    {
        echo "Configure LED on Port 1 through Port 8" >&2
        for p in {1..8};
        do
            mdio_write "$p" 22 0x8033
        done
    }
}

marvell_switch_init
