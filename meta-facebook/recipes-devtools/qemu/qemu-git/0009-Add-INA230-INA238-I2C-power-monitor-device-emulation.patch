     select UNIMP
     select LED
     select PMBUS
diff --git a/hw/sensor/Kconfig b/hw/sensor/Kconfig
index bc6331b4ab..317533f2b5 100644
--- a/hw/sensor/Kconfig
+++ b/hw/sensor/Kconfig
@@ -27,6 +27,10 @@ config ADM1266
     depends on PMBUS
