From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Blot <emmanuel.blot@free.fr>
Date: Mon, 1 Sep 2026 12:00:00 +0200
Subject: [PATCH] hw/arm: bletchley: take the FRU MAC from the configured NIC

The chassis controller FRU holds the BMC MAC address, so the image and the
NIC advertise different ones: the image carries the address read from the
board it was captured on, not the address QEMU was configured with.

Patch it into the copy handed to the EEPROM, taking it from the NIC the
board declares it wires up, which is configured before the EEPROMs are
populated. The field is fixed-length ASCII, so only the area checksum
changes.

The offsets come from the script that generates the images; the model only
checks that they land on a hex string of the right length.

Signed-off-by: Emmanuel Blot <emmanuel.blot@free.fr>
---
 hw/arm/aspeed_ast2600_bletchley.c | 82 ++++++++++++++++++++++++++++--
 1 file changed, 80 insertions(+), 2 deletions(-)

--- a/hw/arm/aspeed_ast2600_bletchley.c
+++ b/hw/arm/aspeed_ast2600_bletchley.c
@@ -20,6 +20,7 @@
 
 #include "qemu/osdep.h"
 #include "qapi/error.h"
+#include "qemu/host-utils.h"
 #include "hw/arm/aspeed.h"
 #include "hw/arm/aspeed_soc.h"
 #include "hw/gpio/pca9552.h"
@@ -50,6 +51,14 @@
     BletchleyFru sled[6];   /* i2c0-5 @0x54 */
     BletchleyFru bsm;       /* i2c6 @0x56 */
     BletchleyFru cc;        /* i2c7 @0x54 */
+    /*
+     * Where the chassis controller image keeps the BMC MAC, as twelve ASCII
+     * hex digits, and the start of the FRU area whose checksum covers them.
+     * Emitted by the generator with the images, so the layout is not parsed
+     * here; zero when the image carries no MAC.
+     */
+    size_t mac_offset;
+    size_t mac_area_offset;
 } BletchleyFruSet;
 
 /* Bletchley v1.0 */
@@ -330,6 +339,8 @@
     },
     .bsm = { fru_v1_0_6_0056, sizeof(fru_v1_0_6_0056) },
     .cc  = { fru_v1_0_7_0054, sizeof(fru_v1_0_7_0054) },
+    .mac_offset = 0x94,       /* board area custom field */
+    .mac_area_offset = 0x38,
 };
 
 /* Bletchley v1.5 */
@@ -614,8 +625,65 @@
     },
     .bsm = { fru_v1_5_6_0056, sizeof(fru_v1_5_6_0056) },
     .cc  = { fru_v1_5_7_0054, sizeof(fru_v1_5_7_0054) },
+    .mac_offset = 0x31,       /* chassis area custom field */
+    .mac_area_offset = 0x08,
 };
 
+/*
+ * The chassis controller FRU carries the BMC MAC address in a custom field,
+ * as twelve upper-case hex digits. On hardware that field is programmed per
+ * unit and the firmware programs the NIC from it.
+ */
+
+#define FRU_MAC_DIGITS 12
+
+/*
+ * Return a copy of the chassis controller image with the MAC set, or NULL if
+ * this revision carries none.
+ */
+static uint8_t *bletchley_fru_dup_with_mac(const BletchleyFruSet *fru,
+                                           const MACAddr *mac)
+{
+    const uint8_t *src = fru->cc.data;
+    char digits[FRU_MAC_DIGITS + 1];
+    uint8_t *image, *area, sum = 0;
+    size_t area_len;
+
+    if (fru->mac_offset == 0) {
+        return NULL;
+    }
+
+    /* Sanity check on the generated data and the offsets that describe it. */
+    area_len = fru->mac_area_offset + 2 <= fru->cc.size ?
+               src[fru->mac_area_offset + 1] * 8 : 0;
+    if (fru->mac_offset + FRU_MAC_DIGITS > fru->cc.size || area_len < 3 ||
+        fru->mac_area_offset + area_len > fru->cc.size) {
+        error_setg(&error_fatal, "bletchley: MAC at %zu in area at %zu is out"
+                   " of range for a %zu byte FRU image", fru->mac_offset,
+                   fru->mac_area_offset, fru->cc.size);
+    }
+    for (unsigned i = 0; i < FRU_MAC_DIGITS; i++) {
+        if (!g_ascii_isxdigit(src[fru->mac_offset + i])) {
+            error_setg(&error_fatal, "bletchley: FRU offset %zu holds no MAC",
+                       fru->mac_offset);
+        }
+    }
+
+    image = g_memdup2(src, fru->cc.size);
+    snprintf(digits, sizeof(digits), "%02X%02X%02X%02X%02X%02X",
+             mac->a[0], mac->a[1], mac->a[2],
+             mac->a[3], mac->a[4], mac->a[5]);
+    memcpy(&image[fru->mac_offset], digits, FRU_MAC_DIGITS);
+
+    area = &image[fru->mac_area_offset];
+    for (size_t i = 0; i < area_len - 1; i++) {
+        sum += area[i];
+    }
+    area[area_len - 1] = (uint8_t)(0x100 - sum);
+
+    return image;
+}
+
 #define TYPE_BLETCHLEY_MACHINE MACHINE_TYPE_NAME("bletchley-bmc")
 OBJECT_DECLARE_SIMPLE_TYPE(BletchleyMachineState, BLETCHLEY_MACHINE)
 
@@ -629,7 +697,9 @@
 {
     const BletchleyFruSet *fru = BLETCHLEY_MACHINE(bmc)->v1_5 ?
                                  &bletchley_fru_v1_5 : &bletchley_fru_v1_0;
+    AspeedMachineClass *amc = ASPEED_MACHINE_GET_CLASS(bmc);
     AspeedSoCState *soc = bmc->soc;
+    uint8_t *cc_fru;
     I2CBus *i2c[13] = {};
     for (int i = 0; i < 13; i++) {
         if ((i == 8) || (i == 11)) {
@@ -659,9 +729,17 @@
     i2c_slave_create_simple(i2c[6], TYPE_DS1338, 0x51);
 
 
-    /* Bus 7 */
+    /*
+     * Bus 7. The chassis controller FRU is the one the BMC reads its own MAC
+     * from, so give it the address of the NIC this board enables rather than
+     * the one the image was captured with.
+     */
+    cc_fru = bletchley_fru_dup_with_mac(fru,
+                 &soc->ftgmac100[ctz32(amc->macs_mask)].conf.macaddr);
+    /* at24c copies the image while realizing the device. */
     at24c_eeprom_init_rom(i2c[7], 0x54, 8 * KiB,
-                          fru->cc.data, fru->cc.size);
+                          cc_fru ? cc_fru : fru->cc.data, fru->cc.size);
+    g_free(cc_fru);
 
     /* Bus 9 */
     i2c_slave_create_simple(i2c[9], TYPE_TMP421, 0x4f);
