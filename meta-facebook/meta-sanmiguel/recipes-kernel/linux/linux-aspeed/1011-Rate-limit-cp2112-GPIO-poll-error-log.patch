Signed-off-by: Ting-Kai Chen <tingkaic@nvidia.com>
Fixes jira https://nvbugspro.nvidia.com/bug/6155899

[1] https://github.com/NVIDIA/linux/commit/a6fae362fba0d8fb6e6cd17c70f81c0bb017fcf3
---
 drivers/hid/hid-cp2112.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/hid/hid-cp2112.c b/drivers/hid/hid-cp2112.c
index 82f930db8e4f..1347fbb242df 100644
--- a/drivers/hid/hid-cp2112.c
+++ b/drivers/hid/hid-cp2112.c
@@ -383,7 +383,7 @@ static int cp2112_gpio_get_all(struct gpio_chip *chip)
 	ret = cp2112_hid_get(hdev, CP2112_GPIO_GET, buf, CP2112_GPIO_GET_LENGTH,
 			     HID_FEATURE_REPORT);
 	if (ret != CP2112_GPIO_GET_LENGTH) {
-		hid_err(hdev, "error requesting GPIO values: %d\n", ret);
+		dev_err_ratelimited(&hdev->dev, "error requesting GPIO values: %d\n", ret);
 		return ret < 0 ? ret : -EIO;
 	}
 
