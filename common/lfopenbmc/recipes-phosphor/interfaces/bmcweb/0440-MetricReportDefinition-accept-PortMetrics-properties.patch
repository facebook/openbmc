+// Returns the PortMetrics JSON pointer for a Metric.Value object path, or
+// nothing if the object isn't a NIC metric that PortMetrics carries.
+inline std::optional<std::string_view> getNicMetricJsonPointer(
+    const sdbusplus::object_path& path)
+{
+    if (path.parent_path().filename() != "nic")
+    {
+        return std::nullopt;
+    }
+    const std::string name = path.filename();
+    for (const NicMetricProperty& property : nicMetricProperties)
+    {
+        if (property.dbusName == name)
+        {
+            return property.jsonPointer;
+        }
+    }
+    return std::nullopt;
+}
