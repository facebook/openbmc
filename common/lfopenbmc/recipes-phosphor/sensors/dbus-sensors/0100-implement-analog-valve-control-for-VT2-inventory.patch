+
+    // NOLINTNEXTLINE(readability-identifier-naming)
+    auto set_property(state_t /*unused*/, auto state) -> bool;
+
+  private:
+    auto onFeedbackVoltage(double volt) -> sdbusplus::async::task<>;
+    auto createSensorAssociations() -> sdbusplus::async::task<>;
+    auto createControlAssociations() -> void;
+    bool isOpenVoltage(double volt);
+
+    sdbusplus::async::context& ctx;
+    sdbusplus::message::object_path inventoryPath;
+    Events& events;
+    config::AnalogValveConfig config;
+
+    // Forward-declare the internal helpers — defined only in AnalogValve.cpp
+    struct FeedbackADC;
+    struct ControlDAC;
+    std::unique_ptr<FeedbackADC> feedback;
+    std::unique_ptr<ControlDAC> control;
+    gpiod::line reportCloseGpio;
+    double feedbackVolt;
+    bool cachedIsOpen;
+};
+
+} // namespace valve
