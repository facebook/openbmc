From 4f33b132b1bf35d9329bd14891898667055440fa Mon Sep 17 00:00:00 2001
From: "Radivoje (Ogi) Jovanovic" <rjovanovic@nvidia.com>
Date: Thu, 22 Jan 2026 09:36:54 -0800
Subject: [PATCH] i2c: muxes: introduce virtual-mux host

- Registers a virtual I2C adapter; forwards xfers to client over a link I2C bus
- Supports fixed bus number via DT property virtual-bus-num
- Advertises SMBus emulation capabilities
- No DT child auto-instantiation; userspace creates devices when desired

[1] https://github.com/NVIDIA/linux/commit/4313ef5318b80ebdf7d8d74292b68a89e505fa6a

Signed-off-by: Radivoje (Ogi) Jovanovic <rjovanovic@nvidia.com>
---
 .../bindings/i2c/virtual-mux-host.yaml        |  53 ++
 drivers/i2c/muxes/Kconfig                     |   8 +
 drivers/i2c/muxes/Makefile                    |   1 +
 drivers/i2c/muxes/virtual-mux-host.c          | 563 ++++++++++++++++++
 4 files changed, 625 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/i2c/virtual-mux-host.yaml
 create mode 100644 drivers/i2c/muxes/virtual-mux-host.c

diff --git a/Documentation/devicetree/bindings/i2c/virtual-mux-host.yaml b/Documentation/devicetree/bindings/i2c/virtual-mux-host.yaml
new file mode 100644
index 000000000000..532199bdd212
--- /dev/null
+++ b/Documentation/devicetree/bindings/i2c/virtual-mux-host.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/i2c/virtual-mux-host.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Virtual I2C Mux Host (Remote I2C FRU Host Adapter)
+
+maintainers:
+  - Radivoje (Ogi) Jovanovic <rjovanovic@nvidia.com>
+
+description: |
+  The virtual-mux-host is an I2C client on a link bus that exposes a virtual
+  I2C adapter to Linux. Transfers submitted to the virtual adapter are framed
+  and forwarded over the link bus to a remote bridge target.
+
+properties:
+  compatible:
+    const: virtual-mux-host
+
+  reg:
+    maxItems: 1
+    description: I2C address of the remote bridge target on the link bus.
+
+  use-crc16:
+    type: boolean
+    description:
+      Enable CRC16 framing for requests and responses.
+
+  virtual-bus-num:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Optional fixed bus number for the virtual adapter.
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c@0 {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        bridge@52 {
+            compatible = "virtual-mux-host";
+            reg = <0x52>;
+            use-crc16;
+            virtual-bus-num = <12>;
+        };
+    };
diff --git a/drivers/i2c/muxes/Kconfig b/drivers/i2c/muxes/Kconfig
index 6d2f66810cdc..6c431bda6b4c 100644
--- a/drivers/i2c/muxes/Kconfig
+++ b/drivers/i2c/muxes/Kconfig
@@ -135,4 +135,12 @@ config I2C_MUX_MULE
 	  This driver can also be built as a module.  If so, the module
 	  will be called i2c-mux-mule.
 
+config VIRTUAL_MUX_HOST
+	tristate "I2C Bridge Host (virtual adapter forwarding)"
+	depends on I2C
+	help
+	  Registers a virtual I2C adapter that forwards i2c_transfer() over a link
+	  I2C bus to a remote bridge client. Intended for exposing remote FRU EEPROMs
+	  or other devices to stock drivers via a virtual bus.
+
 endmenu
