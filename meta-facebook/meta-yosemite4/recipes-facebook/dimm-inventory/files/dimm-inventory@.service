[Unit]
Description=DIMM Inventory Population for Slot %i
Requires=xyz.openbmc_project.Inventory.Manager.service
After=xyz.openbmc_project.Inventory.Manager.service
After=host-poweron@%i.service
Before=obmc-host-start@%i.target

[Service]
Type=simple
ExecStart=/usr/libexec/dimm-inventory/dimm-inventory %i

[Install]
WantedBy=obmc-host-start@%i.target
