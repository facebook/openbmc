 } union_sensor_data_size;
 
+/** @union union_sensor_data_size64
+ *
+ *  The bit width and format of reading and threshold values that the sensor
+ *  returns, including 64-bit readings.
+ *  Refer to: DSP0248_1.2.0: 28.4 Table 78
+ */
+typedef union {
+	uint8_t value_u8;
+	int8_t value_s8;
+	uint16_t value_u16;
+	int16_t value_s16;
+	uint32_t value_u32;
+	int32_t value_s32;
+	uint64_t value_u64;
+	int64_t value_s64;
+} union_sensor_data_size64;
+
+/** @struct pldm_numeric_sensor_value
+ *
+ *  The tagged present value indicated by a numeric sensor event.
+ */
+struct pldm_numeric_sensor_value {
+	uint8_t sensor_data_size;
+	union_sensor_data_size64 value;
+};
+
 /** @struct pldm_value_pdr_hdr
  *
  *  Structure representing PLDM PDR header for unpacked value
@@ -2303,6 +2334,29 @@ int decode_numeric_sensor_data(const uint8_t *sensor_data,
 			       uint8_t *sensor_data_size,
 			       uint32_t *present_reading);
 
+/** @brief Decode numericSensorState response data
+ *
+ *  @param[in] sensor_data - sensor_data for sensorEventClass =
+ * numericSensorState
+ *  @param[in] sensor_data_length - Length of sensor_data
+ *  @param[out] event_state - The eventState value from the state change that
+ * triggered the event message
+ *  @param[out] previous_event_state - The eventState value for the state from
+ * which the present state was entered
+ *  @param[out] present_reading - The tagged present value indicated by the
+ * sensor
+ *  @return 0 on success,
+ *		-EINVAL if any argument is NULL or the sensor data size is invalid,
+ *		-EOVERFLOW if the sensor data length is invalid,
+ *		-EBADMSG if the sensor data contains unexpected bytes
+ *  @note  Caller is responsible for memory alloc and dealloc of param
+ *         'sensor_data'
+ */
+int decode_numeric_sensor_data_to_value(
+	const uint8_t *sensor_data, size_t sensor_data_length,
+	uint8_t *event_state, uint8_t *previous_event_state,
+	struct pldm_numeric_sensor_value *present_reading) LIBPLDM_API_TESTING;
+
 /** @brief Decode Numeric Sensor Pdr data
  *
  *  @param[in] pdr_data - pdr data for numeric sensor
diff --git a/src/dsp/platform.c b/src/dsp/platform.c
index 544ecad..e18cbcc 100644
--- a/src/dsp/platform.c
+++ b/src/dsp/platform.c
@@ -1721,93 +1721,98 @@ int decode_numeric_sensor_data(const uint8_t *sensor_data,
 			       uint8_t *previous_event_state,
 			       uint8_t *sensor_data_size,
 			       uint32_t *present_reading)
+{
+	struct pldm_numeric_sensor_value reading;
+
+	if (sensor_data_size == NULL || present_reading == NULL) {
+		return PLDM_ERROR_INVALID_DATA;
+	}
+
+	int rc = decode_numeric_sensor_data_to_value(
+		sensor_data, sensor_data_length, event_state,
+		previous_event_state, &reading);
+
+	if (rc) {
+		return pldm_xlate_errno(rc);
+	}
+
+	*sensor_data_size = reading.sensor_data_size;
+	switch (*sensor_data_size) {
+	case PLDM_SENSOR_DATA_SIZE_UINT8:
+		*present_reading = reading.value.value_u8;
+		break;
+	case PLDM_SENSOR_DATA_SIZE_SINT8:
+		*present_reading = (uint32_t)(int32_t)reading.value.value_s8;
+		break;
+	case PLDM_SENSOR_DATA_SIZE_UINT16:
+		*present_reading = reading.value.value_u16;
+		break;
+	case PLDM_SENSOR_DATA_SIZE_SINT16:
+		*present_reading = (uint32_t)(int32_t)reading.value.value_s16;
+		break;
+	case PLDM_SENSOR_DATA_SIZE_UINT32:
+		*present_reading = reading.value.value_u32;
+		break;
+	case PLDM_SENSOR_DATA_SIZE_SINT32:
+		*present_reading = (uint32_t)reading.value.value_s32;
+		break;
+	default:
+		return PLDM_ERROR_INVALID_DATA;
+	}
+
+	return PLDM_SUCCESS;
+}
+
+LIBPLDM_ABI_TESTING
+int decode_numeric_sensor_data_to_value(
+	const uint8_t *sensor_data, size_t sensor_data_length,
+	uint8_t *event_state, uint8_t *previous_event_state,
+	struct pldm_numeric_sensor_value *present_reading)
 {
 	PLDM_MSGBUF_RO_DEFINE_P(buf);
 	int rc;
 
-	if (sensor_data == NULL || sensor_data_size == NULL ||
-	    event_state == NULL || previous_event_state == NULL ||
-	    present_reading == NULL) {
-		return PLDM_ERROR_INVALID_DATA;
+	if (sensor_data == NULL || event_state == NULL ||
+	    previous_event_state == NULL || present_reading == NULL) {
+		return -EINVAL;
 	}
 
 	if (sensor_data_length >
 	    PLDM_SENSOR_EVENT_NUMERIC_SENSOR_STATE_MAX_DATA_LENGTH) {
-		return PLDM_ERROR_INVALID_LENGTH;
+		return -EOVERFLOW;
 	}
 
 	rc = pldm_msgbuf_init_errno(
 		buf, PLDM_SENSOR_EVENT_NUMERIC_SENSOR_STATE_MIN_DATA_LENGTH,
 		sensor_data, sensor_data_length);
 	if (rc) {
-		return pldm_xlate_errno(rc);
+		return rc;
 	}
 
 	pldm_msgbuf_extract_p(buf, event_state);
 	pldm_msgbuf_extract_p(buf, previous_event_state);
-	rc = pldm_msgbuf_extract_p(buf, sensor_data_size);
+	rc = pldm_msgbuf_extract(buf, present_reading->sensor_data_size);
 	if (rc) {
-		return pldm_xlate_errno(pldm_msgbuf_discard(buf, rc));
+		return pldm_msgbuf_discard(buf, rc);
 	}
 
-	/*
-	 * The implementation below is bonkers, but it's because the function
-	 * prototype is bonkers. The `present_reading` argument should have been
-	 * a tagged union.
-	 */
-	switch (*sensor_data_size) {
-	case PLDM_SENSOR_DATA_SIZE_UINT8: {
-		uint8_t val;
-		if (!pldm_msgbuf_extract(buf, val)) {
-			*present_reading = (uint32_t)val;
-		}
-		break;
-	}
-	case PLDM_SENSOR_DATA_SIZE_SINT8: {
-		int8_t val;
-		if (!pldm_msgbuf_extract(buf, val)) {
-			*present_reading = (uint32_t)(int32_t)val;
-		}
-		break;
+	if (present_reading->sensor_data_size > PLDM_SENSOR_DATA_SIZE_MAX) {
+		return pldm_msgbuf_discard(buf, -EINVAL);
 	}
-	case PLDM_SENSOR_DATA_SIZE_UINT16: {
-		uint16_t val;
-		if (!pldm_msgbuf_extract(buf, val)) {
-			*present_reading = (uint32_t)val;
-		}
-		break;
-	}
-	case PLDM_SENSOR_DATA_SIZE_SINT16: {
-		int16_t val;
-		if (!pldm_msgbuf_extract(buf, val)) {
-			*present_reading = (uint32_t)(int32_t)val;
-		}
-		break;
-	}
-	case PLDM_SENSOR_DATA_SIZE_UINT32: {
-		uint32_t val;
-		if (!pldm_msgbuf_extract(buf, val)) {
-			*present_reading = (uint32_t)val;
-		}
-		break;
-	}
-	case PLDM_SENSOR_DATA_SIZE_SINT32: {
-		int32_t val;
-		if (!pldm_msgbuf_extract(buf, val)) {
-			*present_reading = (uint32_t)val;
-		}
-		break;
-	}
-	default:
-		return pldm_msgbuf_discard(buf, PLDM_ERROR_INVALID_DATA);
+
+	rc = pldm_msgbuf_extract_sensor_data64(
+		buf, present_reading->sensor_data_size,
+		&present_reading->value);
+	if (rc) {
+		return pldm_msgbuf_discard(buf, rc);
 	}
 
 	rc = pldm_msgbuf_complete_consumed(buf);
 	if (rc) {
-		return pldm_xlate_errno(rc);
+		return rc;
 	}
 
-	return PLDM_SUCCESS;
+	return 0;
 }
 
