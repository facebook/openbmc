From: Frank Chen <FrankChen4@quantatw.com>
Date: Mon, 5 Jan 2026 15:38:53 +0800
Subject: [PATCH 1003/1008] enable uart dma

---
 .../boot/dts/aspeed/aspeed-bmc-facebook-santabarbara.dts   | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-santabarbara.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-santabarbara.dts
index 3c400c09f..8b3831515 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-santabarbara.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-santabarbara.dts
@@ -2941,13 +2941,20 @@ flash@0 {
 	};
 };
 
+&udma {
+	status = "okay";
+};
+
 // HOST BIOS Debug
 &uart1 {
 	status = "okay";
 };
 
 &uart3 {
+	compatible = "aspeed,ast2600-uart";
 	status = "okay";
+	dmas = <&udma 4>, <&udma 5>;
+	dma-names = "tx", "rx";
 };
 
 &uart4 {
