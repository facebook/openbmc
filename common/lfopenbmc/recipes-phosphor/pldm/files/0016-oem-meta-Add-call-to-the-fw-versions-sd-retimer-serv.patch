From 59d09240c408fc4a2d5f2299848d9cf6f8c12b15 Mon Sep 17 00:00:00 2001
From: Sora Su <baxiche@gmail.com>
Date: Thu, 23 Oct 2025 14:34:12 +0800
Subject: [PATCH 16/20] oem-meta: Add call to the fw-versions-sd-retimer
 service

The fw-versions-sd-retimer service is triggered by the POST_COMPLETED
and POST_ENDED events. This is a downstream-only implementation, as
the service is not supported upstream.

Change-Id: Iffcf7ac3473689785fcd44b38081f52533dac552
Signed-off-by: Sora Su <baxiche@gmail.com>
Upstream-Status: Inappropriate
---
 .../file_io_type_event_log.cpp                | 22 ++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/oem/meta/libpldmresponder/file_io_type_event_log.cpp b/oem/meta/libpldmresponder/file_io_type_event_log.cpp
index 9414edd..45902cb 100644
--- a/oem/meta/libpldmresponder/file_io_type_event_log.cpp
+++ b/oem/meta/libpldmresponder/file_io_type_event_log.cpp
@@ -729,6 +729,25 @@ static void reportError(const message&, const std::string& event,
 {
     pldm::utils::reportError(event.c_str());
 }
+
+static void updateRetimerFwVersion(const message&, const std::string&,
+                                   const std::string& slotNum)
+{
+    static constexpr auto SYSTEMD_SERVICE = "org.freedesktop.systemd1";
+    static constexpr auto SYSTEMD_ROOT = "/org/freedesktop/systemd1";
+    static constexpr auto SYSTEMD_INTERFACE =
+        "org.freedesktop.systemd1.Manager";
+
+    /* The retimer is not available temporary after fw update.
+       We should update fw version on d-bus when post-complete. */
+    auto bus = sdbusplus::bus::new_default();
+    auto method = bus.new_method_call(SYSTEMD_SERVICE, SYSTEMD_ROOT,
+                                      SYSTEMD_INTERFACE, "StartUnit");
+    auto service = std::string("fw-versions-sd-retimer@") + slotNum +
+                   ".service";
+    method.append(service, "replace");
+    bus.call_noreply(method);
+}
 } // namespace report
 
 namespace format
@@ -815,7 +834,7 @@ static const std::map<EventType, EventDescriptor> eventHandlers = {
     {EventType::SYS_THROTTLE, {report::reportError, nullptr}},
     {EventType::VR_FAULT, {report::reportError, format::vrFault}},
     {EventType::SYSTEM_MANAGEMENT_ERROR, {report::reportError, nullptr}},
-    {EventType::POST_COMPLETED, {report::reportError, nullptr}},
+    {EventType::POST_COMPLETED, {report::updateRetimerFwVersion, nullptr}},
     {EventType::FAN_ERROR, {report::reportError, nullptr}},
     {EventType::HDT_PRSNT_ASSERTION, {report::reportError, nullptr}},
     {EventType::APML_ALERT_ASSERTION, {report::reportError, nullptr}},
@@ -827,6 +846,7 @@ static const std::map<EventType, EventDescriptor> eventHandlers = {
     {EventType::OS_LOAD_WDT_PWR_DOWN, {report::reportError, nullptr}},
     {EventType::OS_LOAD_WDT_PWR_CYCLE, {report::reportError, nullptr}},
     {EventType::POST_TIMEOUTED, {report::reportError, nullptr}},
+    {EventType::POST_ENDED, {report::updateRetimerFwVersion, nullptr}},
 };
 
 static void checkEventAssert(const message& eventData, std::string& event,
