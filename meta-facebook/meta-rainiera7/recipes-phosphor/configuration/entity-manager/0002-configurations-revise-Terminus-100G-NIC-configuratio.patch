From c9b836ae596b2715eb0762c2b640b0a235e84827 Mon Sep 17 00:00:00 2001
From: Alan Tsai <alan-tsai@quantatw.com>
Date: Thu, 20 Aug 2026 21:52:38 +0800
Subject: [PATCH] configurations: revise Terminus 100G NIC configuration.

Add an MCTPI2CTarget entry to allow MCTPReactor to automatically
assign an EID to the BRCM NIC over I2C, removing the need for manual
EID configuration.

Update thresholds

Tested on Rainiera7:
- EID is correctly assigned
- Version object is properly exposed
- Temperature sensor threshold is exposed correct value.
---
 .../meta/terminus_100g_nic_tsff.json          | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/configurations/meta/terminus_100g_nic_tsff.json b/configurations/meta/terminus_100g_nic_tsff.json
index e4f92d7..46112a1 100644
--- a/configurations/meta/terminus_100g_nic_tsff.json
+++ b/configurations/meta/terminus_100g_nic_tsff.json
@@ -3,7 +3,7 @@
         {
             "Address": "$address",
             "Bus": "$bus",
-            "Name": "Terminus NIC FRU $bus",
+            "Name": "Terminus NIC FRU 0",
             "Type": "EEPROM"
         },
         {
@@ -12,8 +12,15 @@
             "Labels": [
                 "temp1"
             ],
-            "Name": "NIC TEMP $bus",
+            "Name": "NIC0_TEMP_C",
             "Thresholds": [
+                {
+                    "Direction": "less than",
+                    "Index": 2,
+                    "Name": "lower critical",
+                    "Severity": 1,
+                    "Value": 5
+                },
                 {
                     "Direction": "greater than",
                     "Index": 1,
@@ -30,9 +37,15 @@
                 }
             ],
             "Type": "EMC1403"
+        },
+        {
+            "Address": "0x32",
+            "Bus": "$bus",
+            "Name": "NIC",
+            "Type": "MCTPI2CTarget"
         }
     ],
-    "Name": "Terminus NIC FRU $bus",
+    "Name": "Terminus NIC FRU 0",
     "Probe": "xyz.openbmc_project.FruDevice({'BOARD_PRODUCT_NAME': 'Terminus .*100G NIC TSFF'})",
     "Type": "Board",
     "xyz.openbmc_project.Inventory.Decorator.Asset": {
-- 
2.53.0-Meta

