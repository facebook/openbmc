 drivers/soc/aspeed/ast2700-otp.c        | 565 +++++++++++++++++++++
 include/uapi/linux/otp_ast2600.h        |  39 ++
 include/uapi/linux/otp_ast2700.h        |  47 ++
 7 files changed, 1296 insertions(+)
