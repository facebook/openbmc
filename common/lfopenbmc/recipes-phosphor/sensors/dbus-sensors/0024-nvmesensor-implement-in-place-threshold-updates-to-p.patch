---
 src/nvme/NVMeContext.hpp    |  5 +++
 src/nvme/NVMeSensorMain.cpp | 61 ++++++++++++++++++++++++++++++++++---
 2 files changed, 62 insertions(+), 4 deletions(-)

diff --git a/src/nvme/NVMeContext.hpp b/src/nvme/NVMeContext.hpp
index cb5d062..33a0f32 100644
--- a/src/nvme/NVMeContext.hpp
+++ b/src/nvme/NVMeContext.hpp
@@ -37,6 +37,11 @@ class NVMeContext : public std::enable_shared_from_this<NVMeContext>
         sensors.emplace_back(sensor);
     }
 
+    const std::list<std::shared_ptr<NVMeSensor>>& getSensors() const
+    {
+        return sensors;
+    }
+
     std::optional<std::shared_ptr<NVMeSensor>> getSensorAtPath(
         const std::string& path)
     {
diff --git a/src/nvme/NVMeSensorMain.cpp b/src/nvme/NVMeSensorMain.cpp
index f4e2e49..3612d7e 100644
--- a/src/nvme/NVMeSensorMain.cpp
+++ b/src/nvme/NVMeSensorMain.cpp
@@ -159,20 +159,25 @@ static std::shared_ptr<NVMeContext> provideRootBusContext(
     return context;
 }
 
+static bool firstScan = true;
+
 static void handleSensorConfigurations(
     boost::asio::io_context& io, sdbusplus::asio::object_server& objectServer,
     std::shared_ptr<sdbusplus::asio::connection>& dbusConnection,
     const ManagedObjectType& sensorConfigurations)
 {
     // todo: it'd be better to only update the ones we care about
-    for (const auto& [_, nvmeContextPtr] : nvmeDeviceMap)
+    if (firstScan)
     {
-        if (nvmeContextPtr)
+        for (const auto& [_, nvmeContextPtr] : nvmeDeviceMap)
         {
-            nvmeContextPtr->close();
+            if (nvmeContextPtr)
+            {
+                nvmeContextPtr->close();
+            }
         }
+        nvmeDeviceMap.clear();
     }
-    nvmeDeviceMap.clear();
 
     // iterate through all found configurations
     for (const auto& [interfacePath, sensorData] : sensorConfigurations)
@@ -198,6 +203,53 @@ static void handleSensorConfigurations(
             continue;
         }
 
+        // on rescan, update thresholds in-place to preserve assertedLog state
+        if (!firstScan)
+        {
+            bool found = false;
+            for (const auto& [_, context] : nvmeDeviceMap)
+            {
+                for (auto& sensor : context->getSensors())
+                {
+                    if (sensor->name == escapeName(*sensorName))
+                    {
+                        std::vector<thresholds::Threshold> newThresholds;
+                        if (parseThresholdsFromConfig(sensorData,
+                                                     newThresholds))
+                        {
+                            auto& oldThresholds = sensor->thresholds;
+                            for (const auto& newTh : newThresholds)
+                            {
+                                for (auto& oldTh : oldThresholds)
+                                {
+                                    if (newTh.level == oldTh.level &&
+                                        newTh.direction == oldTh.direction)
+                                    {
+                                        oldTh.value = newTh.value;
+                                    }
+                                }
+                            }
+                            thresholds::updateThresholds(sensor.get());
+                            lg2::info(
+                                "NVMeSensor {NAME} thresholds updated in-place to preserve state",
+                                "NAME", *sensorName);
+                        }
+                        found = true;
+                        break;
+                    }
+                }
+                if (found)
+                {
+                    break;
+                }
+            }
+            if (found)
+            {
+                continue;
+            }
+            // sensor not found, fall through to create it
+        }
+
         std::vector<thresholds::Threshold> sensorThresholds;
         if (!parseThresholdsFromConfig(sensorData, sensorThresholds))
         {
@@ -238,6 +290,7 @@ static void handleSensorConfigurations(
     {
         context->pollNVMeDevices();
     }
+    firstScan = false;
 }
 
 void createSensors(boost::asio::io_context& io,
