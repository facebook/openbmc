{
    "bios" : {
        "priority" : 1,
        "upgrade_cmd" : "/usr/local/bin/bios_util.sh write {filename} --init-aconf",
        "get_version": "/usr/local/bin/bios_ver.sh"
    },
    "scm" : {
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh scm program {filename}",
        "post_action" : "/usr/local/bin/dpeCheck.sh dpe",
        "priority" : 2
    },
    "smb" : {
        "get_version" : "/usr/local/bin/fpga_ver.sh | grep SMB_FPGA | cut -f 2 -d ' '",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh smb program {filename}",
        "priority" : 3
    },
    "smb_cpld" : {
        "get_version" : "/usr/local/bin/fpga_ver.sh | grep SMB_CPLD | cut -f 2 -d ' '",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh smb_cpld program {filename}",
        "priority" : 4
    },
    "fan" : {
        "get_version" : "/usr/local/bin/fpga_ver.sh | grep FAN_FPGA | cut -f 2 -d ' '",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh fan program {filename}",
        "priority" : 5
    },
    "th4_qspi" : {
        "get_version" : "/usr/local/bin/th4_qspi_ver.sh | grep FIRMWARE_STRING_VERSION | cut -f 2 -d ' '",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh th4_qspi program {filename}",
        "post_action" : "/usr/local/bin/wedge_power.sh reset",
        "priority" : 5
    },
    "pim_base" : {
        "get_version" : "/usr/local/bin/spi_pim_ver.sh | grep 'HEADER_PIM_BASE: [^NOT]' | cut -f 2 -d ' ' | uniq",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh pim_base program {filename}",
        "post_action" : "/usr/local/bin/wedge_power.sh pimreset -a",
        "priority" : 5
    },
    "pim16q" : {
        "get_version" : "/usr/local/bin/spi_pim_ver.sh | grep 'HEADER_PIM16Q: [^NOT]' | cut -f 2 -d ' ' | uniq",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh pim16q program {filename}",
        "post_action" : "/usr/local/bin/wedge_power.sh pimreset -a; sleep 15;",
        "priority" : 6
    },
    "pim8ddm" : {
        "get_version" : "/usr/local/bin/spi_pim_ver.sh | grep 'HEADER_PIM8DDM: [^NOT]' | cut -f 2 -d ' ' | uniq",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh pim8ddm program {filename}",
        "post_action" : "/usr/local/bin/wedge_power.sh pimreset -a; sleep 15;",
        "priority" : 6
    }
}
