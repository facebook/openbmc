From 60e9120cbdccb7217b8a4e9ba79bc8e3a5f55224 Mon Sep 17 00:00:00 2001
From: Fred Zhang <fred.zhang@quantatw.com>
Date: Fri, 2 Oct 2026 07:49:28 +0000
Subject: [PATCH 1/3] fru-device: avoid recreating unchanged FRU interfaces

fru-device performs a second bus scan after host power-on to discover
power-gated FRUs. publishFruOnBusAddress() previously removed and
recreated the FRU interface for every address on every rescan, even
when the FRU contents were unchanged.

This generated unnecessary InterfacesRemoved/InterfacesAdded signals for
every published FRU. Consumers observing those signals could temporarily
treat unchanged devices as removed, causing downstream inventory
teardown and recreation. On Ventura RMC this intermittently caused the
SCM inventory subtree to be removed and recreated, leading to duplicate
cooling-related events during a single AC cycle.

Track the published FRU contents in FruDetails and skip republishing an
address whose freshly read data matches what is already published. The
cache is updated alongside dbusInterfaceMap: addFruObjectToDbus() writes
it when publishing an interface, and every interface removal erases it.
Interfaces are still removed when a device or bus disappears, so
hot-plug behavior is unchanged.

Tested:
- AC power-cycle stress on two Ventura RMC systems that previously
  reproduced the issue
- No unexpected SCM inventory remove/add operations
- No duplicate cooling events observed
- Physical FRU insertion/removal still updates inventory correctly

Change-Id: I55d2453c1c109485fc4e938f34fc8338fabe4968
Signed-off-by: Fred Zhang <fred.zhang@quantatw.com>

[1] Gerrit: https://gerrit.openbmc.org/c/openbmc/entity-manager/+/92584
---
 src/fru_device/fru_device.cpp | 16 ++++++++++++++--
 src/fru_device/fru_device.hpp |  6 ++++++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/fru_device/fru_device.cpp b/src/fru_device/fru_device.cpp
index 529a6be7..10d24135 100644
--- a/src/fru_device/fru_device.cpp
+++ b/src/fru_device/fru_device.cpp
@@ -908,6 +908,7 @@ void addFruObjectToDbus(std::vector<uint8_t>& device, FruDetails& fruDetails,
         objServer.add_interface(productName, "xyz.openbmc_project.FruDevice");
     fruDetails.dbusInterfaceMap[std::pair<size_t, size_t>(bus, address)] =
         iface;
+    fruDetails.publishedFru[std::pair<size_t, size_t>(bus, address)] = device;
 
     if (ENABLE_FRU_UPDATE_PROPERTY)
     {
@@ -1198,6 +1199,7 @@ static void clearDBusInterfacesForBus(
             !(skipAddresses.contains(ifaceAddress)))
         {
             objServer.remove_interface(busIface->second);
+            fruDetails.publishedFru.erase(key);
             busIface = fruDetails.dbusInterfaceMap.erase(busIface);
         }
         else
@@ -1211,15 +1213,24 @@ static void publishFruOnBusAddress(
     std::vector<uint8_t>& device, uint16_t busNum, uint8_t address,
     FruDetails& fruDetails, sdbusplus::asio::object_server& objServer)
 {
-    // clear our interface here if there is any
-
     const std::pair<size_t, size_t> key = {busNum, address};
 
+    // Skip republishing when the FRU contents are unchanged, to avoid an
+    // InterfacesRemoved/InterfacesAdded churn that consumers (e.g.
+    // EntityManager) may react to by tearing down and recreating inventory.
+    auto cached = fruDetails.publishedFru.find(key);
+    if (cached != fruDetails.publishedFru.end() && cached->second == device)
+    {
+        return;
+    }
+
+    // clear our interface here if there is any
     auto iface = fruDetails.dbusInterfaceMap.find(key);
 
     if (iface != fruDetails.dbusInterfaceMap.end())
     {
         objServer.remove_interface(iface->second);
+        fruDetails.publishedFru.erase(key);
         fruDetails.dbusInterfaceMap.erase(iface);
     }
 
@@ -1307,6 +1318,7 @@ static void publishAllFrus(BusMap& busmap, FruDetails& fruDetails,
         if (!(busesCovered.contains(ifaceBus)) && !isNfcFru(ifaceBus))
         {
             objServer.remove_interface(busIface->second);
+            fruDetails.publishedFru.erase(key);
             busIface = fruDetails.dbusInterfaceMap.erase(busIface);
         }
         else
diff --git a/src/fru_device/fru_device.hpp b/src/fru_device/fru_device.hpp
index 4b82c635..fee1bfc4 100644
--- a/src/fru_device/fru_device.hpp
+++ b/src/fru_device/fru_device.hpp
@@ -12,11 +12,17 @@
 #include <set>
 #include <vector>
 
+// Cache of the FRU contents currently published on dbus.
+// Key: pair(bus number, address). Value: the FRU bytes last published for it.
+using PublishedFruMap =
+    std::flat_map<std::pair<size_t, size_t>, std::vector<uint8_t>>;
+
 // Runtime state shared by the fru-device scan/publish paths. All members
 // share the same lifetime (owned by main()) and are always passed together.
 struct FruDetails
 {
     DBusIntfMap dbusInterfaceMap;
+    PublishedFruMap publishedFru;
     size_t unknownBusObjectCount = 0;
     bool powerIsOn = false;
     std::set<size_t> addressBlocklist;
-- 
