[Unit]
Description=Run postcode-mond in OpenBMC
After=setup_i2c.service setup_gpio.service
Wants=setup_i2c.service setup_gpio.service

# Please replace ExecStart with the following path:
# /usr/local/bin/postcode-mond -I <INPUT_PATH>
[Service]
ExecStart=/usr/local/bin/postcode-mond -I /dev/aspeed-lpc-snoop0
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
