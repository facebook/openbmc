From 313588f2582dc43dd16c8b36102c6b71927ce240 Mon Sep 17 00:00:00 2001
From: Colin Huang <colin.huang2@amd.com>
Date: Wed, 8 Apr 2026 15:44:47 +0800
Subject: [PATCH] ARM: dts: aspeed: anacapa: evt2: add lpc_pcc device

Add lpc_pcc node for AMD post code

There is no lpc_pcc driver in upstream,
so it only patch in Meta tree.

Signed-off-by: Colin Huang <colin.huang2@amd.com>
---
 .../dts/aspeed/aspeed-bmc-facebook-anacapa-evt2.dts    | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-anacapa-evt2.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-anacapa-evt2.dts
index 6e1e51e6c3f2..855c3058fee2 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-anacapa-evt2.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-anacapa-evt2.dts
@@ -884,6 +884,16 @@ &lpc_ctrl {
 	status = "okay";
 };
 
+&lpc_pcc {
+	rec-mode = <0x1>;
+	port-addr = <0x80>;
+	port-addr-hbits-select = <0x1>;
+	port-addr-xbits = <0x3>;
+	dma-mode;
+	A2600-15;
+	status = "okay";
+};
+
 &mac2 {
 	status = "okay";
 	pinctrl-names = "default";
-- 
2.52.0

