          │ ├─ /xyz/openbmc_project/inventory/system/board/NVIDIA_VR_NVL72_IO_Board_0/IOB0_NIC1_TEMP_C
          │ ├─ /xyz/openbmc_project/inventory/system/board/NVIDIA_VR_NVL72_IO_Board_1/IOB1_NIC0_OSFP_TEMP_C
          │ ├─ /xyz/openbmc_project/inventory/system/board/NVIDIA_VR_NVL72_IO_Board_1/IOB1_NIC0_PWR_W
