+nlohmann::json buildRuntimeMetadataPayload(const nlohmann::json& metadata)
+{
+    nlohmann::json oem;
+    for (const auto& [name, value] : metadata.items())
+    {
+        oem[name] = value.dump();
+    }
+
+    return {{"Oem", std::move(oem)}};
+}
