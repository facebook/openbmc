{
    "bios" : {
        "get_version" : "/usr/local/bin/bios_ver.sh",
        "priority" : 1,
        "upgrade_cmd" : "/usr/local/bin/bios_util.sh write {filename} --init-aconf"
    },
    "dawson" : {
        "get_version" : "/usr/local/bin/fpga_ver.sh |grep SUP_FPGA|cut -d ' ' -f 2",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh sup program {filename}",
        "priority": 2
    },
    "livingston" : {
        "get_version" : "/usr/local/bin/fpga_ver.sh |grep SCD_FPGA|cut -d ' ' -f 2",
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh scd program {filename}",
        "priority": 3
    },
    "sperry" : {
      "entities" : ["1", "2", "3", "4", "5", "6", "7", "8"],
        "condition": "/usr/local/bin/fpga_ver.sh | grep PIM |  awk 'NR==2' | cut -d ' ' -f 4",
        "get_version" : "/usr/local/bin/fpga_ver.sh|grep PIM|awk 'NR=={entity} + 5'|cut -d ' ' -f 4",
        "continue_on_error" : true,
        "upgrade_cmd" : "/usr/local/bin/fpga_util.sh lc{entity} program {filename}",
        "post_action" : "/usr/local/bin/wedge_power.sh lcreset -a; sleep 30",
        "priority": 4
    }
}
