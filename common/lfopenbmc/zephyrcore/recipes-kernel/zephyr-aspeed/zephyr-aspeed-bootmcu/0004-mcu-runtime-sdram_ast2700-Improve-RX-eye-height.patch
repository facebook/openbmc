 .../ast2700/dwc_ddrphy_phyinit_ddr5-3200-nodimm-train2D.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/apps/mcu-runtime/soc/ast2700/dwc_ddrphy_phyinit_ddr5-3200-nodimm-train2D.c b/apps/mcu-runtime/soc/ast2700/dwc_ddrphy_phyinit_ddr5-3200-nodimm-train2D.c
index c61303c..e1837d8 100644
--- a/apps/mcu-runtime/soc/ast2700/dwc_ddrphy_phyinit_ddr5-3200-nodimm-train2D.c
+++ b/apps/mcu-runtime/soc/ast2700/dwc_ddrphy_phyinit_ddr5-3200-nodimm-train2D.c
@@ -4228,10 +4228,10 @@ dwc_ddrphy_apb_wr(0x200fd, 0xf5); // DWC_DDRPHYA_MASTER0_base0_DqPreamblePattern
 dwc_ddrphy_apb_wr(0x2003a, 0x2); // DWC_DDRPHYA_MASTER0_base0_DbyteDllModeCntrl
