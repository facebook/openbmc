+// Initial D-Bus property values
+constexpr AnalogValveIntf::Value::properties_t initValues{
+    std::numeric_limits<double>::quiet_NaN(), 100, 0,
+    AnalogValveIntf::Unit::Percent};
+constexpr AnalogValveIntf::Definitions::properties_t initAssociations{};
+constexpr AnalogValveIntf::Availability::properties_t initAvailability{true};
+constexpr AnalogValveIntf::OperationalStatus::properties_t initOperationalState{
+    true};
+constexpr AnalogValveControlIntf::Valve::properties_t initControl{
+    AnalogValveControlIntf::State::Close};
+constexpr AnalogValveControlIntf::Definitions::properties_t
+    initControlAssociations{};
+
+static auto getSensorObjectPath(std::string name)
+{
+    std::replace(name.begin(), name.end(), ' ', '_');
+    return (sdbusplus::message::object_path(
+                AnalogValveIntf::namespace_path::value) /
+            AnalogValveIntf::namespace_path::valve / name);
+}
+
+static auto getControlObjectPath(std::string name)
+{
+    std::replace(name.begin(), name.end(), ' ', '_');
+    return (sdbusplus::message::object_path(
+                AnalogValveControlIntf::namespace_path) /
+            name);
+}
+
+AnalogValve::AnalogValve(sdbusplus::async::context& ctx,
+                         sdbusplus::message::object_path& objectPath,
+                         Events& events,
+                         const config::AnalogValveConfig& config) :
+    AnalogValveIntf(ctx, getSensorObjectPath(config.name).str.c_str(),
+                    initValues, initAssociations, initAvailability,
+                    initOperationalState),
+    AnalogValveControlIntf(ctx, getControlObjectPath(config.name).str.c_str(),
+                           initControl, initControlAssociations),
+    ctx(ctx),
+    inventoryPath(std::filesystem::path(objectPath.str).parent_path().string()),
+    events(events), config(config),
+    feedback(std::make_unique<FeedbackADC>(
+        ctx, config.feedbackDevicePath, config.feedbackChannel,
+        config.feedbackGain, config.pollIntervalSec,
+        std::bind_front(&AnalogValve::onFeedbackVoltage, this))),
+    control(std::make_unique<ControlDAC>(
+        config.controlDevicePath, config.controlChannel, config.controlOffset,
+        config.controlScale)),
+    feedbackVolt(std::numeric_limits<double>::quiet_NaN()), cachedIsOpen(false)
+{
+    // Start feedback polling — reads initial value immediately, then loops
+    ctx.spawn(feedback->start());
+
+    Value::emit_added();
+    OperationalStatus::emit_added();
+    Availability::emit_added();
+    Valve::emit_added();
+
+    if (!config.reportCloseGpioLine.empty())
+    {
+        try
+        {
+            reportCloseGpio = gpiod::find_line(config.reportCloseGpioLine);
+            reportCloseGpio.request(
+                {"valve-monitor", gpiod::line_request::DIRECTION_OUTPUT, 0}, 1);
+        }
+        catch (const std::exception& e)
+        {
+            error("Failed to request GPIO {GPIO}: {ERR}", "GPIO",
+                  config.reportCloseGpioLine, "ERR", e);
+        }
+    }
+
+    info("Created analog valve {VALVE}", "VALVE", config.name);
+}
+
+AnalogValve::~AnalogValve()
+{
+    // Signal unavailability before the D-Bus object is removed
+    available(false);
+}
+
+auto AnalogValve::get_property(state_t /*unused*/) const -> State
+{
+    debug("Getting {VALVE} state", "VALVE", config.name);
+
+    auto dacRaw = control->getRaw();
+    if (!dacRaw)
+    {
+        // Failed to read DAC, fall back to last known state
+        return cachedIsOpen ? State::Open : State::Close;
+    }
+    bool dacIsClose =
+        *dacRaw <=
+        static_cast<long>(std::round(
+            (config.closeVolt - config.controlOffset) / config.controlScale));
+    return dacIsClose ? State::Close : State::Open;
+}
+
+auto AnalogValve::set_property(state_t /*unused*/, auto state) -> bool
+{
+    debug("Setting {VALVE} to {STATE}", "VALVE", config.name, "STATE",
+          convertStateToString(state));
+
+    // Select the pre-configured control voltage for the target state
+    double targetVolt =
+        (state == State::Open) ? config.openVolt : config.closeVolt;
+
+    info("Commanding valve {VALVE} to {STATE} — DAC target {VOLT}V", "VALVE",
+         config.name, "STATE", convertStateToString(state), "VOLT", targetVolt);
+
+    bool ok = control->setVoltage(targetVolt);
+    if (!ok)
+    {
+        error("ControlDAC write failed for valve {VALVE}", "VALVE",
+              config.name);
+    }
+    return ok;
+}
+
+bool AnalogValve::isOpenVoltage(double volt)
+{
+    // Hysteresis: shift the switching threshold based on current state to avoid
+    // toggling on ADC noise. Dead band = 2 * tolerance around openThreshold.
+    if (cachedIsOpen)
+    {
+        cachedIsOpen = volt >=
+                       (config.openThreshold - config.feedbackTolerance);
+    }
+    else
+    {
+        cachedIsOpen = volt >=
+                       (config.openThreshold + config.feedbackTolerance);
+    }
+    return cachedIsOpen;
+}
+
+auto AnalogValve::onFeedbackVoltage(double volt) -> sdbusplus::async::task<>
+{
+    // Clamp only for percentage calculation, keep raw volt for
+    // logging/detection
+    double clampedVolt = std::clamp(volt, config.minVolt, config.maxVolt);
+
+    double scale = 100.0 / (config.maxVolt - config.minVolt);
+    double percentage = (clampedVolt - config.minVolt) * scale;
+
+    bool wasOpen = this->cachedIsOpen;
+    bool isOpen = isOpenVoltage(volt);
+    bool firstRead = std::isnan(this->feedbackVolt);
+    bool stateChanged = (isOpen != wasOpen);
+    bool voltChanged = std::abs(volt - this->feedbackVolt) >=
+                       config.feedbackTolerance;
+
+    if (firstRead || voltChanged || stateChanged)
+    {
+        auto getTimestamp = []() -> std::string {
+            auto now = std::chrono::system_clock::now();
+            auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                          now.time_since_epoch()) %
+                      1000;
+            auto t = std::chrono::system_clock::to_time_t(now);
+            std::tm tm{};
+            localtime_r(&t, &tm);
+            char buf[32];
+            std::strftime(buf, sizeof(buf), "%H:%M:%S", &tm);
+            return std::string(buf) + "." + std::to_string(ms.count());
+        };
+
+        debug(
+            "[{TS}] Valve {VALVE}: {PREV}V -> {VOLT}V ({PCT}%) (threshold {THR}V ±{TOL}V) -> {STATE}",
+            "TS", getTimestamp(), "VALVE", config.name, "PREV",
+            std::isnan(this->feedbackVolt) ? 0.0 : this->feedbackVolt, "VOLT",
+            volt, "PCT", percentage, "THR", config.openThreshold, "TOL",
+            config.feedbackTolerance, "STATE", isOpen ? "Open" : "Close");
+
+        this->feedbackVolt = volt;
+        this->value(percentage);
+
+        if (firstRead || stateChanged)
+        {
+            co_await events.generateValveEvent(inventoryPath, isOpen);
+
+            if (reportCloseGpio.is_requested())
+            {
+                try
+                {
+                    reportCloseGpio.set_value(isOpen ? 0 : 1);
+                    debug("Report GPIO {GPIO} -> {VAL}", "GPIO",
+                          config.reportCloseGpioLine, "VAL", isOpen ? 0 : 1);
+                }
+                catch (const std::exception& e)
+                {
+                    error("Failed to set GPIO {GPIO}: {ERR}", "GPIO",
+                          config.reportCloseGpioLine, "ERR", e.what());
+                }
+            }
+        }
+    }
+    co_return;
+}
+
+// ── associations
+// ──────────────────────────────────────────────────────────────
+
+auto AnalogValve::createAssociations() -> sdbusplus::async::task<>
+{
+    co_await createSensorAssociations();
+    createControlAssociations();
+    co_return;
+}
+
+using association_t = std::tuple<std::string, std::string, std::string>;
+using association_list_t = std::vector<association_t>;
+
+auto AnalogValve::createSensorAssociations() -> sdbusplus::async::task<>
+{
+    association_list_t associationList;
+    std::string parent = inventoryPath;
+
+    associationList.emplace_back("inventory", "sensors", inventoryPath);
+
+    auto res = co_await valve::utils::getContainingChassis(ctx, parent);
+    associationList.emplace_back("chassis", "all_sensors",
+                                 res.value_or(parent));
+
+    AnalogValveIntf::associations(associationList);
+    AnalogValveIntf::Definitions::emit_added();
+    co_return;
+}
+
+auto AnalogValve::createControlAssociations() -> void
+{
+    association_list_t associationList;
+    associationList.emplace_back("controlling", "controlled_by", inventoryPath);
+    AnalogValveControlIntf::associations(associationList);
+    AnalogValveControlIntf::Definitions::emit_added();
+}
+
+} // namespace valve
