-    i2cDevice(i2cDevice), objServer(objectServer),
+    i2cDevice(i2cDevice), bridgeGpio(std::move(bridgeGpio)),
+    objServer(objectServer),
     inputDev(io, path, boost::asio::random_access_file::read_only),
     waitTimer(io), path(path), sensorFactor(factor), sensorOffset(offset),
     thresholdTimer(io)
@@ -170,9 +173,34 @@ void PSUSensor::setupRead()
     }
 
     std::weak_ptr<PSUSensor> weak = weak_from_this();
-    inputDev.async_read_some_at(
-        0, boost::asio::buffer(buffer),
-        std::bind_front(&PSUSensor::handleResponseStatic, weak_from_this()));
+
+    if (bridgeGpio.has_value())
+    {
+        bridgeGpio->set(1);
+
+        waitTimer.expires_after(
+            std::chrono::milliseconds(bridgeGpio->setupTimeMs));
+        waitTimer.async_wait(
+            [weak](const boost::system::error_code& ec) {
+                std::shared_ptr<PSUSensor> self = weak.lock();
+                if (!self || ec == boost::asio::error::operation_aborted)
+                {
+                    return;
+                }
+
+                self->inputDev.async_read_some_at(
+                    0, boost::asio::buffer(self->buffer),
+                    std::bind_front(&PSUSensor::handleResponseStatic,
+                                    self->weak_from_this()));
+            });
+    }
+    else
+    {
+        inputDev.async_read_some_at(
+            0, boost::asio::buffer(buffer),
+            std::bind_front(&PSUSensor::handleResponseStatic,
+                            weak_from_this()));
+    }
 }
 
 void PSUSensor::restartRead()
@@ -234,6 +262,11 @@ void PSUSensor::handleResponse(const boost::system::error_code& err,
         updateValue((rawValue / sensorFactor) + sensorOffset);
     }
 
+    if (bridgeGpio)
+    {
+        (*bridgeGpio).set(0);
+    }
+
     restartRead();
 }
 
diff --git a/src/psu/PSUSensor.hpp b/src/psu/PSUSensor.hpp
index b84e1ee..f758470 100644
--- a/src/psu/PSUSensor.hpp
+++ b/src/psu/PSUSensor.hpp
@@ -8,16 +8,82 @@
 #include <boost/asio/io_context.hpp>
 #include <boost/asio/random_access_file.hpp>
 #include <boost/asio/steady_timer.hpp>
+#include <gpiod.hpp>
+#include <phosphor-logging/lg2.hpp>
 #include <sdbusplus/asio/connection.hpp>
 #include <sdbusplus/asio/object_server.hpp>
 
 #include <array>
+#include <bitset>
 #include <cstddef>
 #include <memory>
+#include <optional>
 #include <string>
+#include <system_error>
 #include <utility>
 #include <vector>
 
+class BridgeGpio
+{
+  public:
+    BridgeGpio(const std::string& name, int polarity, float setupTime) :
+        name(name),
+        polarity(polarity),
+        setupTimeMs(static_cast<unsigned int>(setupTime * 1000)),
+        requestFlags(polarity == gpiod::line::ACTIVE_HIGH ? std::bitset<32>(0) : gpiod::line_request::FLAG_ACTIVE_LOW)
+    {
+        line = gpiod::find_line(name);
+        if (!line)
+        {
+            lg2::error("Failed to find GPIO '{NAME}'", "NAME", name);
+            return;
+        }
+
+        if (line.is_used())
+        {
+            lg2::error("GPIO line '{NAME}' is already in use, skipping request", "NAME", name);
+            return;
+        }
+
+        try
+        {
+            line.request({"psusensor", gpiod::line_request::DIRECTION_OUTPUT, requestFlags});
+        }
+        catch (const std::system_error& e)
+        {
+            lg2::error("Failed to request GPIO '{NAME}': {REASON}", "NAME", name, "REASON", e.what());
+        }
+    }
+
+    void set(int value)
+    {
+        if (line)
+        {
+            try
+            {
+                if (!line.is_requested())
+                {
+                    line.request({"psusensor", gpiod::line_request::DIRECTION_OUTPUT, requestFlags});
+                }
+
+                line.set_value(value);
+            }
+            catch (const std::system_error& exc)
+            {
+                lg2::error("Failed to set GPIO '{NAME}' to {VALUE}: {EC}", "NAME", name, "VALUE", value, "EC", exc.what());
+            }
+        }
+    }
+
+    std::string name;
+    int polarity;
+    unsigned int setupTimeMs;
+    std::bitset<32> requestFlags;
+
+  private:
+    gpiod::line line;
+};
+
