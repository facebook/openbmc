From 147c421bc9f305dcebc9a2e14012d8970f5a12e3 Mon Sep 17 00:00:00 2001
From: Kimi Chen <kimi.zy.chen@fii-foxconn.com>
Date: Wed, 10 Sep 2025 12:45:37 +0800
Subject: [PATCH] configurations: nvidia_gb300: update sensor naming rule

The purpose of this patch is to modify the nvidia_gb300 configuration
file in the entity manager repo, changing the fan sensor names' PWM
unit to adhere to RF naming conventions.

This modification has already been committed to the upstream[1].
Since this modification concerns NVIDIA, it requires more time for
discussions with NVIDIA personnel and their review. Therefore,
this patch has been temporarily added to meet project requirements.

[1]:https://gerrit.openbmc.org/c/openbmc/entity-manager/+/83383
---
 configurations/nvidia_gb300.json | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/configurations/nvidia_gb300.json b/configurations/nvidia_gb300.json
index 5c11db6..b44256d 100644
--- a/configurations/nvidia_gb300.json
+++ b/configurations/nvidia_gb300.json
@@ -72,7 +72,7 @@
             "Connector": {
                 "Name": "FAN$bus - 1 % 2 * 4 + 0 TACH_IL",
                 "Pwm": 2,
-                "PwmName": "FAN$bus - 1 % 2 * 4 + 0 PWM",
+                "PwmName": "FAN$bus - 1 % 2 * 4 + 0 PWM_PCT",
                 "Tachs": [
                     4
                 ]
@@ -102,7 +102,7 @@
             "Connector": {
                 "Name": "FAN$bus - 1 % 2 * 4 + 0 TACH_OL",
                 "Pwm": 2,
-                "PwmName": "FAN$bus - 1 % 2 * 4 + 0 PWM",
+                "PwmName": "FAN$bus - 1 % 2 * 4 + 0 PWM_PCT",
                 "Tachs": [
                     5
                 ]
@@ -132,7 +132,7 @@
             "Connector": {
                 "Name": "FAN$bus - 1 % 2 * 4 + 1 TACH_IL",
                 "Pwm": 3,
-                "PwmName": "FAN$bus - 1 % 2 * 4 + 1 PWM",
+                "PwmName": "FAN$bus - 1 % 2 * 4 + 1 PWM_PCT",
                 "Tachs": [
                     10
                 ]
@@ -162,7 +162,7 @@
             "Connector": {
                 "Name": "FAN$bus - 1 % 2 * 4 + 1 TACH_OL",
                 "Pwm": 3,
-                "PwmName": "FAN$bus - 1 % 2 * 4 + 1 PWM",
+                "PwmName": "FAN$bus - 1 % 2 * 4 + 1 PWM_PCT",
                 "Tachs": [
                     11
                 ]
@@ -192,7 +192,7 @@
             "Connector": {
                 "Name": "FAN$bus - 1 % 2 * 4 + 2 TACH_IL",
                 "Pwm": 0,
-                "PwmName": "FAN$bus - 1 % 2 * 4 + 2 PWM",
+                "PwmName": "FAN$bus - 1 % 2 * 4 + 2 PWM_PCT",
                 "Tachs": [
                     0
                 ]
@@ -222,7 +222,7 @@
             "Connector": {
                 "Name": "FAN$bus - 1 % 2 * 4 + 2 TACH_OL",
                 "Pwm": 0,
-                "PwmName": "FAN$bus - 1 % 2 * 4 + 2 PWM",
+                "PwmName": "FAN$bus - 1 % 2 * 4 + 2 PWM_PCT",
                 "Tachs": [
                     1
                 ]
@@ -252,7 +252,7 @@
             "Connector": {
                 "Name": "FAN$bus - 1 % 2 * 4 + 3 TACH_IL",
                 "Pwm": 1,
-                "PwmName": "FAN$bus - 1 % 2 * 4 + 3 PWM",
+                "PwmName": "FAN$bus - 1 % 2 * 4 + 3 PWM_PCT",
                 "Tachs": [
                     2
                 ]
@@ -282,7 +282,7 @@
             "Connector": {
                 "Name": "FAN$bus - 1 % 2 * 4 + 3 TACH_OL",
                 "Pwm": 1,
-                "PwmName": "FAN$bus - 1 % 2 * 4 + 3 PWM",
+                "PwmName": "FAN$bus - 1 % 2 * 4 + 3 PWM_PCT",
                 "Tachs": [
                     3
                 ]
