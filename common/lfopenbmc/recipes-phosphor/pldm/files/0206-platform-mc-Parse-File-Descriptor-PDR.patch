+using FileID = uint16_t;
+
+enum class FileClassification : uint8_t
+{
+    OEM = 0x00,
+    BootLog,
+    SerialTxFIFO,
+    SerialRxFIFO,
+    DiagnosticLog,
+    CrashDumpFile,
+    SecurityLog,
+    FRUDataFile,
+    TelemetryDataFile,
+    TelemetryDataLog,
+    OtherLog = 0xFD,
+    OtherFile = 0xFE,
+    FileDirectory = 0xFF,
+};
