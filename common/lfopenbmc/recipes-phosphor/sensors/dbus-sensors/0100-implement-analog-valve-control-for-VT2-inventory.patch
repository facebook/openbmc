+#pragma once
+
+#include <sdbusplus/async.hpp>
+
+#include <optional>
+#include <string>
+
+namespace valve::utils
+{
+
+/** @brief Walk the object tree to find the chassis that contains objectPath.
+ *         Returns the chassis path, or nullopt if none is found. */
+auto getContainingChassis(sdbusplus::async::context& ctx,
+                          std::string& objectPath)
+    -> sdbusplus::async::task<std::optional<std::string>>;
+
+} // namespace valve::utils
