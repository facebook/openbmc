From de985757b3ea2dbf76f7ca38a69a1cea1b36885f Mon Sep 17 00:00:00 2001
From: Potin Lai <potin.lai.pt@gmail.com>
Date: Tue, 1 Sep 2026 16:19:01 +0800
Subject: [PATCH 1/1] ARM: dts: aspeed: clemente: Enable UDMA

The UDMA node was dropped in commit 7c7d3978006e ("ARM: dts: aspeed:
g6: Drop unspecified aspeed,ast2600-udma node"), but it is still
required by the Clemente platform.

Re-enable the udma node in Clemente DTS.

Signed-off-by: Potin Lai <potin.lai.pt@gmail.com>
---
 arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-clemente.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-clemente.dts b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-clemente.dts
index d338e397bc9f..210111b65fc0 100644
--- a/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-clemente.dts
+++ b/arch/arm/boot/dts/aspeed/aspeed-bmc-facebook-clemente.dts
@@ -1364,6 +1364,10 @@ &mac3 {
 	ncsi-package = <2>;
 };
 
+&udma {
+	status = "okay";
+};
+
 &uart1 {
 	status = "okay";
 };
-- 
2.52.0

