 extensions.hpp           | 64 +++++++++++++++++++++++++++++++++++++++-
 log_manager.cpp          | 41 +++++++++++++++++++++++++
 log_manager.hpp          | 26 ++++++++++++++++
 test/extensions_test.cpp | 30 +++++++++++++++++++
