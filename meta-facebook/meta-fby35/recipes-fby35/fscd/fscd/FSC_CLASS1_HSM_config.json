{
  "version": "CL_HSM_FSCV3.0",
  "pwm_transition_value": 80,
  "pwm_boost_value": 90,
  "non_fanfail_limited_boost_value": 100,
  "sample_interval_ms": 3000,
  "sensor_fail_ignore": true,
  "sensor_filter_all": true,
  "ramp_rate": 100,
  "boost": {
    "fan_fail": true,
    "sensor_fail": true
  },
  "multi_fan_fail": {
      "data": [
        [2, 100]
      ],
      "host_action": ["shutdown", 2]
  },
  "sensor_valid_check": {
    "(.*)fio_": {
      "attribute": {
        "type" : "power_status"
      }
    },
    "(.*)mb_": {
      "attribute": {
        "type" : "power_status"
      }
    },
    "(.*)e1s_": {
      "attribute": {
        "type" : "power_status"
      }
    },
    "(.*)dpv2_2_hsm_soc_temp_": {
      "attribute": {
        "type" : "power_status"
      }
    }
  },
  "watchdog": false,
  "min_rpm": 500,
