+using PortMetricsUriToDbusCallback =
+    std::function<void(const std::map<std::string, std::string>&)>;
+
+inline void afterPortMetricsUriToDbusMap(
+    const std::string& metricsUri, const PortMetricsUriToDbusCallback& callback,
+    const boost::system::error_code& ec,
+    const dbus::utility::MapperGetSubTreeResponse& object)
+{
+    std::map<std::string, std::string> uriToDbus;
+    if (ec)
+    {
+        BMCWEB_LOG_ERROR("DBus response error on GetAssociatedSubTree {}", ec);
+        callback(uriToDbus);
+        return;
+    }
+
+    for (const auto& [path, service] : object)
+    {
+        std::optional<std::string_view> jsonPointer =
+            getNicMetricJsonPointer(sdbusplus::object_path(path));
+        if (service.size() != 1 || !jsonPointer)
+        {
+            continue;
+        }
+        uriToDbus.emplace(std::format("{}#{}", metricsUri, *jsonPointer), path);
+    }
+    callback(uriToDbus);
+}
+
+inline void getPortMetricsUriToDbusMapFromPort(
+    const std::string& metricsUri, const PortMetricsUriToDbusCallback& callback,
+    const std::string& portPath, const std::string& /*serviceName*/)
+{
+    dbus::utility::getAssociatedSubTree(
+        sdbusplus::object_path(portPath) / "measured_by",
+        sdbusplus::object_path("/xyz/openbmc_project/metric"), 0,
+        std::array<std::string_view, 1>{"xyz.openbmc_project.Metric.Value"},
+        std::bind_front(afterPortMetricsUriToDbusMap, metricsUri, callback));
+}
+
+// Maps each PortMetrics property of one port, as
+// "<Metrics URI>#<JSON pointer>", to the Metric.Value object behind it.  Used
+// to resolve MetricReportDefinition MetricProperties.  If the adapter or port
+// doesn't exist the callback is never invoked, and the caller reports the
+// URIs as not found.
+inline void getPortMetricsUriToDbusMap(
+    const std::string& chassisId, const std::string& networkAdapterId,
+    const std::string& portId, PortMetricsUriToDbusCallback&& callback)
+{
+    // Lookup failures must not write to the caller's response.
+    auto lookupResp = std::make_shared<bmcweb::AsyncResp>();
+    std::string metricsUri =
+        boost::urls::format(
+            "/redfish/v1/Chassis/{}/NetworkAdapters/{}/Ports/{}/Metrics",
+            chassisId, networkAdapterId, portId)
+            .buffer();
+
+    getNetworkAdapterPath(
+        lookupResp, chassisId, networkAdapterId,
+        std::bind_front(
+            getAssociatedPortPath, lookupResp, portId,
+            std::bind_front(getPortMetricsUriToDbusMapFromPort,
+                            std::move(metricsUri), std::move(callback))));
+}
